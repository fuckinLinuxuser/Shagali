{
  "name": "shagali",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "SHAGALI_CLOSED=0 astro dev",
    "build": "astro build",
    "build:stand": "SHAGALI_FIXTURES=1 SHAGALI_CLOSED=0 astro build --outDir dist-stand",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "lhci": "lhci autorun",
    "lint:php": "find public/api.php public/api ../sql -name '*.php' -print0 2>/dev/null | xargs -0 -n1 php -l",
    "check:links": "node scripts/check-links.mjs",
    "check:images": "node scripts/check-images.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check:content": "node scripts/check-content.mjs",
    "test:e2e": "playwright test",
    "test:visual": "sh scripts/visual.sh",
    "test:visual:update": "sh scripts/visual.sh --update-snapshots"
  },
  "dependencies": {
    "@astrojs/node": "^10.1.1",
    "@astrojs/sitemap": "^3.7.0",
    "@panzoom/panzoom": "^4.6.1",
    "astro": "^6.3.7",
    "dotenv": "^17.2.4",
    "keen-slider": "^6.8.6",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.0",
    "vitest": "^5.1.0"
  }
}
