# ===== Сайт закрыт паролем на весь домен (HTTP Basic Auth) =====
# Хеш пароля лежит в файле ВНЕ корня сайта: /var/www/u3413841/data/.htpasswd (в репозитории его нет; создать — docs/SITE-PASSWORD.md).
# Файл есть → пускаем только по паролю. Файла нет → сайт закрыт для всех (403), чтобы случайно не открыться.
# Исключение: стенд (docker, SHAGALI_STAND=1) открыт без пароля — иначе не работают тесты.
# К запуску витрины этот блок удаляют целиком (отдельный PR).
<If "-f '/var/www/u3413841/data/.htpasswd'">
  AuthType Basic
  AuthName "Closed preview"
  AuthUserFile /var/www/u3413841/data/.htpasswd
  Require valid-user
</If>
<ElseIf "env('SHAGALI_STAND') == '1'">
  # стенд: без пароля
</ElseIf>
<Else>
  Require all denied
</Else>

# Кэширование статики в браузере/прокси — снижает нагрузку и ускоряет повторные визиты
<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"

  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"

  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"

  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|mp4|webm|woff2?|css|js)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Сжатие текстовых ответов
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Поддержка докачки/перемотки видео (важно для больших mp4)
<IfModule mod_headers.c>
  <FilesMatch "\.mp4$">
    Header set Accept-Ranges bytes
  </FilesMatch>
</IfModule>

# Служебное из веба закрыто: миграции, конфиги с секретами, внутренние файлы API (с «_»)
RedirectMatch 403 ^/sql(/|$)
RedirectMatch 403 ^/api/_
<FilesMatch "^(shagali-config.*|config\..*)\.php$|\.sql$">
  Require all denied
</FilesMatch>
