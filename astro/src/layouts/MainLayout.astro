---
// src/layouts/MainLayout.astro
const DEFAULT_DESCRIPTION = "Театральный продюсер и режиссер Елена Шагали: спектакли, гастроли, кастинги и проекты в Санкт-Петербурге и по всей России. Узнавайте о новых постановках и сотрудничестве.";
const { title = "Мир За Сценой", description = DEFAULT_DESCRIPTION, theme = 'dark', noindex = false } = Astro.props;
import '../styles/base.css';
import '../styles/components.css';
import '../styles/layout.css';
import '../styles/map.css';
import '../styles/theme.css';
import TicketModal from '../components/TicketModal.astro';
import CookieBanner from '../components/CookieBanner.astro';

---

<html lang="ru">
<head>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Театральный Режиссер: Мир За Сценой",
  "url": "https://shagali.ru"
}
</script>

  <meta charset="utf-8" />
  <meta name="description" content={description}>
  <meta name="keywords" content="театр, спектакли, гастроли, кастиги, проекты, Санкт-Петербург, Россия, Елена Шагали, продюсер, режиссер">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=10.0, user-scalable=yes">
  <title>{title}</title>
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Счётчики (Top.Mail.Ru) грузятся только после согласия в cookie-плашке: src/lib/counters.ts -->
 
  <link rel="icon" href="/images/favicon.png" type="image/png">
  <!-- шрифты -->
  <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
  <meta name="google-site-verification" content="ctBHI-4UOlGRbOziyPnRsF0SOZvihKeKSRQ2j2LblkE" />
  <meta name="yandex-verification" content="ce6cf319c85b86a6" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;900&family=Montserrat:wght@400;500;600;700&family=Roboto:wght@300;400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>

<body class={theme === 'light' ? 'theme-light' : undefined}>
  <slot />                  <!-- здесь будет весь контент страницы -->
  <TicketModal />
  <CookieBanner />
  <!-- глобальный скрипт карты -->
  <script src="/js/modal.js" is:inline></script>
  <script>
    import '../lib/goals';
  </script>
</body>
</html>