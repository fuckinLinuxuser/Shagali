---
// src/layouts/MainLayout.astro
const { title = "Мир За Сценой" } = Astro.props;
import '../styles/base.css';
import '../styles/header-effects.css';
import '../styles/components.css';
import '../styles/layout.css';
import '../styles/map.css';
import 'leaflet/dist/leaflet.css';

import 'keen-slider/keen-slider.min.css';

---

<html lang="ru">
<head>
  <!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-YV1LNBH5XW"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-YV1LNBH5XW');
</script>
  <meta charset="utf-8" />
  <meta name="description" content="Театральный продюсер и режисер Елена Шагали: спектакли, гастроли, кастиги и проекты в Санкт-Петербурге и по всей России. Узнавайте о новых постановках и сотрудничестве.">
  <meta name="keywords" content="театр, спектакли, гастроли, кастиги, проекты, Санкт-Петербург, Россия, Елена Шагали, продюсер, режисер">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=10.0, user-scalable=yes">
  <title>{title}</title>
  <link rel="icon" href="/images/favicon.png" type="image/png">
  <!-- шрифты -->
  <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
  <meta name="google-site-verification" content="ctBHI-4UOlGRbOziyPnRsF0SOZvihKeKSRQ2j2LblkE" />
  <meta name="yandex-verification" content="ce6cf319c85b86a6" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Roboto:wght@300;400&display=swap" rel="stylesheet">
</head>

<body>
  <slot />                  <!-- здесь будет весь контент страницы -->
  <!-- глобальный скрипт карты -->
  <script src="/js/tours-interactive.js" is:inline></script>
  <script src="/js/modal.js" is:inline></script>
</body>
</html>