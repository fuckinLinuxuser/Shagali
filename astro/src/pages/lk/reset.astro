---
import MainLayout from '../../layouts/MainLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/pages.css';
import '../../styles/auth.css';
---

<MainLayout title="Сброс пароля — Мир За Сценой" description="Сброс пароля в личном кабинете." noindex>
  <SiteHeader />
  <main class="page">
    <div class="page__inner">
      <nav class="crumbs" aria-label="Навигация"><a href="/">Главная</a> / Сброс пароля</nav>
      <h1 class="page__title">Сброс пароля</h1>
      <form class="auth" id="reset-request-form" novalidate>
        <div class="auth__group">
          <label for="f-email">Email</label>
          <input type="email" id="f-email" name="email" autocomplete="email" maxlength="254" required />
        </div>
        <p class="form-error" data-form-error role="alert" hidden></p>
        <p class="form-success" data-form-success role="status" tabindex="-1" hidden>
          Если такая почта зарегистрирована, мы отправили на неё ссылку для нового пароля.
        </p>
        <button type="submit" class="auth__btn">Отправить ссылку</button>
      </form>
      <form class="auth" id="reset-confirm-form" novalidate hidden>
        <div class="auth__group">
          <label for="f-password">Новый пароль (от 8 символов)</label>
          <input type="password" id="f-password" name="password" autocomplete="new-password" minlength="8" maxlength="200" required />
        </div>
        <p class="form-error" data-form-error role="alert" hidden></p>
        <p class="form-success" data-form-success role="status" tabindex="-1" hidden>
          Пароль изменён. <a href="/lk/login">Войти</a>
        </p>
        <button type="submit" class="auth__btn">Сохранить пароль</button>
      </form>
      <p class="auth__links"><a href="/lk/login">Вход</a></p>
    </div>
  </main>
  <Footer />
</MainLayout>

<script>
  import '../../styles/forms.css';
  import { bindAuthForm } from '../../lib/auth';
  const token = new URLSearchParams(location.search).get('token') ?? '';
  const requestForm = document.getElementById('reset-request-form') as HTMLFormElement;
  const confirmForm = document.getElementById('reset-confirm-form') as HTMLFormElement;
  const done = (form: HTMLFormElement) => () => {
    form.reset();
    form.dataset.done = '';
    const ok = form.querySelector<HTMLElement>('[data-form-success]')!;
    ok.hidden = false;
    ok.focus();
  };
  if (token) {
    requestForm.hidden = true;
    confirmForm.hidden = false;
    bindAuthForm(confirmForm, { action: 'reset_confirm', payload: (d) => ({ token, password: d.get('password') }), ok: [200], onOk: done(confirmForm) });
  } else {
    bindAuthForm(requestForm, { action: 'reset_request', payload: (d) => ({ email: d.get('email') }), ok: [200], onOk: done(requestForm) });
  }
</script>
