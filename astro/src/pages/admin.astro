---
const ADMIN_PASSWORD = '1111'; // ← ИЗМЕНИ!
---

<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Админ-панель — Управление Блогом</title>
    <style>
        body { 
            font-family: Arial, sans-serif; 
            background: #1a1a1a; 
            color: #eee; 
            margin:0; 
            padding:20px; 
        }
        .container { 
            max-width: 1100px; 
            margin: 40px auto; 
            background: #222; 
            padding: 35px; 
            border-radius: 16px; 
            box-shadow: 0 10px 40px rgba(0,0,0,0.7); 
        }
        h1 { text-align: center; color: #d4af37; margin-bottom: 10px; }
        h2 { color: #ddd; margin-top: 30px; }

        /* Поля ввода */
        input, textarea { 
            width: 100%; 
            padding: 12px 14px; 
            margin-bottom: 14px; 
            background: #333; 
            color: white; 
            border: none; 
            border-radius: 8px; 
            font-size: 1.02em;
        }
        input[type="file"] {
            background: #2a2a2a;
            padding: 10px;
            border: 2px dashed #d4af37;
            cursor: pointer;
            transition: all 0.3s;
        }
        input[type="file"]:hover {
            background: #333;
            border-color: #f4d47c;
        }

        label { 
            display: block; 
            margin: 12px 0 6px; 
            color: #d4af37; 
            font-weight: 600;
        }
        .required { color: #ff6b6b; }

        /* Кнопки */
        .btn-primary { 
            background: #d4af37; 
            color: #111; 
            font-weight: bold; 
            padding: 14px; 
            border: none; 
            border-radius: 8px; 
            cursor: pointer; 
            font-size: 1.1em;
            transition: all 0.3s;
        }
        .btn-primary:hover { background: #f4d47c; transform: translateY(-2px); }

        /* Кнопки действий */
        .btn { 
            padding: 8px 16px; 
            border: none; 
            border-radius: 6px; 
            cursor: pointer; 
            font-weight: 600;
            transition: all 0.3s;
        }
        .btn-edit { 
            background: #4ade80; 
            color: #111; 
        }
        .btn-edit:hover { background: #22c55e; transform: scale(1.05); }

        .btn-delete { 
            background: #f87171; 
            color: white; 
        }
        .btn-delete:hover { background: #ef4444; transform: scale(1.05); }

        table { 
            width: 100%; 
            border-collapse: collapse; 
            margin: 20px 0; 
            background: #1f1f1f;
        }
        th, td { 
            padding: 14px; 
            text-align: left; 
            border-bottom: 1px solid #444; 
        }
        th { 
            background: #2a2a2a; 
            color: #d4af37; 
        }
        tr:hover { background: #2a2a2a; }

        .hidden { display: none; }
        #status { 
            margin-top: 15px; 
            text-align: center; 
            font-weight: bold; 
            min-height: 28px; 
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Логин -->
        <div id="loginScreen">
            <h1>Админ-панель</h1>
            <div style="max-width:420px; margin:100px auto;">
                <input type="password" id="passwordInput" placeholder="Введите пароль" />
                <button id="loginBtn" class="btn-primary">Войти</button>
            </div>
        </div>

        <!-- Админка -->
        <div id="adminPanel" class="hidden">
            <h1>Управление постами</h1>

            <h2 id="formTitle">Новый пост</h2>
            <form id="postForm">
                <input type="hidden" id="postId">

                <input type="text" id="title" placeholder="Название поста" required>
                <input type="text" id="date" placeholder="Дата (например: Март 2026)" required>
                
                <label>Фото обложки <span class="required">*</span></label>
                <input type="file" id="coverImage" accept="image/*" required>

                <label>Короткий текст <span class="required">*</span></label>
                <textarea id="shortText" rows="3" required></textarea>
                
                <label>Полный текст <span class="required">*</span></label>
                <textarea id="fullText" rows="9" required></textarea>
                
                <label>Основное медиа (видео/фото) <span class="required">*</span></label>
                <input type="file" id="mainMedia" accept="image/*,video/*" required>

                <button type="submit" class="btn-primary" id="submitBtn">Опубликовать пост</button>
            </form>

            <div id="status"></div>

            <h2>Существующие посты</h2>
            <table id="postsTable">
                <thead>
                    <tr>
                        <th>Дата</th>
                        <th>Название</th>
                        <th style="width: 220px;">Действия</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

    <script define:vars={{ ADMIN_PASSWORD }}>
       async function loadPosts() {
    const res = await fetch('/api.php'); // Меняем путь
    const posts = await res.json();
    const tbody = document.querySelector('#postsTable tbody');
    tbody.innerHTML = '';
    posts.forEach(post => {
        const row = document.createElement('tr');
        row.innerHTML = `
        <td>${post.date}</td>
        <td>${post.title}</td>
        <td>
        <button class="btn btn-edit" onclick="editPost(${post.id})">✏️ Редактировать</button>
        <button class="btn btn-delete" onclick="deletePost(${post.id})">🗑️ Удалить</button>
        </td>
        `;
        tbody.appendChild(row);
    });
}

window.editPost = async (id) => {
    const res = await fetch(`/api.php?id=${id}`); // Меняем путь
    const post = await res.json();
    currentEditId = post.id;
    document.getElementById('formTitle').textContent = 'Редактирование поста';
    document.getElementById('title').value = post.title;
    document.getElementById('date').value = post.date;
    document.getElementById('shortText').value = post.shortText;
    document.getElementById('fullText').value = post.fullText;
    document.getElementById('coverImage').required = false;
    document.getElementById('mainMedia').required = false;
    document.getElementById('submitBtn').textContent = 'Сохранить изменения';
};

window.deletePost = async (id) => {
    if (!confirm('Удалить этот пост безвозвратно?')) return;
    const res = await fetch(`/api.php?id=${id}`, { method: 'DELETE' }); // Меняем путь
    if (res.ok) {
        loadPosts();
    } else {
        alert('Ошибка при удалении');
    }
};

// Внутри обработчика отправки формы ('submit') замените блок определения url и method:
document.getElementById('postForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = document.getElementById('status');
    status.textContent = 'Сохранение...';
    
    const formData = new FormData();
    formData.append('title', document.getElementById('title').value);
    formData.append('date', document.getElementById('date').value);
    formData.append('shortText', document.getElementById('shortText').value);
    formData.append('fullText', document.getElementById('fullText').value);
    
    const coverFile = document.getElementById('coverImage').files[0];
    const mainFile = document.getElementById('mainMedia').files[0];
    if (coverFile) formData.append('coverImage', coverFile);
    if (mainFile) formData.append('mainMedia', mainFile);

    const isEdit = !!currentEditId;
    // PHP не умеет из коробки читать FormData через PUT, поэтому шлем POST с флагом в query
    const url = isEdit ? `/api.php?id=${currentEditId}&_method=PUT` : '/api.php';
    const method = 'POST'; 

    try {
        const res = await fetch(url, { method, body: formData });
        if (res.ok) {
            status.style.color = '#4ade80';
            status.textContent = isEdit ? '✅ Изменения сохранены!' : '✅ Пост успешно опубликован!';
            document.getElementById('postForm').reset();
            currentEditId = null;
            document.getElementById('formTitle').textContent = 'Новый пост';
            document.getElementById('submitBtn').textContent = 'Опубликовать пост';
            document.getElementById('coverImage').required = true;
            document.getElementById('mainMedia').required = true;
            loadPosts();
        }
    } catch (err) {
        status.style.color = '#f87171';
        status.textContent = '❌ Ошибка при сохранении';
    }
});

    </script>
</body>
</html>