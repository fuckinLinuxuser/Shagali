---
// src/pages/admin.astro
// Статический фронтматтер Astro (выполняется только при сборке проекта)
---

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Панель управления — Шагали</title>
    <style>
        :root {
            --bg-dark: #121214;
            --bg-card: #1a1a1e;
            --accent: #6366f1;
            --accent-hover: #4f46e5;
            --text: #e4e4e7;
            --text-muted: #a1a1aa;
            --border: #2d2d34;
            --danger: #ef4444;
        }

        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-dark);
            color: var(--text);
        }

        .admin-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        /* Стили экрана входа */
        #loginScreen {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 80vh;
        }

        .login-card {
            background: var(--bg-card);
            padding: 40px;
            border-radius: 12px;
            border: 1px solid var(--border);
            width: 100%;
            max-width: 400px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
        }

        .login-card h2 {
            margin-top: 0;
            margin-bottom: 24px;
            font-size: 24px;
            text-align: center;
        }

        /* Шапка панели */
        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border);
            padding-bottom: 20px;
            margin-bottom: 30px;
        }

        .admin-header h1 {
            margin: 0;
            font-size: 28px;
        }

        /* Сетка контента */
        .admin-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
        }

        @media (max-width: 900px) {
            .admin-grid {
                grid-template-columns: 1fr;
            }
        }

        .form-section,
        .table-section {
            background: var(--bg-card);
            padding: 30px;
            border-radius: 12px;
            border: 1px solid var(--border);
        }

        .form-section h2,
        .table-section h2 {
            margin-top: 0;
            margin-bottom: 20px;
            font-size: 20px;
            color: var(--accent);
        }

        /* Поля ввода */
        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            color: var(--text-muted);
        }

        .form-group input[type="text"],
        .form-group input[type="password"],
        .form-group textarea {
            width: 100%;
            padding: 12px;
            background: var(--bg-dark);
            border: 1px solid var(--border);
            border-radius: 6px;
            color: var(--text);
            font-size: 15px;
            box-sizing: border-box;
            transition: border-color 0.2s;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: var(--accent);
        }

        .form-group input[type="file"] {
            color: var(--text-muted);
            font-size: 14px;
        }

        /* Кнопки общего вида */
        .btn {
            padding: 12px 24px;
            font-weight: 600;
            font-size: 15px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: background 0.2s;
        }

        .btn-primary {
            background: var(--accent);
            color: white;
        }

        .btn-primary:hover {
            background: var(--accent-hover);
        }

        .btn-secondary {
            background: #2d2d34;
            color: var(--text);
            margin-left: 10px;
        }

        .btn-secondary:hover {
            background: #3f3f46;
        }

        .form-actions {
            display: flex;
            align-items: center;
            margin-top: 25px;
        }

        .status-message {
            margin-top: 15px;
            font-size: 14px;
            font-weight: 500;
        }

        /* Стилизация таблицы списка публикаций */
        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        th {
            padding: 12px;
            border-bottom: 2px solid var(--border);
            color: var(--text-muted);
            font-size: 14px;
        }

        td {
            padding: 16px 12px;
            border-bottom: 1px solid var(--border);
            font-size: 15px;
        }

        .cell-date {
            color: var(--text-muted);
            width: 100px;
            white-space: nowrap;
        }

        .cell-title {
            max-width: 250px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .cell-actions {
            width: 90px;
            text-align: right;
            white-space: nowrap;
        }

        /* Кнопки операций над строками */
        .btn-action {
            background: transparent;
            border: 1px solid var(--border);
            border-radius: 4px;
            color: var(--text);
            padding: 6px 10px;
            cursor: pointer;
            font-size: 14px;
            margin-left: 4px;
            transition: background 0.2s;
        }

        .btn-action:hover {
            background: #2d2d34;
        }

        .btn-delete:hover {
            background: var(--danger);
            border-color: var(--danger);
        }
    </style>
</head>
<body>

    <!-- 1. ЭКРАН АВТОРИЗАЦИИ -->
    <div id="loginScreen" class="admin-container">
        <div class="login-card">
            <h2>Вход в панель управления</h2>
            <div class="form-group">
                <label for="passwordInput">Введите пароль администратора</label>
                <input type="password" id="passwordInput" placeholder="••••••••" autocomplete="current-password" />
            </div>
            <button id="loginBtn" class="btn btn-primary">Войти</button>
        </div>
    </div>

    <!-- 2. ГЛАВНАЯ ПАНЕЛЬ АДМИНИСТРАТОРА (скрыта по умолчанию) -->
    <div id="adminPanel" class="admin-container" style="display: none;">
        <header class="admin-header">
            <h1>Управление публикациями</h1>
            <button id="logoutBtn" class="btn btn-secondary">Выйти</button>
        </header>

        <div class="admin-grid">
            <!-- Левая колонка: Форма создания/редактирования -->
            <section class="form-section">
                <h2 id="formTitle">Новый пост</h2>
                <form id="postForm" enctype="multipart/form-data">
                    <div class="form-group">
                        <label for="title">Заголовок публикации</label>
                        <input type="text" id="title" required placeholder="Введите заголовок" />
                    </div>

                    <div class="form-group">
                        <label for="date">Дата публикации</label>
                        <input type="text" id="date" required placeholder="Например: 25 мая 2026" />
                    </div>

                    <div class="form-group">
                        <label for="shortText">Краткое описание (для превью на главной)</label>
                        <textarea id="shortText" rows="3" required placeholder="Короткий текст анонса..."></textarea>
                    </div>

                    <div class="form-group">
                        <label for="fullText">Полный текст публикации (для модального окна)</label>
                        <textarea id="fullText" rows="8" required placeholder="Полный текст новости или кастинга..."></textarea>
                    </div>

                    <div class="form-group">
                        <label for="coverImage">Обложка (Изображение)</label>
                        <input type="file" id="coverImage" accept="image/*" required />
                    </div>

                    <div class="form-group">
                        <label for="mainMedia">Главный медиафайл (Изображение или Видео)</label>
                        <input type="file" id="mainMedia" accept="image/*,video/*" required />
                    </div>

                    <div class="form-actions">
                        <button type="submit" id="submitBtn" class="btn btn-primary">Опубликовать пост</button>
                        <button type="button" id="cancelBtn" class="btn btn-secondary" style="display: none;">Отмена</button>
                    </div>
                    <p id="status" class="status-message"></p>
                </form>
            </section>

            <!-- Правая колонка: Список постов из posts.json -->
            <section class="table-section">
                <h2>Текущие публикации на сайте</h2>
                <div class="table-wrapper">
                    <table id="postsTable">
                        <thead>
                            <tr>
                                <th>Дата</th>
                                <th>Заголовок</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="3" style="text-align: center; color: #888;">Загрузка списка публикаций...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>

    <script>
        // КЛИЕНТСКИЙ СКРИПТ
        (function() {
            let currentEditId = null;

            const loginScreen = document.getElementById('loginScreen');
            const adminPanel = document.getElementById('adminPanel');
            const loginBtn = document.getElementById('loginBtn');
            const logoutBtn = document.getElementById('logoutBtn');
            const passwordInput = document.getElementById('passwordInput');
            const postForm = document.getElementById('postForm');
            const submitBtn = document.getElementById('submitBtn');
            const cancelBtn = document.getElementById('cancelBtn');
            const formTitle = document.getElementById('formTitle');
            const statusEl = document.getElementById('status');

            function showPanel() {
                if (loginScreen) loginScreen.style.display = 'none';
                if (adminPanel) adminPanel.style.display = 'block';
                loadPosts();
            }

            function showLogin() {
                if (adminPanel) adminPanel.style.display = 'none';
                if (loginScreen) loginScreen.style.display = 'flex';
            }

            // Если сессия уже подтверждена сервером (например, после перезагрузки страницы) — не просим пароль повторно
            fetch('/api.php?action=check', { credentials: 'include' })
                .then(res => res.json())
                .then(data => { if (data.authenticated) showPanel(); })
                .catch(() => {});

            // Вход
            if (loginBtn) {
                loginBtn.addEventListener('click', async () => {
                    const password = passwordInput ? passwordInput.value.trim() : '';
                    loginBtn.disabled = true;
                    try {
                        const res = await fetch('/api.php?action=login', {
                            method: 'POST',
                            credentials: 'include',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ password })
                        });
                        if (res.ok) {
                            if (passwordInput) passwordInput.value = '';
                            showPanel();
                        } else {
                            alert('Неверный пароль администратора!');
                        }
                    } catch (err) {
                        alert('Ошибка сети при попытке входа');
                    } finally {
                        loginBtn.disabled = false;
                    }
                });
            }

            // Выход
            if (logoutBtn) {
                logoutBtn.addEventListener('click', async () => {
                    try {
                        await fetch('/api.php?action=logout', { method: 'POST', credentials: 'include' });
                    } catch (err) {}
                    if (passwordInput) passwordInput.value = '';
                    showLogin();
                    currentEditId = null;
                    if (formTitle) formTitle.textContent = 'Новый пост';
                    if (submitBtn) submitBtn.textContent = 'Опубликовать пост';
                    if (cancelBtn) cancelBtn.style.display = 'none';
                    postForm?.reset();
                    const coverInput = document.getElementById('coverImage');
                    const mediaInput = document.getElementById('mainMedia');
                    if (coverInput) coverInput.required = true;
                    if (mediaInput) mediaInput.required = true;
                    if (statusEl) statusEl.textContent = '';
                });
            }

            // Загрузка постов
            async function loadPosts() {
                try {
                    const res = await fetch('/api.php');
                    if (!res.ok) throw new Error(`Ошибка сервера: ${res.status}`);
                    const posts = await res.json();
                    const tbody = document.querySelector('#postsTable tbody');
                    if (!tbody) return;

                    tbody.innerHTML = '';
                    const postsArray = Array.isArray(posts) ? posts : [];

                    if (postsArray.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="3" style="text-align:center; color:#888;">Список публикаций пуст.</td></tr>';
                        return;
                    }

                    postsArray.forEach(post => {
                        const row = document.createElement('tr');
                        row.innerHTML = `
                            <td class="cell-date">${escapeHtml(post.date || '')}</td>
                            <td class="cell-title"><strong>${escapeHtml(post.title || '')}</strong></td>
                            <td class="cell-actions">
                                <button class="btn-action btn-edit" data-id="${post.id}">✏️</button>
                                <button class="btn-action btn-delete" data-id="${post.id}">🗑️</button>
                            </td>
                        `;
                        tbody.appendChild(row);
                    });

                    initTableEvents();
                } catch (error) {
                    console.error('Ошибка админки:', error);
                    const tbody = document.querySelector('#postsTable tbody');
                    if (tbody) {
                        tbody.innerHTML = '<tr><td colspan="3" style="text-align:center; color:#f87171;">Не удалось загрузить посты. Проверьте api.php и posts.json</td></tr>';
                    }
                }
            }

            // Инициализация кнопок в таблице
            function initTableEvents() {
                document.querySelectorAll('.btn-edit').forEach(button => {
                    button.addEventListener('click', async (e) => {
                        const id = e.currentTarget.getAttribute('data-id');
                        if (statusEl) statusEl.textContent = 'Загрузка данных поста...';
                        try {
                            const res = await fetch(`/api.php?id=${id}`);
                            if (!res.ok) throw new Error();
                            const post = await res.json();

                            currentEditId = post.id;
                            if (formTitle) formTitle.textContent = 'Редактирование поста';
                            document.getElementById('title').value = post.title;
                            document.getElementById('date').value = post.date;
                            document.getElementById('shortText').value = post.shortText;
                            document.getElementById('fullText').value = post.fullText;

                            const coverInput = document.getElementById('coverImage');
                            const mediaInput = document.getElementById('mainMedia');
                            if (coverInput) coverInput.required = false;
                            if (mediaInput) mediaInput.required = false;

                            if (submitBtn) submitBtn.textContent = 'Сохранить изменения';
                            if (cancelBtn) cancelBtn.style.display = 'inline-block';
                            if (statusEl) statusEl.textContent = '';

                            window.scrollTo({ top: 0, behavior: 'smooth' });
                        } catch (err) {
                            if (statusEl) statusEl.textContent = '❌ Не удалось загрузить пост для редактирования';
                        }
                    });
                });

                document.querySelectorAll('.btn-delete').forEach(button => {
                    button.addEventListener('click', async (e) => {
                        if (!confirm('Удалить эту публикацию безвозвратно?')) return;
                        const id = e.currentTarget.getAttribute('data-id');
                        try {
                            const res = await fetch(`/api.php?id=${id}`, {
                            method: 'DELETE',
                            credentials: 'include'
                        });
                            if (res.ok) {
                                loadPosts();
                            } else {
                                alert('Сервер отклонил запрос на удаление');
                            }
                        } catch (err) {
                            alert('Ошибка сети при попытке удаления');
                        }
                    });
                });
            }

            // Кнопка "Отмена"
            if (cancelBtn) {
                cancelBtn.addEventListener('click', () => {
                    postForm?.reset();
                    currentEditId = null;
                    if (formTitle) formTitle.textContent = 'Новый пост';
                    if (submitBtn) submitBtn.textContent = 'Опубликовать пост';
                    cancelBtn.style.display = 'none';
                    const coverInput = document.getElementById('coverImage');
                    const mediaInput = document.getElementById('mainMedia');
                    if (coverInput) coverInput.required = true;
                    if (mediaInput) mediaInput.required = true;
                    if (statusEl) statusEl.textContent = '';
                });
            }

            // Отправка формы
            if (postForm) {
                postForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    if (statusEl) {
                        statusEl.style.color = '#ffffff';
                        statusEl.textContent = 'Сохранение данных и загрузка медиафайлов...';
                    }

                    const formData = new FormData();
                    formData.append('title', document.getElementById('title').value);
                    formData.append('date', document.getElementById('date').value);
                    formData.append('shortText', document.getElementById('shortText').value);
                    formData.append('fullText', document.getElementById('fullText').value);

                    const coverInput = document.getElementById('coverImage');
                    const mediaInput = document.getElementById('mainMedia');
                    if (coverInput.files && coverInput.files[0]) {
                        formData.append('coverImage', coverInput.files[0]);
                    }
                    if (mediaInput.files && mediaInput.files[0]) {
                        formData.append('mainMedia', mediaInput.files[0]);
                    }

                    const isEdit = currentEditId !== null;
                    const url = isEdit ? `/api.php?id=${currentEditId}&_method=PUT` : '/api.php';

                    try {
                        const res = await fetch(url, {
                            method: 'POST',
                            credentials: 'include',
                            body: formData
                        });
                        if (res.ok) {
                            if (statusEl) {
                                statusEl.style.color = '#4ade80';
                                statusEl.textContent = isEdit ? '✅ Изменения успешно сохранены!' : '✅ Публикация успешно добавлена!';
                            }
                            postForm.reset();
                            currentEditId = null;
                            if (formTitle) formTitle.textContent = 'Новый пост';
                            if (submitBtn) submitBtn.textContent = 'Опубликовать пост';
                            if (cancelBtn) cancelBtn.style.display = 'none';
                            const cover = document.getElementById('coverImage');
                            const media = document.getElementById('mainMedia');
                            if (cover) cover.required = true;
                            if (media) media.required = true;
                            loadPosts();
                        } else {
                            const errData = await res.json();
                            if (statusEl) {
                                statusEl.style.color = '#f87171';
                                statusEl.textContent = `❌ Ошибка: ${errData.error || 'Не удалось сохранить данные'}`;
                            }
                        }
                    } catch (err) {
                        if (statusEl) {
                            statusEl.style.color = '#f87171';
                            statusEl.textContent = '❌ Критическая ошибка сети при отправке данных';
                        }
                    }
                });
            }

            // Вспомогательная функция для экранирования HTML
            function escapeHtml(str) {
                if (!str) return '';
                return str
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }
        })();
    </script>
</body>
</html>