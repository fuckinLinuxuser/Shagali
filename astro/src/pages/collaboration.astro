---
// src/pages/collaboration.astro
---

<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Условия сотрудничества | Мир За Сценой</title>
  <!-- Подключите ваши шрифты (Playfair Display + sans-serif) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700;900&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>

<body>
  <main class="main-content">
    <section class="collaboration-hero">
      <div class="container">
        <h1 class="page-title">Условия сотрудничества</h1>
      </div>
    </section>

    <section class="principles-section">
      <div class="container">
        <div class="principles-grid">
          <div class="principle-card">
            <div class="card-glow"></div>
            <h3>Работаем только из любви</h3>
            <p>Захотим задолбаться - сделаем это в другом месте.</p>
          </div>

          <div class="principle-card">
            <div class="card-glow"></div>
            <h3>Действуем масштабно и ярко.</h3>
            <p>Всегда успеем побыть обычными. Как-нибудь потом.</p>
          </div>

          <div class="principle-card">
            <div class="card-glow"></div>
            <h3>Создаём из себя</h3>
            <p>Только внутри есть настоящее.</p>
          </div>

          <div class="principle-card">
            <div class="card-glow"></div>
            <h3>Помним о главном.</h3>
            <p>Бог не меняет талант на деньги, он требует бо́льшего.</p>
          </div>

          <div class="principle-card">
            <div class="card-glow"></div>
            <h3>Видим случайные совпадения</h3>
            <p>И строим из себя волшебников.</p>
          </div>

          <div class="principle-card">
            <div class="card-glow"></div>
            <h3>Вокруг нас все становятся Великими</h3>
            <p>Какими и были изначально.</p>
          </div>

          <div class="principle-card">
            <div class="card-glow"></div>
            <h3>Успеем сколько захотим.</h3>
            <p>Поделимся всем, что есть. Возьмем столько, сколько полагается.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="contract-section">
      <div class="container">
        <div class="contract-frame">
          <h2 class="contract-title">Что фиксируем в контракте</h2>

          <div class="contract-grid">
            <div class="contract-column">
              <ul class="contract-list">
                <li>Отказ от алкоголя и веществ в ходе выполнения контракта.</li>
                <li>Общение друг с другом – уважительное. Обсуждение – коллегиальное (решающее слово у продюсера). Действия – в интересах успешности проекта. </li>
                <li>Возможные непонимания обсуждаются лично, прямо, уважительно и решаются в интересах успешности проекта. </li>
                <li>График работы строится с учетом личных приоритетов, при этом в интересах успешности проекта.</li>
              </ul>
            </div>

            <div class="contract-column actors">
              <h3>Для актёров — дополнительно</h3>
              <ul class="contract-list">
                <li>Ответственное отношение к собственной внешности на период контракта (не менять прическу, сохранять рабочий вес).</li>
                <li>Готовность к глубокой работе над ролью (в том числе самостоятельной).</li>
                <li>Личная дисциплина как часть взаимного уважения (без опозданий на репетиции, тщательное выполнение домашних заданий).</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

<section class="cta-section">
      <div class="container">
        <p class="cta-text">Готовы выйти на сцену?</p>
        <button type="button" class="btn-cta js-open-modal">Оставить заявку</button>
      </div>
    </section>

  </main>

  <!-- ─── Модальное окно ─────────────────────────────────────────────── -->
  <div class="modal-overlay js-modal-overlay" aria-hidden="true">
    <div class="modal js-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      
      <button class="modal-close js-close-modal" aria-label="Закрыть">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>

      <h2 id="modal-title" class="modal-title">Оставить заявку</h2>
      <p class="modal-subtitle">Мы свяжемся с вами в ближайшее время</p>

      <iframe 
        src="https://forms.yandex.ru/u/698ed4466d2d7366e0a9f973?iframe=1&theme=light" 
        frameborder="0" 
        name="ya-form-frame"
        class="ya-form-iframe"
        title="Форма заявки"
      ></iframe>

    </div>
  </div>
  <style is:global>
    :root {
      --bg: #0a0a07;
      --dark: #11110c;
      --gold: #d4af57;
      --gold-light: #e6c678;
      --gold-dark: #b8972e;
      --text: #f5f0e6;
      --text-light: #d9d2c6;
      --text-muted: #a89f8f;
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', system-ui, sans-serif;
      line-height: 1.6;
    }

    .container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 24px;
    }

    h1, h2, h3 {
      font-family: 'Playfair Display', serif;
      font-weight: 700;
      color: var(--gold);
    }

    /* Hero */
    .collaboration-hero {
      padding: 160px 0 120px;
      text-align: center;
      background: linear-gradient(to bottom, #0f0f0a, #0a0a07);
    }

    .page-title {
      font-size: 5.2rem;
      margin: 0 0 1.4rem;
      letter-spacing: 1.5px;
      text-shadow: 0 6px 40px rgba(212,175,87,0.18);
    }

    .lead {
      font-size: 1.68rem;
      max-width: 820px;
      margin: 0 auto;
      color: var(--text-light);
      font-weight: 300;
    }

    .gold {
      color: var(--gold);
      font-weight: 600;
    }

    /* Principles */
    .principles-section {
      padding: 80px 0 140px;
    }

    .principles-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
      gap: 40px;
    }

    .principle-card {
      position: relative;
      background: rgba(20,18,14,0.78);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(212,175,87,0.12);
      border-radius: 20px;
      padding: 48px 40px 40px;
      transition: all 0.45s ease;
      overflow: hidden;
    }

    .principle-card:hover {
      transform: translateY(-14px);
      border-color: rgba(212,175,87,0.45);
      box-shadow: 0 24px 80px rgba(0,0,0,0.55),
                  0 0 0 1px rgba(212,175,87,0.18) inset;
    }

    .card-glow {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 30% 20%, rgba(212,175,87,0.07) 0%, transparent 60%);
      opacity: 0;
      transition: opacity 0.6s ease;
      pointer-events: none;
    }

    .principle-card:hover .card-glow { opacity: 1; }

    .card-glow.strong {
      background: radial-gradient(circle at 50% 50%, rgba(212,175,87,0.14) 0%, transparent 70%);
    }

    .principle-card h3 {
      font-size: 1.95rem;
      margin: 0 0 1.1em;
      position: relative;
      z-index: 1;
    }

    .principle-card p {
      font-size: 1.08rem;
      color: var(--text-muted);
      margin: 0;
      position: relative;
      z-index: 1;
    }

    .highlight {
      border-color: var(--gold);
      background: linear-gradient(145deg, rgba(30,26,20,0.92), rgba(18,16,12,0.92));
      transform: scale(1.04);
    }

    .highlight h3 { color: var(--gold-light); }

    /* Contract */
    .contract-section {
      padding: 80px 0 140px;
      background: linear-gradient(to bottom, #0a0a07, #11110c);
    }

    .contract-frame {
      background: rgba(15,13,9,0.7);
      border: 1px solid rgba(212,175,87,0.22);
      border-radius: 24px;
      padding: 60px 48px;
      max-width: 1100px;
      margin: 0 auto;
      box-shadow: 0 20px 80px rgba(0,0,0,0.6);
    }

    .contract-title {
      font-size: 3.2rem;
      text-align: center;
      margin: 0 0 2.5rem;
      letter-spacing: 1.2px;
    }

    .contract-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
    }

    .contract-list {
      list-style: none;
      padding: 0;
      margin: 0;
      font-size: 1.12rem;
      line-height: 1.8;
      color: var(--text-light);
    }

    .contract-list li {
      position: relative;
      padding-left: 2.2em;
      margin-bottom: 1.1em;
    }

    .contract-list li::before {
      content: '✦';
      position: absolute;
      left: 0;
      color: var(--gold);
      font-size: 1.3em;
      line-height: 1;
    }

    .actors h3 {
      font-size: 1.65rem;
      color: var(--gold-light);
      margin: 0 0 1.4em;
    }

    /* CTA */
    .cta-section {
      padding: 140px 0 180px;
      text-align: center;
      background: linear-gradient(180deg, #11110c 0%, #0a0a07 100%);
    }

    .cta-text {
      font-size: 2.1rem;
      font-family: 'Playfair Display', serif;
      color: var(--text-light);
      margin-bottom: 2.5rem;
    }

    .btn-cta {
      display: inline-block;
      background: var(--gold);
      color: #0a0a07;
      padding: 18px 64px;
      border-radius: 60px;
      font-size: 1.32rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.4s ease;
      box-shadow: 0 12px 40px rgba(212,175,87,0.35);
      position: relative;
      overflow: hidden;
    }

    .btn-cta::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.25), transparent);
      transform: translateX(-100%);
      transition: transform 0.7s ease;
    }

    .btn-cta:hover::before {
      transform: translateX(100%);
    }

    .btn-cta:hover {
      background: var(--gold-light);
      transform: translateY(-5px);
      box-shadow: 0 24px 70px rgba(212,175,87,0.5);
    }

    /* Адаптив */
    @media (max-width: 1024px) {
      .principles-grid { gap: 32px; }
      .contract-grid { grid-template-columns: 1fr; gap: 48px; }
    }

    @media (max-width: 768px) {
      .page-title        { font-size: 3.8rem; }
      .lead              { font-size: 1.38rem; }
      .principle-card    { padding: 40px 28px; }
      .contract-frame    { padding: 48px 32px; }
      .btn-cta           { padding: 16px 48px; font-size: 1.18rem; }
    }

    @media (max-width: 480px) {
      .page-title        { font-size: 2.9rem; }
      .lead              { font-size: 1.22rem; }
    }
    /* Модалка */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: var(--modal-bg);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      display: grid;
      place-items: center;
      opacity: 0;
      visibility: hidden;
      transition: all 0.4s ease;
      z-index: 9999;
    }

    .modal-overlay.active {
      opacity: 1;
      visibility: visible;
    }

    .modal {
      position: relative;
      width: 92%;
      max-width: 860px;
      max-height: 94vh;
      background: var(--modal-glass);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(212,175,87,0.18);
      border-radius: 24px;
      box-shadow: 0 30px 100px rgba(0,0,0,0.7),
                  0 0 0 1px rgba(212,175,87,0.12) inset;
      padding: 48px 32px 40px;
      overflow-y: auto;
      transform: scale(0.92);
      transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .modal-overlay.active .modal {
      transform: scale(1);
    }

    .modal-close {
      position: absolute;
      top: 24px;
      right: 24px;
      background: none;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      padding: 8px;
      border-radius: 50%;
      transition: all 0.25s ease;
      line-height: 1;
    }

    .modal-close:hover,
    .modal-close:focus {
      color: var(--gold-light);
      background: rgba(212,175,87,0.12);
      transform: rotate(90deg);
    }

    .modal-title {
      font-size: 2.6rem;
      text-align: center;
      margin: 0 0 0.8rem;
      color: var(--gold);
      font-family: 'Playfair Display', serif;
    }

    .modal-subtitle {
      text-align: center;
      color: var(--text-muted);
      margin: 0 0 2.2rem;
      font-size: 1.12rem;
    }

    .ya-form-iframe {
      width: 100%;
      height: 68vh;
      min-height: 520px;
      border-radius: 16px;
      background: rgb(225, 216, 204);
    }

    /* Адаптив для модалки */
    @media (max-width: 640px) {
      .modal {
        padding: 40px 20px 32px;
        border-radius: 20px;
      }
      .modal-title { font-size: 2.1rem; }
      .modal-close { top: 16px; right: 16px; }
      .ya-form-iframe { min-height: 480px; }
    }

    @media (max-height: 680px) {
      .ya-form-iframe { height: 52vh; min-height: 420px; }
    }
  </style>

  <!-- ─── JavaScript ─────────────────────────────────────────────────── -->
  <script>
    const openBtn  = document.querySelector('.js-open-modal');
    const overlay  = document.querySelector('.js-modal-overlay');
    const modal    = document.querySelector('.js-modal');
    const closeBtn = document.querySelector('.js-close-modal');

    function openModal() {
      overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    }

    function closeModal() {
      overlay.classList.remove('active');
      document.body.style.overflow = '';
      openBtn.focus();
    }

    openBtn?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);

    // Закрытие по клику на фон
    overlay?.addEventListener('click', e => {
      if (e.target === overlay) closeModal();
    });

    // Закрытие по Escape
    window.addEventListener('keydown', e => {
      if (e.key === 'Escape' && overlay.classList.contains('active')) {
        closeModal();
      }
    });
  </script>
</body>
</html>