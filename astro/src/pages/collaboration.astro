  <style is:global>
    :root {
      --bg:        #fafbd6;
      --card-bg:   #ffffff;
      --text:      #222222;
      --text-light:#444444;
      --text-muted:#666666;
      --gold:      #d4af37;
      --gold-dark: #b8972e;
      --gold-light:#e6c678;
      --shadow:    0 6px 20px rgba(0,0,0,0.12);
      --shadow-lg: 0 12px 36px rgba(0,0,0,0.16);
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', system-ui, sans-serif;
      line-height: 1.6;
    }

    body.modal-open {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100dvh;
      overflow: hidden;
    }

    .container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 24px;
    }

    h1, h2, h3 {
      font-family: 'Playfair Display', serif;
      font-weight: 700;
      color: #222;
    }

    /* Hero */
    .collaboration-hero {
      padding: 140px 0 100px;
      text-align: center;
    }

    .page-title {
      font-size: 4.8rem;
      margin: 0 0 1rem;
      letter-spacing: 1.2px;
      color: #222;
    }

    /* Principles */
    .principles-section {
      padding: 60px 0 120px;
    }

    .principles-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
      gap: 32px;
    }

    .principle-card {
      background: var(--card-bg);
      border-radius: 16px;
      padding: 44px 36px;
      box-shadow: var(--shadow);
      transition: all 0.35s ease;
      border: 1px solid rgba(212,175,55,0.12);
    }

    .principle-card:hover {
      transform: translateY(-10px);
      box-shadow: var(--shadow-lg);
      border-color: var(--gold);
    }

    .principle-card h3 {
      font-size: 1.85rem;
      margin: 0 0 1.1em;
      color: #222;
    }

    .principle-card p {
      font-size: 1.08rem;
      color: var(--text-light);
      margin: 0;
    }

    /* Contract */
    .contract-section {
      padding: 60px 0 120px;
    }

    .contract-frame {
      background: white;
      border-radius: 20px;
      padding: 56px 48px;
      box-shadow: var(--shadow-lg);
      border: 1px solid rgba(212,175,55,0.14);
      max-width: 1100px;
      margin: 0 auto;
    }

    .contract-title {
      font-size: 3rem;
      text-align: center;
      margin: 0 0 2.4rem;
      color: #222;
    }

    .contract-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 56px;
    }

    .contract-list {
      list-style: none;
      padding: 0;
      margin: 0;
      font-size: 1.1rem;
      color: var(--text-light);
    }

    .contract-list li {
      position: relative;
      padding-left: 2em;
      margin-bottom: 1em;
    }

    .contract-list li::before {
      content: '✦';
      position: absolute;
      left: 0;
      color: var(--gold);
      font-size: 1.3em;
    }

    .actors h3 {
      font-size: 1.6rem;
      color: var(--gold-dark);
      margin: 0 0 1.3em;
    }

    /* CTA */
    .cta-section {
      padding: 0px 0 160px;
      text-align: center;
    }

    .cta-text {
      font-size: 2rem;
      font-family: 'Playfair Display', serif;
      color: #333;
      margin-bottom: 2.2rem;
    }

    .btn-cta {
      background: var(--gold);
      color: #1a1a1a;
      padding: 18px 60px;
      border: none;
      border-radius: 60px;
      font-size: 1.28rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.35s ease;
      box-shadow: 0 8px 32px rgba(212,175,55,0.28);
    }

    .btn-cta:hover {
      background: var(--gold-dark);
      transform: translateY(-4px);
      box-shadow: 0 16px 48px rgba(212,175,55,0.4);
    }

    /* ─────────────── МОДАЛКА ─────────────── */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.82);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.4s ease;
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .modal-overlay.active {
      opacity: 1;
      visibility: visible;
    }

    .modal {
      position: relative;
      width: 100%;
      max-width: 860px;
      height: 100dvh;
      max-height: 100dvh;
      background: white;
      border-radius: 0;
      overflow: hidden;
      box-shadow: none;
      display: flex;
      flex-direction: column;
      padding: 64px 32px 40px;
    }

    .modal-close {
      position: fixed;
      top: max(16px, env(safe-area-inset-top, 16px));
      right: 24px;
      background: none;
      border: none;
      color: var(--gold-dark);
      font-size: 2.6rem;
      cursor: pointer;
      z-index: 10;
      transition: all 0.3s;
    }

    .modal-close:hover {
      color: #222;
      transform: rotate(90deg) scale(1.12);
    }

    .modal-title {
      font-size: 2.4rem;
      text-align: center;
      margin: 0 0 0.6rem;
      color: #222;
      padding-top: env(safe-area-inset-top, 0);
    }

    .modal-subtitle {
      text-align: center;
      color: #666;
      margin: 0 0 2.2rem;
      font-size: 1.1rem;
    }

    .form-wrapper {
      flex: 1;
      overflow-y: scroll;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-y: contain;
      padding: 0 8px 32px;
      padding-bottom: calc(32px + env(safe-area-inset-bottom, 0));
    }

    .ya-form-iframe {
      width: 100%;
      height: 1000px !important;
      min-height: 600px;
      border: none;
      border-radius: 14px;
      background: #f8f6f0;
      display: block;
      transform: translateZ(0);
    }

    /* Responsive */
    @media (max-width: 1024px) {
      .contract-grid { grid-template-columns: 1fr; gap: 48px; }
    }

    @media (max-width: 768px) {
      .page-title   { font-size: 3.6rem; }
      .contract-frame { padding: 48px 32px; }
      .btn-cta      { padding: 16px 52px; font-size: 1.18rem; }

      .modal {
        padding: 56px 20px 32px;
      }

      .modal-title { font-size: 2.1rem; }
      .modal-close  { right: 16px; font-size: 2.4rem; }
    }

    @media (max-width: 540px) {
      .page-title   { font-size: 2.9rem; }
      .modal-title  { font-size: 1.9rem; }
      .form-wrapper { padding: 0 4px 40px; }
    }

    @media (max-height: 700px) {
      .ya-form-iframe {
        height: 600px !important;
        min-height: 1400px;
      }
    }
  </style>

  <script>
    const openBtn  = document.querySelector('.js-open-modal');
    const overlay  = document.querySelector('.js-modal-overlay');
    const closeBtn = document.querySelector('.js-close-modal');

    function openModal() {
      overlay.classList.add('active');
      document.body.classList.add('modal-open');
    }

    function closeModal() {
      overlay.classList.remove('active');
      document.body.classList.remove('modal-open');
    }

    openBtn?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);

    overlay?.addEventListener('click', e => {
      if (e.target === overlay) closeModal();
    });

    window.addEventListener('keydown', e => {
      if (e.key === 'Escape' && overlay.classList.contains('active')) {
        closeModal();
      }
    });
  </script>
</body>
</html>