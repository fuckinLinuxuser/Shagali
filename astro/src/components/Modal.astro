---
// WaitlistModal.astro
const formUrl = "https://forms.yandex.ru/u/67dd8eb250569051913a5454?iframe=1&theme=classic";
---

<div id="waitlist-modal" class="form-modal" hidden>
  <div class="form-modal__overlay"></div>
  <div class="form-modal__content">
    <button class="form-modal__close" aria-label="Закрыть">×</button>
    
    <h2 class="form-modal__title">Лист ожидания</h2>
    <p class="form-modal__subtitle">Оставьте заявку — сообщим, как только появятся билеты</p>

    <div class="form-modal__iframe-wrapper">
      <iframe 
        class="form-iframe"
        src={formUrl}
        frameborder="0"
        allowfullscreen
        scrolling="yes"
      ></iframe>
    </div>
  </div>
</div>

<style is:global>
  .form-modal {
    position: fixed;
    inset: 0;
    z-index: 1200;
    background: rgba(12, 10, 8, 0.94);
    backdrop-filter: blur(8px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease;
    /* важно: не используем display: grid здесь на мобильных — лучше flex */
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .form-modal:not([hidden]) {
    opacity: 1;
    visibility: visible;
  }

  .form-modal__overlay {
    position: absolute;
    inset: 0;
    background: inherit;
    z-index: 1;
  }

  .form-modal__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 820px;
    height: 100dvh;
    max-height: 100dvh;
    background: #14120d;
    border-radius: 0;                    /* на мобильных лучше без скруглений */
    overflow: hidden;
    box-shadow: none;                    /* тень иногда ломает рендеринг */
    display: flex;
    flex-direction: column;
  }

  .form-modal__close {
    position: fixed;                     /* ← fixed вместо absolute — важно! */
    top: max(16px, env(safe-area-inset-top, 16px));
    right: 20px;
    font-size: 2.6rem;
    color: #d4af57;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 10;
    transition: all 0.3s;
  }

  .form-modal__close:hover {
    color: #f0d9a7;
    transform: rotate(90deg) scale(1.15);
  }

  .form-modal__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.1rem, 6vw, 2.8rem);
    color: #d4af57;
    text-align: center;
    margin: 3.2rem 1.2rem 0.6rem;
    padding-top: env(safe-area-inset-top, 0);
  }

  .form-modal__subtitle {
    color: #c0b8a8;
    font-size: 1.1rem;
    text-align: center;
    margin: 0 1.8rem 2.2rem;
    line-height: 1.45;
    font-style: italic;
  }

  .form-modal__iframe-wrapper {
    flex: 1;
    overflow-y: scroll !important;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-y: contain;      /* предотвращает "прокрутку родителя" */
    padding: 0 1.2rem 2rem;
    background: #181512;
    /* учитываем safe areas снизу (особенно когда клавиатура) */
    padding-bottom: calc(2rem + env(safe-area-inset-bottom, 0));
  }

  .form-iframe {
    width: 100%;
    height: 2200px !important;           /* очень большой запас по высоте */
    min-height: 1600px;
    border: none;
    display: block;
    background: white;
    border-radius: 12px;
    transform: translateZ(0);            /* форсируем аппаратное ускорение */
  }

  /* Мобильные корректировки */
  @media (max-width: 720px) {
    .form-modal__content {
      width: 100%;
      height: 100dvh;
      max-height: 100dvh;
      border-radius: 0;
      border: none;
    }

    .form-modal__close {
      top: max(12px, env(safe-area-inset-top, 12px));
      right: 16px;
      font-size: 2.4rem;
    }

    .form-modal__title {
      margin-top: 2.4rem;
      font-size: 2.2rem;
    }

    .form-modal__iframe-wrapper {
      padding: 0 0.8rem 2.5rem;
      padding-bottom: calc(2.5rem + env(safe-area-inset-bottom, 0));
    }
  }

  /* Очень низкие экраны (когда клавиатура открыта) */
  @media (max-height: 700px) {
    .form-modal__iframe-wrapper {
      padding-bottom: calc(3rem + env(safe-area-inset-bottom, 40px));
    }

    .form-iframe {
      height: 1800px !important;
    }
  }

  body.form-modal-open {
    overflow: hidden;
    height: 100dvh;
    position: fixed;
    width: 100%;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('waitlist-modal');
    if (!modal) return;

    const closeBtn = modal.querySelector('.form-modal__close');

    function closeModal() {
      modal.hidden = true;
      document.body.classList.remove('form-modal-open');
    }

    closeBtn?.addEventListener('click', closeModal);

    modal.addEventListener('click', e => {
      if (e.target === modal || e.target.classList.contains('form-modal__overlay')) {
        closeModal();
      }
    });

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && !modal.hidden) {
        closeModal();
      }
    });

    window.openWaitlistModal = () => {
      if (modal) {
        modal.hidden = false;
        document.body.classList.add('form-modal-open');
        // небольшой таймаут, чтобы iframe успел подгрузиться
        setTimeout(() => {
          const iframe = modal.querySelector('.form-iframe');
          if (iframe) iframe.src = iframe.src; // force reload если нужно
        }, 300);
      }
    };
  });
</script>