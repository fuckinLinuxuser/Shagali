---
// WaitlistModal.astro
const formUrl = "https://forms.yandex.ru/u/67dd8eb250569051913a5454?iframe=1&theme=classic";
---

<div id="waitlist-modal" class="form-modal" hidden>
  <div class="form-modal__overlay"></div>
  <div class="form-modal__content">
    <button class="form-modal__close" aria-label="Закрыть">×</button>
    
    <h2 class="form-modal__title">Лист ожидания</h2>
    <p class="form-modal__subtitle">Оставьте заявку — сообщим, как только появятся билеты</p>

    <div class="form-modal__iframe-wrapper">
      <iframe 
        class="form-iframe"
        src={formUrl}
        frameborder="0"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</div>

<style is:global>
  .form-modal {
    position: fixed;
    inset: 0;
    z-index: 1200;
    display: grid;
    place-items: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease;
  }

  .form-modal:not([hidden]) {
    opacity: 1;
    visibility: visible;
  }

  .form-modal__overlay {
    position: absolute;
    inset: 0;
    background: rgba(12, 10, 8, 0.92);
    backdrop-filter: blur(8px);
  }

  .form-modal__content {
    position: relative;
    width: min(94%, 780px);
    max-height: 96vh;
    background: #14120d;
    border: 1px solid rgba(212, 175, 87, 0.18);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 24px 80px rgba(0,0,0,0.7);
    transform: translateY(30px);
    opacity: 0;
    transition: all 0.45s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .form-modal:not([hidden]) .form-modal__content {
    transform: translateY(0);
    opacity: 1;
  }

  .form-modal__close {
    position: absolute;
    top: 18px;
    right: 22px;
    font-size: 2.4rem;
    color: #d4af57;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 5;
    transition: all 0.3s;
  }

  .form-modal__close:hover {
    color: #f0d9a7;
    transform: rotate(90deg) scale(1.12);
  }

  .form-modal__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 5vw, 2.6rem);
    color: #d4af57;
    text-align: center;
    margin: 2.4rem 1.5rem 0.8rem;
  }

  .form-modal__subtitle {
    color: #c0b8a8;
    font-size: 1.05rem;
    text-align: center;
    margin: 0 2rem 2rem;
    line-height: 1.5;
    font-style: italic;
  }

  .form-modal__iframe-wrapper {
    height: 68vh;
    min-height: 620px;
    max-height: 82vh;
    overflow-y: auto;
    padding: 0 1.5rem 2rem;
    background: #181512;
  }

  .form-iframe {
    width: 100%;
    height: 100%;
    min-height: 1000px;
    border: none;
    border-radius: 12px;
    background: white;
  }

  @media (max-width: 720px) {
    .form-modal__content {
      width: 100%;
      max-height: 100vh;
      border-radius: 0;
      border: none;
      height: 100vh;
    }

    .form-modal__iframe-wrapper {
      height: calc(100vh - 140px);
      min-height: auto;
      padding: 0 1rem 1.5rem;
    }

    .form-iframe {
      min-height: calc(100vh - 160px);
    }

    .form-modal__close {
      top: 14px;
      right: 16px;
      font-size: 2.2rem;
    }
  }

  body.form-modal-open {
    overflow: hidden;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('waitlist-modal');
    if (!modal) return;

    // Закрытие
    const closeBtn = modal.querySelector('.form-modal__close');
    closeBtn?.addEventListener('click', () => {
      modal.hidden = true;
      document.body.classList.remove('form-modal-open');
    });

    // Закрытие по клику на оверлей
    modal.addEventListener('click', e => {
      if (e.target === modal || e.target.classList.contains('form-modal__overlay')) {
        modal.hidden = true;
        document.body.classList.remove('form-modal-open');
      }
    });

    // ESC
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && !modal.hidden) {
        modal.hidden = true;
        document.body.classList.remove('form-modal-open');
      }
    });
  });

  // Функция для открытия (будет вызываться из других компонентов)
  window.openWaitlistModal = () => {
    const modal = document.getElementById('waitlist-modal');
    if (modal) {
      modal.hidden = false;
      document.body.classList.add('form-modal-open');
    }
  };
</script>