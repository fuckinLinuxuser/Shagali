---
// Например: src/pages/index.astro или где у вас главная
---

<section id="collaboration-teaser" class="section collaboration-teaser">
  <div class="container">
    <h2>Условия сотрудничества</h2>
    
    <div class="teaser-content">
      <p class="lead">
        Мы ищем не просто исполнителей.<br />
        Мы ищем <strong>соавторов</strong> — тех, кто готов гореть вместе с нами.
      </p>

      <p class="teaser-subtitle">
        Работа только из любви и кайфа.<br />
        Масштабно или никак. Честно. Глубоко. Навсегда.
      </p>

      <a href="/collaboration" class="btn-primary">
        Подробные условия и принципы
      </a>
    </div>
  </div>
</section>

<style>
  .collaboration-teaser {
    background: linear-gradient(135deg, #0f0f0a 0%, #1a1a12 100%);
    color: #f5f0e6;
    padding: 120px 0 140px;
    position: relative;
    overflow: hidden;
  }

  .collaboration-teaser::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 80% 20%, rgba(212,175,87,0.06) 0%, transparent 70%);
    pointer-events: none;
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
  }

  h2 {
    font-family: 'Playfair Display', serif;
    font-size: 3.8rem;
    font-weight: 700;
    color: #d4af57;
    margin-bottom: 1.8rem;
    letter-spacing: 1px;
    text-shadow: 0 4px 20px rgba(0,0,0,0.5);
  }

  .teaser-content {
    max-width: 780px;
    margin: 0 auto;
  }

  .lead {
    font-size: 1.55rem;
    line-height: 1.6;
    color: #d9d2c6;
    font-weight: 300;
    margin-bottom: 1.8rem;
  }

  .lead strong {
    color: #d4af57;
  }

  .teaser-subtitle {
    font-size: 1.28rem;
    line-height: 1.65;
    color: #c9c0b3;
    margin-bottom: 3rem;
    font-style: italic;
  }

  .btn-primary {
    display: inline-block;
    background: #d4af57;
    color: #0f0f0a;
    padding: 16px 52px;
    border-radius: 50px;
    font-size: 1.22rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.35s ease;
    box-shadow: 0 8px 30px rgba(212,175,87,0.28);
  }

  .btn-primary:hover {
    background: #e6c678;
    transform: translateY(-4px);
    box-shadow: 0 16px 50px rgba(212,175,87,0.45);
  }

  @media (max-width: 768px) {
    .collaboration-teaser {
      padding: 80px 0 100px;
    }

    h2 {
      font-size: 2.8rem;
    }

    .lead {
      font-size: 1.32rem;
    }

    .teaser-subtitle {
      font-size: 1.15rem;
    }

    .btn-primary {
      padding: 14px 40px;
      font-size: 1.08rem;
    }
  }

  @media (max-width: 480px) {
    h2 {
      font-size: 2.4rem;
    }
    .lead {
      font-size: 1.18rem;
    }
  }
</style>