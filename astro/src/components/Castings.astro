<style>
        body {
            font-family: 'Arial', sans-serif;
            background: #f8f8f8;
            color: #222;
            margin: 0;
            padding: 0;
        }

        .castings-section {
            max-width: 1400px;
            margin: 60px auto;
            padding: 0 20px;
            text-align: center;
        }

        .castings-section h1 {
            font-size: 2.8em;
            margin-bottom: 50px;
            color: #222;
            text-transform: uppercase;
            letter-spacing: 3px;
            position: relative;
        }

        .castings-section h1::after {
            content: '';
            width: 140px;
            height: 3px;
            background: #d4af37;
            position: absolute;
            bottom: -15px;
            left: 50%;
            transform: translateX(-50%);
        }

        /* Контейнер timeline */
        .timeline-container {
            position: relative;
            overflow: hidden;
            padding: 40px 0;
        }

        .timeline-wrapper {
            display: flex;
            transition: transform 0.5s ease;
            width: max-content; /* чтобы не сжимался */
        }

        .timeline-line {
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(to right, #d4af37, #b8972e);
            transform: translateY(-50%);
            z-index: 1;
        }

        .timeline-item {
            position: relative;
            width: 360px;
            min-width: 360px;
            margin: 0 30px;
            text-align: center;
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.8s ease, transform 0.8s ease;
            z-index: 2;
        }

        .timeline-item.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .timeline-item:nth-child(odd)  { margin-top: -140px; } /* сверху */
        .timeline-item:nth-child(even) { margin-top:  100px; } /* снизу  */

        .timeline-dot {
            width: 24px;
            height: 24px;
            background: white;
            border: 4px solid #d4af37;
            border-radius: 50%;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 3;
            box-shadow: 0 0 0 6px rgba(212,175,55,0.2);
        }

        .timeline-date {
            font-size: 1.1em;
            font-weight: bold;
            color: #d4af37;
            margin-bottom: 12px;
            background: rgba(0,0,0,0.7);
            color: white;
            padding: 6px 14px;
            border-radius: 20px;
            display: inline-block;
        }

        .timeline-content {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 6px 18px rgba(0,0,0,0.12);
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .timeline-content:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 28px rgba(0,0,0,0.18);
            border: 1px solid #d4af37;
        }

        .timeline-thumbnail {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 8px;
            margin-bottom: 14px;
        }

        .timeline-title {
            font-size: 1.45em;
            margin: 0 0 10px;
            color: #222;
        }

        .timeline-teaser {
            font-size: 0.97em;
            color: #555;
            line-height: 1.45;
            margin: 0 0 16px;
        }

        .btn-detail {
            background: #d4af37;
            color: #1a1a1a;
            border: none;
            padding: 10px 20px;
            border-radius: 25px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-detail:hover {
            background: #b8972e;
            transform: scale(1.05);
        }

        /* Стрелки */
        .nav-arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(0,0,0,0.5);
            color: white;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8em;
            cursor: pointer;
            z-index: 10;
            transition: background 0.3s;
        }

        .nav-arrow:hover { background: rgba(0,0,0,0.8); }
        .nav-arrow.left  { left: 10px; }
        .nav-arrow.right { right: 10px; }

        @media (max-width: 900px) {
            .timeline-item {
                margin: 0 20px;
                width: 320px;
                min-width: 320px;
            }
            .timeline-item:nth-child(odd)  { margin-top: -120px; }
            .timeline-item:nth-child(even) { margin-top:  80px; }
        }

        @media (max-width: 600px) {
            .timeline-container { padding: 20px 0; }
            .nav-arrow { display: none; } /* на мобильных — просто свайп */
        }
    </style>

<section class="castings-section">
    <h1>Пробы и кастинги</h1>

    <div class="timeline-container">
        <div class="timeline-line"></div>

        <div class="timeline-wrapper" id="timelineWrapper">

            <!-- Кастинг 1 -->
            <div class="timeline-item" data-name="Кастинг: Ромео и Джульетта" 
                 data-date="15 октября 2025" 
                 data-teaser="Ищем молодых актёров 18–25 лет на главные роли. Опыт не обязателен, важен огонь в глазах." 
                 data-video="https://www.youtube.com/embed/dQw4w9WgXcQ" 
                 data-desc="Полное описание кастинга: дата, время, место, что готовить, контакты для записи...">
                <div class="timeline-dot"></div>
                <div class="timeline-date">15 октября 2025</div>
                <div class="timeline-content">
                    <img src="https://via.placeholder.com/360x180/333/eee?text=Ромео+и+Джульетта" alt="Thumbnail" class="timeline-thumbnail">
                    <h3 class="timeline-title">Ромео и Джульетта</h3>
                    <p class="timeline-teaser">Ищем молодых актёров 18–25 лет на главные роли...</p>
                    <button class="btn-detail">Подробнее</button>
                </div>
            </div>

            <!-- Кастинг 2 -->
            <div class="timeline-item" data-name="Проба: Арбенин — Маскарад" 
                 data-date="2 ноября 2025" 
                 data-teaser="Требуется мужчина 30–45 лет с сильной дикцией и драматическим темпераментом." 
                 data-video="https://www.youtube.com/embed/dQw4w9WgXcQ" 
                 data-desc="Подробности: характер роли, реперные отрывки, дата и адрес пробы...">
                <div class="timeline-dot"></div>
                <div class="timeline-date">2 ноября 2025</div>
                <div class="timeline-content">
                    <img src="https://via.placeholder.com/360x180/444/eee?text=Маскарад" alt="Thumbnail" class="timeline-thumbnail">
                    <h3 class="timeline-title">Арбенин — Маскарад</h3>
                    <p class="timeline-teaser">Требуется мужчина 30–45 лет с сильной дикцией...</p>
                    <button class="btn-detail">Подробнее</button>
                </div>
            </div>

            <!-- Кастинг 3 -->
            <div class="timeline-item" data-name="Открытый кастинг — Новая пьеса" 
                 data-date="20 ноября 2025" 
                 data-teaser="Приходите без подготовки. Берём всех желающих от 16 лет." 
                 data-video="https://www.youtube.com/embed/dQw4w9WgXcQ" 
                 data-desc="Свободный формат, много ролей второго плана, экспериментальный проект...">
                <div class="timeline-dot"></div>
                <div class="timeline-date">20 ноября 2025</div>
                <div class="timeline-content">
                    <img src="https://via.placeholder.com/360x180/555/eee?text=Новая+пьеса" alt="Thumbnail" class="timeline-thumbnail">
                    <h3 class="timeline-title">Открытый кастинг</h3>
                    <p class="timeline-teaser">Приходите без подготовки. Берём всех...</p>
                    <button class="btn-detail">Подробнее</button>
                </div>
            </div>

            <!-- Добавляй новые .timeline-item сюда -->

        </div>

        <div class="nav-arrow left" id="prev">←</div>
        <div class="nav-arrow right" id="next">→</div>
    </div>
</section>

<!-- Модальное окно (одно на страницу) -->
<div id="modal" class="modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.8); z-index:1000; overflow:auto;">
    <div style="background:white; margin:6% auto; padding:0; border-radius:12px; width:90%; max-width:760px; max-height:88vh; overflow-y:auto; position:relative; box-shadow:0 10px 40px rgba(0,0,0,0.5);">
        <span id="closeModal" style="position:absolute; right:20px; top:10px; font-size:42px; color:#d4af37; cursor:pointer;">×</span>
        <div style="padding:30px 40px; text-align:center;">
            <h2 id="modalTitle" style="margin:0 0 10px; color:#222;"></h2>
            <div id="modalDate" style="color:#d4af37; font-size:1.2em; margin-bottom:20px;"></div>
            <iframe id="modalVideo" width="100%" height="420" frameborder="0" allowfullscreen style="border-radius:8px;"></iframe>
            <p id="modalDesc" style="margin-top:25px; line-height:1.7; color:#444; font-size:1.05em;"></p>
        </div>
    </div>
</div>

<script>
    // Fade-in при скролле/загрузке
    const items = document.querySelectorAll('.timeline-item');
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('visible');
            }
        });
    }, { threshold: 0.2 });

    items.forEach(item => observer.observe(item));

    // Навигация стрелками
    const wrapper = document.getElementById('timelineWrapper');
    const prev = document.getElementById('prev');
    const next = document.getElementById('next');
    let scrollPos = 0;
    const itemWidth = 360 + 60; // ширина + margin

    if (next) next.addEventListener('click', () => {
        scrollPos += itemWidth;
        if (wrapper) wrapper.style.transform = `translateX(-${scrollPos}px)`;
    });

    if (prev) prev.addEventListener('click', () => {
        scrollPos = Math.max(0, scrollPos - itemWidth);
        if (wrapper) wrapper.style.transform = `translateX(-${scrollPos}px)`;
    });

    // Модалка
    document.querySelectorAll('.btn-detail').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const item = e.target.closest('.timeline-item');
            if (document.getElementById('modalTitle')) document.getElementById('modalTitle').textContent = item.dataset.name;
            if (document.getElementById('modalDate')) document.getElementById('modalDate').textContent = item.dataset.date;
            if (document.getElementById('modalVideo')) document.getElementById('modalVideo').src = item.dataset.video;
            if (document.getElementById('modalDesc')) document.getElementById('modalDesc').textContent = item.dataset.desc;
            if (document.getElementById('modal')) document.getElementById('modal').style.display = 'block';
        });
    });

    if (document.getElementById('closeModal')) document.getElementById('closeModal').addEventListener('click', () => {
        if (document.getElementById('modal')) document.getElementById('modal').style.display = 'none';
        if (document.getElementById('modalVideo')) document.getElementById('modalVideo').src = ''; // остановка видео
    });

    if (document.getElementById('modal')) document.getElementById('modal').addEventListener('click', (e) => {
        if (e.target === document.getElementById('modal')) {
            document.getElementById('modal').style.display = 'none';
            document.getElementById('modalVideo').src = '';
        }
    });
</script>