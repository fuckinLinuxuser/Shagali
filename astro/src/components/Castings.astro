<style>
    body {
        font-family: 'Arial', sans-serif;
        background: #fafbd6;
        color: #222;
        margin: 0;
        padding: 0;
    }

    .castings-section {
        max-width: 1400px;
        margin: 60px auto;
        padding: 0 20px;
        text-align: center;
    }

    .castings-section h1 {
        font-size: 2.8em;
        margin-bottom: 50px;
        color: #222;
        text-transform: uppercase;
        letter-spacing: 3px;
        position: relative;
    }

    .castings-section h1::after {
        content: '';
        width: 140px;
        height: 3px;
        background: #d4af37;
        position: absolute;
        bottom: -15px;
        left: 50%;
        transform: translateX(-50%);
    }

    .timeline-container {
        position: relative;
        overflow-x: auto;
        overflow-y: hidden;
        padding: 140px 60px 140px;
        -webkit-overflow-scrolling: touch;
        scroll-behavior: smooth;
        scrollbar-width: thin;
        scrollbar-color: #d4af37 #fafbd6;
    }

    .timeline-container::-webkit-scrollbar {
        height: 8px;
    }

    .timeline-container::-webkit-scrollbar-track {
        background: #fafbd6;
        border-radius: 4px;
    }

    .timeline-container::-webkit-scrollbar-thumb {
        background: #d4af37;
        border-radius: 4px;
    }

    .timeline-wrapper {
        display: flex;
        gap: 60px;
        min-width: max-content;
        touch-action: pan-x;
        padding: 0 40px;
    }

    .timeline-line {
        position: absolute;
        top: 50%;
        left: 60px;
        right: 60px;
        height: 5px;
        background: linear-gradient(to right, #d4af37, #b8972e, #d4af37);
        transform: translateY(-50%);
        z-index: 0;
        pointer-events: none;
    }

    .nav-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 64px;
        height: 64px;
        background: rgba(0,0,0,0.6);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.4rem;
        cursor: pointer;
        z-index: 20;
        transition: all 0.22s ease;
        box-shadow: 0 4px 14px rgba(0,0,0,0.35);
    }

    .nav-arrow:hover {
        background: #d4af37;
        transform: translateY(-50%) scale(1.08);
    }

    .nav-arrow.left  { left: 20px; }
    .nav-arrow.right { right: 20px; }

    @media (max-width: 900px) {
        .nav-arrow {
            display: none !important;
        }
    }

    .timeline-item {
        flex: 0 0 360px;
        text-align: center;
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.7s ease;
        scroll-snap-align: center;
    }

    .timeline-item.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .timeline-item:nth-child(odd)  { margin-top: -140px; }
    .timeline-item:nth-child(even) { margin-top: 100px; }

    .timeline-date {
        font-size: 1.1em;
        font-weight: bold;
        color: white;
        background: rgba(0,0,0,0.75);
        padding: 6px 16px;
        border-radius: 20px;
        display: inline-block;
        margin-bottom: 12px;
    }

    .timeline-content {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.15);
        transition: all 0.35s ease;
        cursor: pointer;
    }

    .timeline-content:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 28px rgba(0,0,0,0.18);
        border: 1px solid #d4af37;
    }

    .timeline-thumbnail {
        width: 100%;
        height: 180px;
        object-fit: cover;
        border-radius: 8px;
        margin-bottom: 14px;
    }

    .btn-detail {
        background: #d4af37;
        color: #1a1a1a;
        border: none;
        padding: 10px 24px;
        border-radius: 30px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-detail:hover {
        background: #b8972e;
        transform: scale(1.05);
    }

    .timeline-progress {
        position: absolute;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%);
        width: 240px;
        height: 5px;
        background: rgba(0,0,0,0.25);
        border-radius: 3px;
        overflow: hidden;
        pointer-events: none;
    }

    .progress-fill {
        height: 100%;
        background: #d4af37;
        width: 0;
        transition: width 0.4s ease-out;
    }

    /* ─────────────── МОДАЛЬНОЕ ОКНО ─────────────── */
    #castings-modal {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.88);
        z-index: 2000;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    #castings-modal .modal-content {
        background: white;
        border-radius: 16px;
        max-width: 820px;
        width: 100%;
        max-height: 92vh;
        overflow-y: auto;
        position: relative;
        box-shadow: 0 20px 60px rgba(0,0,0,0.6);
    }

    #castings-modal .close {
        position: absolute;
        right: 24px;
        top: 16px;
        font-size: 48px;
        color: #d4af37;
        cursor: pointer;
        z-index: 10;
    }

    #modal-body {
        padding: 40px 50px 50px;
        text-align: center;
    }

    #modalTitle {
        margin: 0 0 8px;
        font-size: 2.1em;
        color: #222;
    }

    #modalDate {
        color: #d4af37;
        font-size: 1.3em;
        margin-bottom: 24px;
    }

    #modalVideoContainer {
        position: relative;
        padding-bottom: 56.25%;
        height: 0;
        border-radius: 12px;
        overflow: hidden;
        background: #000;
        margin: 20px 0 32px;
    }

    #modalVideo {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: none;
    }

    #modalDesc {
        text-align: left;
        line-height: 1.7;
        color: #444;
        font-size: 1.08em;
        white-space: pre-wrap;
    }

    /* Адаптив */
    @media (max-width: 900px) {
        .timeline-container {
            padding: 100px 30px 100px;
        }
        .timeline-wrapper {
            gap: 40px;
        }
        .timeline-item {
            flex: 0 0 300px;
        }
        .timeline-item:nth-child(odd)  { margin-top: -110px; }
        .timeline-item:nth-child(even) { margin-top: 80px; }
        .timeline-progress {
            display: none;
        }
    }

    @media (max-width: 600px) {
        .timeline-container {
            padding: 90px 20px 90px;
        }
        .timeline-item {
            flex: 0 0 280px;
        }
        .timeline-wrapper {
            gap: 32px;
        }
    }
</style>

<section class="castings-section">
    <h1>Пробы и кастинги</h1>

    <div class="timeline-container" id="timelineContainer">
        <div class="timeline-line"></div>
        <div class="timeline-wrapper">

            <div class="timeline-item"
                 data-name="Лисье Танго"
                 data-date="Весна 2025"
                 data-description="Удивительная история про танец из детского спектакля «Зверский детектив», в который я влюбилась с первого взгляда. В оригинале Лисичка танцевала с Барсукотом – и это был совершенно очаровательный и забавный дуэт. Подумалось – а вдруг из этого может появиться нечто более… взрослое?\nСпрашиваю стажеров: «Сможете?» Без раздумий кивают. Оглядываюсь: «Где попробуем?» Скидывают сумки и куртки прямо на пол – и пробуют прямо в метро. Не сходя с места… \nТанго снималось несколько раз – в концертном зале, в лесу под проливным дождем. \nВ этой творческой отваге было чудо. \nНа память остались эти кадры."
                 data-video="/videos/tango.mp4">
                <div class="timeline-date">Весна 2025</div>
                <div class="timeline-content">
                    <img src="/images/castings/foxes_tango.JPG" alt="Лисье Танго" class="timeline-thumbnail">
                    <h3 class="timeline-title">Лисье Танго</h3>
                    <p class="timeline-teaser">Удивительная история про танец...</p>
                    <button class="btn-detail">Подробнее</button>
                </div>
            </div>

            <div class="timeline-item"
                 data-name="Комарово"
                 data-date="Лето 2025"
                 data-description="Летний отдых на природе – дело хорошее… для лентяев. \nА для молодых актёров лето – это маленькая жизнь, наполненная творчеством, впечатлениями и приключениями. \nМы сняли домик в Комарово, где сам воздух пропитан вдохновением, где творили в своё время Ахматова и Бродский, братья Стругацкие и Шостакович…\nСолнечным утром мы успели позавтракать и порадоваться хорошей погоде. \nКак только выдвинулись на съемки – начался (и потом только усиливался) дождь. \n«Не сахарные, не растаем», - отважно решили актеры. \nПланов были полные карманы:\n- научиться работать в границах кадра;\n- попрактиковаться в записи актерских видеовизиток;\n- сделать подсъемку для портфолио.\nУспели – всё. Устали – до дрожи в коленях. Довольны – по самую макушку)"
                 data-video="/videos/komarovo.mp4">
                <div class="timeline-date">Лето 2025</div>
                <div class="timeline-content">
                    <img src="/images/castings/komarovo.JPG" alt="Комарово" class="timeline-thumbnail">
                    <h3 class="timeline-title">Комарово</h3>
                    <p class="timeline-teaser">Летний отдых на природе – дело хорошее…</p>
                    <button class="btn-detail">Подробнее</button>
                </div>
            </div>

            <div class="timeline-item"
                 data-name="Шоу Скрипки"
                 data-date="Зима 2026"
                 data-description="Идея просто витала в воздухе. \nНесколько симпатичных и заряженных молодых творцов – актеры, танцоры, музыканты – решили подать заявку на конкурс синтетического искусства во Франции.\nРезультат пока неизвестен, но сама идея осталась и вдохновила на продолжение. \nПоедем ли в Париж – это вопрос. \nНо нам хочется увидеть эту красоту на сцене. И мы знаем, как сказку сделать проектом."
                 data-video="/videos/skripka.mp4">
                <div class="timeline-date">Зима 2026</div>
                <div class="timeline-content">
                    <img src="/images/castings/skripka.jpg" alt="Шоу Скрипки" class="timeline-thumbnail">
                    <h3 class="timeline-title">Шоу Скрипки</h3>
                    <p class="timeline-teaser">Несколько симпатичных и заряженных молодых творцов...</p>
                    <button class="btn-detail">Подробнее</button>
                </div>
            </div>

        </div>

        <div class="nav-arrow left" id="prev">←</div>
        <div class="nav-arrow right" id="next">→</div>

        <div class="timeline-progress">
            <div class="progress-fill" id="progressFill"></div>
        </div>
    </div>
</section>

<!-- Модальное окно -->
<div id="castings-modal">
    <div class="modal-content">
        <span class="close">×</span>
        <div id="modal-body">
            <h2 id="modalTitle"></h2>
            <div id="modalDate"></div>
            <div id="modalVideoContainer">
                <video id="modalVideo" controls playsinline>
                    <source id="modalVideoSource" src="" type="video/mp4">
                    Ваш браузер не поддерживает видео.
                </video>
            </div>
            <div id="modalDesc"></div>
        </div>
    </div>
</div>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('timelineContainer');
    const prev = document.getElementById('prev');
    const next = document.getElementById('next');
    const progressFill = document.getElementById('progressFill');

    const items = document.querySelectorAll('.timeline-item');

    // Прокрутка стрелками (только десктоп)
    if (prev && next) {
        const scrollStep = 420; // ширина карточки + gap

        next.addEventListener('click', () => {
            container.scrollBy({ left: scrollStep, behavior: 'smooth' });
        });

        prev.addEventListener('click', () => {
            container.scrollBy({ left: -scrollStep, behavior: 'smooth' });
        });
    }

    // Обновление прогресс-бара
    function updateProgress() {
        if (!progressFill || !container) return;
        const maxScroll = container.scrollWidth - container.clientWidth;
        const percent = maxScroll > 0 ? (container.scrollLeft / maxScroll) * 100 : 0;
        progressFill.style.width = `${percent}%`;
    }

    // Выделение ближайшей карточки
    function highlightNearest() {
        if (!container) return;
        const containerRect = container.getBoundingClientRect();
        const center = containerRect.left + containerRect.width / 2;

        let closest = null;
        let minDist = Infinity;

        items.forEach(item => {
            const rect = item.getBoundingClientRect();
            const dist = Math.abs((rect.left + rect.width / 2) - center);
            if (dist < minDist) {
                minDist = dist;
                closest = item;
            }
        });

        items.forEach(it => it.classList.remove('nearest'));
        if (closest) closest.classList.add('nearest');
    }

    container.addEventListener('scroll', () => {
        updateProgress();
        highlightNearest();
    });

    // Клик по карточке → центрируем (только десктоп)
    items.forEach(item => {
        item.addEventListener('click', e => {
            if (e.target.closest('.btn-detail')) return;
            if (window.innerWidth <= 900) return;

            const itemLeft = item.offsetLeft;
            const target = itemLeft - (container.clientWidth / 2) + (item.offsetWidth / 2);
            container.scrollTo({ left: target, behavior: 'smooth' });
        });
    });

    // Появление карточек при скролле
    const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('visible');
            }
        });
    }, { threshold: 0.2 });

    items.forEach(item => observer.observe(item));

    // Инициализация
    setTimeout(() => {
        updateProgress();
        highlightNearest();
    }, 300);

    // ─────────────── Модальное окно ───────────────
    const modal = document.getElementById('castings-modal');
    const modalTitle = document.getElementById('modalTitle');
    const modalDate = document.getElementById('modalDate');
    const modalDesc = document.getElementById('modalDesc');
    const video = document.getElementById('modalVideo');
    const videoSource = document.getElementById('modalVideoSource');
    const closeBtn = document.querySelector('#castings-modal .close');

    document.querySelectorAll('.btn-detail').forEach(btn => {
        btn.addEventListener('click', e => {
            e.stopPropagation();
            const card = btn.closest('.timeline-item');

            modalTitle.textContent = card.dataset.name;
            modalDate.textContent = card.dataset.date;
            modalDesc.textContent = card.dataset.description;

            videoSource.src = card.dataset.video;
            video.load();
            video.play().catch(() => {});

            modal.style.display = 'flex';
            document.body.style.overflow = 'hidden';
        });
    });

    function closeModal() {
        modal.style.display = 'none';
        document.body.style.overflow = '';
        video.pause();
        video.currentTime = 0;
    }

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', e => {
        if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape' && modal.style.display === 'flex') closeModal();
    });
});
</script>