<style>
    body {
        font-family: 'Arial', sans-serif;
        background: #fafbd6;
        color: #222;
        margin: 0;
        padding: 0;
    }
    .castings-section {
        max-width: 1400px;
        margin: 60px auto;
        padding: 0 20px;
        text-align: center;
    }
    .castings-section h1 {
        font-size: 2.8em;
        margin-bottom: 50px;
        color: #222;
        text-transform: uppercase;
        letter-spacing: 3px;
        position: relative;
    }
    .castings-section h1::after {
        content: '';
        width: 140px;
        height: 3px;
        background: #d4af37;
        position: absolute;
        bottom: -15px;
        left: 50%;
        transform: translateX(-50%);
    }
    .timeline-container {
        position: relative;
        overflow: hidden;
        padding: 140px 0 100px;
    }
    .timeline-wrapper {
        display: flex;
        transition: transform 0.6s ease-out;
        width: max-content;
        position: relative;
    }
    .timeline-line {
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        height: 5px;
        background: linear-gradient(to right, #d4af37, #b8972e, #d4af37);
        box-shadow: 0 1px 6px rgba(212,175,55,0.3);
        transform: translateY(-50%);
        z-index: 0;
    }
    .timeline-item {
        position: relative;
        width: 360px;
        min-width: 360px;
        margin: 0 30px;
        text-align: center;
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.8s ease, transform 0.8s ease, box-shadow 0.4s ease;
        z-index: 2;
    }
    .timeline-item.visible {
        opacity: 1;
        transform: translateY(0);
    }
    .timeline-item:nth-child(odd) { margin-top: -140px; }
    .timeline-item:nth-child(even) { margin-top: 100px; }
    .timeline-date {
        font-size: 1.1em;
        font-weight: bold;
        color: #d4af37;
        margin-bottom: 12px;
        background: rgba(0,0,0,0.7);
        color: white;
        padding: 6px 14px;
        border-radius: 20px;
        display: inline-block;
    }
    .timeline-content {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.12);
        transition: all 0.4s ease;
        cursor: pointer;
    }
    .timeline-content:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 28px rgba(0,0,0,0.18);
        border: 1px solid #d4af37;
    }
    .timeline-thumbnail {
        width: 100%;
        height: 180px;
        object-fit: cover;
        border-radius: 8px;
        margin-bottom: 14px;
    }
    .timeline-title {
        font-size: 1.45em;
        margin: 0 0 10px;
        color: #222;
    }
    .timeline-teaser {
        font-size: 0.97em;
        color: #555;
        line-height: 1.45;
        margin: 0 0 16px;
    }
    .btn-detail {
        background: #d4af37;
        color: #1a1a1a;
        border: none;
        padding: 10px 20px;
        border-radius: 25px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }
    .btn-detail:hover {
        background: #b8972e;
        transform: scale(1.05);
    }
    .timeline-year {
        font-family: 'Playfair Display', serif;
        position: absolute;
        right: -160px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 3.2em;
        font-weight: bold;
        color: #2a2500;
        opacity: 0.75;
        letter-spacing: 4px;
        white-space: nowrap;
        pointer-events: none;
        z-index: 3;
        text-shadow: 0 2px 6px rgba(0,0,0,0.5);
    }
    .nav-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(0,0,0,0.5);
        color: white;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8em;
        cursor: pointer;
        z-index: 10;
        transition: all 0.3s;
    }
    .nav-arrow:hover {
        background: rgba(0,0,0,0.8);
        transform: translateY(-50%) scale(1.1);
    }
    .nav-arrow.left { left: 10px; }
    .nav-arrow.right { right: 10px; }
    .timeline-progress {
        position: absolute;
        bottom: 15px;
        left: 50%;
        transform: translateX(-50%);
        width: 70%;
        height: 3px;
        background: rgba(212,175,55,0.2);
        border-radius: 2px;
        overflow: hidden;
    }
    .progress-fill {
        height: 100%;
        width: 0%;
        background: #d4af37;
        transition: width 0.4s ease;
    }
    .timeline-item.nearest .timeline-content {
        border: 1px solid #d4af37;
    }
    @media (max-width: 900px) {
        .timeline-item {
            margin: 0 20px;
            width: 320px;
            min-width: 320px;
        }
        .timeline-item:nth-child(odd) { margin-top: -120px; }
        .timeline-item:nth-child(even) { margin-top: 80px; }
        .timeline-year { font-size: 2.4em; right: -100px; }
    }
    @media (max-width: 600px) {
        .timeline-container { padding: 120px 0 80px; }
        .nav-arrow { display: none; }
        .timeline-year {
            left: 20px;
            top: -60px;
            transform: none;
            font-size: 2.2em;
        }
        .timeline-progress { width: 90%; }
    }
  </style>
</head>
<body>

<section class="castings-section">
    <h1>Пробы и кастинги</h1>
    <div class="timeline-container">
        <div class="timeline-line"></div>
        <div class="timeline-wrapper" id="timelineWrapper">

            <!-- Карточка 1 -->
            <div class="timeline-item"
                data-name="Лисье Танго"
                data-date="15 октября 2025"
                data-teaser="Удивительная история про танец из детского спектакля «Зверский детектив», в который я влюбилась с первого взгляда."
                data-description="Удивительная история про танец из детского спектакля «Зверский детектив», в который я влюбилась с первого взгляда. В оригинале Лисичка танцевала с Барсукотом – и это был совершенно очаровательный и забавный дуэт. Подумалось – а вдруг из этого может появиться нечто более… взрослое?
Спрашиваю стажеров: «Сможете?» Без раздумий кивают. Оглядываюсь: «Где попробуем?» Скидывают сумки и куртки прямо на пол – и пробуют прямо в метро. Не сходя с места… 
Танго снималось несколько раз – в концертном зале, в лесу под проливным дождем. 
В этой творческой отваге было чудо. 
На память остались эти кадры. "
                data-video="https://rutube.ru/play/embed/65f7d0fc843441125fe06a41536de967/"
            >
                <div class="timeline-date">15 октября 2025</div>
                <div class="timeline-content">
                    <!-- iframe убрали -->
                    <img src="/dist/images/castings/foxes_tango.JPG" alt="Лисье Танго" class="timeline-thumbnail">
                    <h3 class="timeline-title">Лисье Танго</h3>
                    <p class="timeline-teaser">Удивительная история про танец...</p>
                    <button class="btn-detail">Подробнее</button>
                </div>
            </div>


            <!-- Карточка 2 -->
            <div class="timeline-item"
                 data-name="Шоу Скрипки"
                 data-date="2 ноября 2025"
                 data-teaser="Несколько симпатичных и заряженных молодых творцов – актеры, танцоры, музыканты – решили подать заявку на конкурс синтетического искусства во Франции."
                 data-video="https://www.youtube.com/embed/dQw4w9WgXcQ"
                 data-description="
Идея просто витала в воздухе. 
Несколько симпатичных и заряженных молодых творцов – актеры, танцоры, музыканты – решили подать заявку на конкурс синтетического искусства во Франции. 
Результат пока неизвестен, но сама идея осталась и вдохновила на продолжение. 
Поедем ли в Париж – это вопрос. 
Но нам хочется увидеть эту красоту на сцене. И мы знаем, как сказку сделать проектом.
                 ">
                <div class="timeline-date">2 ноября 2025</div>
                <div class="timeline-content">
                    <img src="/dist/images/castings/skripka.jpg" alt="Шоу Скрипки" class="timeline-thumbnail">
                    <h3 class="timeline-title">Шоу Скрипки</h3>
                    <p class="timeline-teaser">Несколько симпатичных и заряженных молодых творцов...</p>
                    <button class="btn-detail">Подробнее</button>
                </div>
            </div>

            <!-- Карточка 3 -->
            <div class="timeline-item"
                 data-name="Комарово"
                 data-date="20 ноября 2025"
                 data-teaser="Летний отдых на природе – дело хорошее… для лентяев."
                 data-video="https://www.youtube.com/embed/dQw4w9WgXcQ"
                 data-description="
Летний отдых на природе – дело хорошее… для лентяев. 
А для молодых актёров лето – это маленькая жизнь, наполненная творчеством, впечатлениями и приключениями. 
Мы сняли домик в Комарово, где сам воздух пропитан вдохновением, где творили в своё время Ахматова и Бродский, братья Стругацкие и Шостакович…
Солнечным утром мы успели позавтракать и порадоваться хорошей погоде. 
Как только выдвинулись на съемки – начался (и потом только усиливался) дождь. 
«Не сахарные, не растаем», - отважно решили актеры. 
Планов были полные карманы:
- научиться работать в границах кадра (а это очень непросто без опыта съемок);
- попрактиковаться в записи актерских видеовизиток;
- сделать подсъемку для портфолио.
Успели – всё. 
Устали – до дрожи в коленях. 
Довольны – по самую макушку)
                 ">
                <div class="timeline-year">2025</div>
                <div class="timeline-date">20 ноября 2025</div>
                <div class="timeline-content">
                    <img src="/dist/images/castings/komarovo.JPG" alt="Комарово" class="timeline-thumbnail">
                    <h3 class="timeline-title">Комарово</h3>
                    <p class="timeline-teaser">Летний отдых на природе – дело хорошее… для лентяев.</p>
                    <button class="btn-detail">Подробнее</button>
                </div>
            </div>

        </div>

        <div class="nav-arrow left" id="prev">←</div>
        <div class="nav-arrow right" id="next">→</div>
        <div class="timeline-progress">
            <div class="progress-fill" id="progressFill"></div>
        </div>
    </div>
</section>


<!-- Модальное окно -->
<div id="castings-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.8); z-index:1000; overflow:auto;">
    <div style="background:white; margin:6% auto; padding:0; border-radius:12px; width:90%; max-width:760px; max-height:88vh; overflow-y:auto; position:relative; box-shadow:0 10px 40px rgba(0,0,0,0.5);">
        <span class="close" style="position:absolute; right:20px; top:10px; font-size:42px; color:#d4af37; cursor:pointer;">×</span>
        <div style="padding:30px 40px; text-align:center;">
            <h2 id="modalTitle" style="margin:0 0 10px; color:#222;"></h2>
            <div id="modalDate" style="color:#d4af37; font-size:1.2em; margin-bottom:20px;"></div>
            
            <!-- Важно: src пустой изначально + id для управления -->
            <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius:8px;">
                <iframe 
                    id="modalVideo" 
                    style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none;"
                    frameborder="0" 
                    allowfullscreen 
                    allow="clipboard-write; autoplay; encrypted-media; picture-in-picture">
                </iframe>
            </div>

            <div id="modalDesc" style="margin-top:25px; line-height:1.7; color:#444; font-size:1.05em; text-align:left;"></div>
        </div>
    </div>
</div>

<script>
    // Появление элементов при скролле
    const items = document.querySelectorAll('.timeline-item');
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('visible');
            }
        });
    }, { threshold: 0.2 });
    items.forEach(item => observer.observe(item));

    // Навигация + прогресс
    const wrapper = document.getElementById('timelineWrapper');
    const prev = document.getElementById('prev');
    const next = document.getElementById('next');
    const progressFill = document.getElementById('progressFill');
    let scrollPos = 0;
    const itemWidth = 360 + 60; // ширина карточки + margin
    const maxScroll = (items.length - 1) * itemWidth;

    function updateProgress() {
        if (!progressFill) return;
        const percent = Math.min(100, (scrollPos / maxScroll) * 100);
        progressFill.style.width = `${percent}%`;
    }

    next?.addEventListener('click', () => {
        scrollPos = Math.min(maxScroll, scrollPos + itemWidth);
        wrapper.style.transform = `translateX(-${scrollPos}px)`;
        updateProgress();
        setTimeout(highlightNearestCard, 650);
    });

    prev?.addEventListener('click', () => {
        scrollPos = Math.max(0, scrollPos - itemWidth);
        wrapper.style.transform = `translateX(-${scrollPos}px)`;
        updateProgress();
        setTimeout(highlightNearestCard, 650);
    });

    updateProgress();

    // Центрирование карточки по клику
    items.forEach((item, index) => {
        item.addEventListener('click', (e) => {
            if (e.target.closest('.btn-detail')) return;
            const container = document.querySelector('.timeline-container');
            const containerWidth = container.offsetWidth;
            const targetScroll = index * itemWidth - (containerWidth / 2 - itemWidth / 2) + 30;
            scrollPos = Math.max(0, Math.min(maxScroll, targetScroll));
            wrapper.style.transform = `translateX(-${scrollPos}px)`;
            updateProgress();
            setTimeout(highlightNearestCard, 650);
        });
    });

    // Подсветка ближайшей карточки
    function highlightNearestCard() {
        if (!wrapper) return;
        const container = document.querySelector('.timeline-container');
        const containerRect = container.getBoundingClientRect();
        const centerX = containerRect.left + containerRect.width / 2;
        let closest = null;
        let minDist = Infinity;
        items.forEach(item => {
            const rect = item.getBoundingClientRect();
            const itemCenter = rect.left + rect.width / 2;
            const dist = Math.abs(itemCenter - centerX);
            if (dist < minDist) {
                minDist = dist;
                closest = item;
            }
        });
        items.forEach(i => i.classList.remove('nearest'));
        if (closest) closest.classList.add('nearest');
    }

    window.addEventListener('resize', highlightNearestCard);
    ['click', 'scroll'].forEach(ev => window.addEventListener(ev, highlightNearestCard));
    next?.addEventListener('click', () => setTimeout(highlightNearestCard, 650));
    prev?.addEventListener('click', () => setTimeout(highlightNearestCard, 650));
    highlightNearestCard();
</script>