<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('timelineContainer');
    const items = document.querySelectorAll('.timeline-item');
    const swipePrompt = document.getElementById('swipePrompt');

    // Показываем подсказку только на мобильных
    if (window.innerWidth <= 900 && swipePrompt) {
        // Скрываем после первого скролла или касания
        const hidePrompt = () => {
            if (swipePrompt) {
                swipePrompt.classList.add('hidden');
            }
        };

        let hasScrolled = false;
        // События, после которых скрываем
        ['scroll', 'touchstart'].forEach(eventName => {
            container.addEventListener(eventName, () => {
                if (!hasScrolled) {
                    hasScrolled = true;
                    hidePrompt();
                }
            }, { once: true, passive: true });
        });        
    }

    // ─────────────── остальной код без изменений ───────────────

    function highlightNearest() {
        if (!container) return;
        const center = container.getBoundingClientRect().left + container.offsetWidth / 2;
        let minDist = Infinity;
        let closest = null;

        items.forEach(item => {
            const rect = item.getBoundingClientRect();
            const dist = Math.abs(rect.left + rect.width / 2 - center);
            if (dist < minDist) {
                minDist = dist;
                closest = item;
            }
        });

        items.forEach(it => it.classList.remove('nearest'));
        if (closest) closest.classList.add('nearest');
    }

    container.addEventListener('scroll', highlightNearest);

    items.forEach(item => {
        item.addEventListener('click', e => {
            if (e.target.closest('.btn-detail')) return;
            if (window.innerWidth <= 900) return;
            const target = item.offsetLeft - (container.clientWidth / 2) + (item.offsetWidth / 2);
            container.scrollTo({ left: target, behavior: 'smooth' });
        });
    });

    const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
            if (entry.isIntersecting) entry.target.classList.add('visible');
        });
    }, { threshold: 0.2 });

    items.forEach(item => observer.observe(item));

    setTimeout(() => {
        highlightNearest();
    }, 300);

    // Модальное окно
    const modal = document.getElementById('castings-modal');
    const modalTitle = document.getElementById('modalTitle');
    const modalDate = document.getElementById('modalDate');
    const modalDesc = document.getElementById('modalDesc');
    const video = document.getElementById('modalVideo');
    const videoSource = document.getElementById('modalVideoSource');
    const closeBtn = document.querySelector('#castings-modal .close');

    document.querySelectorAll('.btn-detail').forEach(btn => {
        btn.addEventListener('click', e => {
            e.stopPropagation();
            const card = btn.closest('.timeline-item');

            modalTitle.textContent = card.dataset.name;
            modalDate.textContent = card.dataset.date;
            modalDesc.textContent = card.dataset.description;

            videoSource.src = card.dataset.video;
            video.load();
            video.play().catch(() => {});

            modal.style.display = 'flex';
            document.body.style.overflow = 'hidden';
        });
    });

    function closeModal() {
        modal.style.display = 'none';
        document.body.style.overflow = '';
        video.pause();
        video.currentTime = 0;
    }

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
});
</script>