<style>
    body {
        font-family: 'Arial', sans-serif;
        background: #fafbd6;
        color: #222;
        margin: 0;
        padding: 0;
    }
    .castings-section {
        max-width: 1400px;
        margin: 60px auto;
        padding: 0 20px;
        text-align: center;
    }
    .castings-section h1 {
        font-size: 2.8em;
        margin-bottom: 50px;
        color: #222;
        text-transform: uppercase;
        letter-spacing: 3px;
        position: relative;
    }
    .castings-section h1::after {
        content: '';
        width: 140px;
        height: 3px;
        background: #d4af37;
        position: absolute;
        bottom: -15px;
        left: 50%;
        transform: translateX(-50%);
    }
    .timeline-container {
        position: relative;
        overflow: hidden;
        padding: 140px 0 100px;
        -webkit-overflow-scrolling: touch;   
        scrollbar-width: none;                
        -ms-overflow-style: none;    
        touch-action: auto;         
    }
    .timeline-wrapper {
        display: flex;
        transition: transform 0.6s ease-out;
        width: max-content;
        position: relative;
        will-change: transform;
        touch-action: auto;
    }
    .timeline-line {
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        height: 5px;
        background: linear-gradient(to right, #d4af37, #b8972e, #d4af37);
        box-shadow: 0 1px 6px rgba(212,175,55,0.3);
        transform: translateY(-50%);
        z-index: 0;
    }
    .timeline-item {
        position: relative;
        width: 360px;
        min-width: 360px;
        margin: 0 30px;
        text-align: center;
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.8s ease, transform 0.8s ease, box-shadow 0.4s ease;
        z-index: 2;
    }
    .timeline-item.visible {
        opacity: 1;
        transform: translateY(0);
    }
    .timeline-item:nth-child(odd) { margin-top: -140px; }
    .timeline-item:nth-child(even) { margin-top: 100px; }
    .timeline-date {
        font-size: 1.1em;
        font-weight: bold;
        color: #d4af37;
        margin-bottom: 12px;
        background: rgba(0,0,0,0.7);
        color: white;
        padding: 6px 14px;
        border-radius: 20px;
        display: inline-block;
    }
    .timeline-content {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.12);
        transition: all 0.4s ease;
        cursor: pointer;
    }
    .timeline-content:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 28px rgba(0,0,0,0.18);
        border: 1px solid #d4af37;
    }
    .timeline-thumbnail {
        width: 100%;
        height: 180px;
        object-fit: cover;
        border-radius: 8px;
        margin-bottom: 14px;
    }
    .timeline-title {
        font-size: 1.45em;
        margin: 0 0 10px;
        color: #222;
    }
    .timeline-teaser {
        font-size: 0.97em;
        color: #555;
        line-height: 1.45;
        margin: 0 0 16px;
    }
    .btn-detail {
        background: #d4af37;
        color: #1a1a1a;
        border: none;
        padding: 10px 20px;
        border-radius: 25px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }
    .btn-detail:hover {
        background: #b8972e;
        transform: scale(1.05);
    }
    .timeline-year {
        font-family: 'Playfair Display', serif;
        position: absolute;
        right: -160px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 3.2em;
        font-weight: bold;
        color: #2a2500;
        opacity: 0.75;
        letter-spacing: 4px;
        white-space: nowrap;
        pointer-events: none;
        z-index: 3;
        text-shadow: 0 2px 6px rgba(0,0,0,0.5);
    }
    .nav-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(0,0,0,0.5);
        color: white;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8em;
        cursor: pointer;
        z-index: 10;
        transition: all 0.3s;
    }
    .nav-arrow:hover {
        background: rgba(0,0,0,0.8);
        transform: translateY(-50%) scale(1.1);
    }
    .nav-arrow.left { left: 10px; }
    .nav-arrow.right { right: 10px; }
    .timeline-progress {
        position: absolute;
        bottom: 15px;
        left: 50%;
        transform: translateX(-50%);
        width: 70%;
        height: 3px;
        background: rgba(212,175,55,0.2);
        border-radius: 2px;
        overflow: hidden;
    }
    .progress-fill {
        height: 100%;
        width: 0%;
        background: #d4af37;
        transition: width 0.4s ease;
    }
    .timeline-item.nearest .timeline-content {
        border: 1px solid #d4af37;
    }
    /* ... все предыдущие стили остаются до медиа-запросов ... */

    /* Десктоп / планшет */
    @media (max-width: 900px) {
        .timeline-item {
            width: 300px;
            min-width: 300px;
            margin: 0 18px;
        }
        .timeline-item:nth-child(odd)  { margin-top: -110px; }
        .timeline-item:nth-child(even) { margin-top:  90px; }
        .timeline-thumbnail {
            height: 160px;
        }
        .timeline-title {
            font-size: 1.35em;
        }
        .timeline-teaser {
            font-size: 0.94em;
        }
    }

    /* Мобильные — карточки меньше + удобнее для пальца */
    @media (max-width: 600px) {
        .timeline-container {
            padding: 100px 0 70px;
            overflow-x: auto;                    /* разрешаем горизонтальный скролл */
            -webkit-overflow-scrolling: touch;   /* плавный скролл на iOS */
            scroll-snap-type: x mandatory;       /* опционально — магнит к карточке */
        }

        .timeline-wrapper {
            padding: 0 20px;                     /* отступы по бокам, чтобы первая/последняя карточка не прижималась к краю */
        }

        .timeline-item {
            width: 280px;
            min-width: 280px;
            margin: 0 12px;                      /* уменьшаем расстояние между карточками */
        }

        .timeline-item:nth-child(odd)  { margin-top: -80px; }
        .timeline-item:nth-child(even) { margin-top:  70px; }

        .timeline-thumbnail {
            height: 140px;                       /* фото поменьше */
        }

        .timeline-title {
            font-size: 1.28em;
            margin-bottom: 8px;
        }

        .timeline-teaser {
            font-size: 0.92em;
            line-height: 1.4;
        }

        .timeline-date {
            font-size: 1em;
            padding: 5px 12px;
        }

        .btn-detail {
            padding: 9px 18px;
            font-size: 0.95em;
        }

        /* убираем боковые стрелки — они не нужны при свайпе */
        .nav-arrow {
            display: none !important;
        }

        /* центрируем прогресс-бар и делаем его шире */
        .timeline-progress {
            width: 85%;
        }

        /* год — компактнее */
        .timeline-year {
            font-size: 1.9em;
            left: 16px;
            top: -50px;
        }
    }

    /* Очень маленькие экраны */
    @media (max-width: 400px) {
        .timeline-item {
            width: 260px;
            min-width: 260px;
            margin: 0 10px;
        }
        .timeline-thumbnail {
            height: 130px;
        }
    }
  </style>

<section class="castings-section">
