---

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css" />

<div id="projects" class="hero-slider swiper">
  <div class="swiper-wrapper">
    {
      slides.map((slide) => (
        <div class="swiper-slide">
          <img src={slide.img} alt={slide.title} loading="lazy" />
          <div class="slide-content">
            {slide.soon && (
              <div class="soon-badge mobile-only">Скоро...</div>
            )}
            <div class="info-block">
              <h2>{slide.title}</h2>
              {slide.quote && <p class="quote">{slide.quote}</p>}
            </div>
            <p class="description desktop-only">{slide.text}</p>

            <div class="buttons-row">
              <button
                type="button"
                class="more-btn mobile-only"
                data-title={slide.title}
                data-text={slide.text}
                data-quote={slide.quote || ''}
                data-images={JSON.stringify(slide.images || [slide.img])}
              >
                Подробнее
              </button>
              
              {slide.soon ? (
                <button
                  type="button"
                  class="tickets-btn waitlist-btn"
                  onclick="openWaitlistModal()"
                >
                  Заявка
                </button>
              ) : slide.eventId ? (
                <button
                  type="button"
                  class="tickets-btn buy-btn"
                  onclick={`openTicketModal(${slide.eventId}, '${slide.eventName.replace(/'/g, "\\'")}')`}
                >
                  Купить билет
                </button>
              ) : (
                <button
                  type="button"
                  class="tickets-btn"
                  onclick="openWaitlistModal()"
                >
                  Заявка
                </button>
              )}
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <div class="custom-nav">
    <button class="custom-btn prev" aria-label="Предыдущий слайд">❮</button>
    <button class="custom-btn next" aria-label="Следующий слайд">❯</button>
  </div>
</div>

<!-- Модальное окно для подробностей с каруселью -->
<!-- Модальное окно для подробностей с каруселью внизу -->
<div id="project-modal" class="modal">
  <div class="modal-content">
    <span class="close-modal">×</span>
    
    <h3 id="modal-title"></h3>
    <p id="modal-text"></p>
    <p id="modal-quote" class="quote"></p>
    
    <!-- Карусель изображений внизу модалки -->
    <div class="modal-slider swiper">
      <div class="swiper-wrapper" id="modal-images-wrapper">
        <!-- Сюда будут добавляться слайды -->
      </div>
      <div class="modal-slider-nav">
        <button class="modal-slider-btn prev-modal">❮</button>
        <button class="modal-slider-btn next-modal">❯</button>
      </div>
      <div class="swiper-pagination modal-pagination"></div>
    </div>
  </div>
</div>

<!-- Модальное окно для билетов CBiletom -->
<div id="ticket-modal" class="modal ticket-modal">
  <div class="modal-content ticket-modal-content">
    <span class="close-modal close-ticket-modal">×</span>
    <h3 id="ticket-modal-title">Выбор билетов</h3>
    <iframe id="ticket-iframe" src="" style="width: 100%; height: 500px; border: none; border-radius: 8px;"></iframe>
  </div>
</div>

<script defer src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"></script>

<!-- CBiletom widget script и глобальные функции -->
<script>
// Глобальные функции для работы с билетами (ДО загрузки DOM)
window.openTicketModal = function(eventId, eventName) {
  if (!eventId) {
    window.openWaitlistModal();
    return;
  }
  
  const modal = document.getElementById('ticket-modal');
  const iframe = document.getElementById('ticket-iframe');
  const titleEl = document.getElementById('ticket-modal-title');
  
  if (modal && iframe) {
    iframe.src = `https://cbiletom.ru/widget/1/frame.php?id=${eventId}`;
    titleEl.textContent = `Билеты: ${eventName}`;
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  } else {
    console.error('Модалка билетов не найдена');
    // fallback - открываем в новой вкладке
    window.open(`https://cbiletom.ru/widget/1/frame.php?id=${eventId}`, '_blank');
  }
};

window.closeTicketModal = function() {
  const modal = document.getElementById('ticket-modal');
  const iframe = document.getElementById('ticket-iframe');
  if (modal) {
    modal.style.display = 'none';
    if (iframe) iframe.src = '';
    document.body.style.overflow = '';
  }
};

window.openWaitlistModal = function() {
  // Здесь можно сделать красивую модалку, пока просто alert
  alert('Скоро билеты появятся! Оставьте заявку, и мы сообщим.');
  // Если есть форма заявки - раскомментировать:
  // document.getElementById('waitlist-modal').style.display = 'flex';
};

// Подключаем CBiletom
(function(d){
  if (typeof d.CB == 'object') return;
  var s = d.createElement('script');
  s.type = 'text/javascript'; 
  s.id = 'cb-controller';
  s.async = 1;
  s.src = 'https://cbiletom.ru/widget/1/assets/controller.js?itok=' + Math.round(1* new Date() / 3600000);
  s.onload = function() {
    if (typeof CB !== 'undefined') {
      new CB(d, {id:13893, view:2});
    }
  };
  d.querySelector('head').append(s);
})(document);
</script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof Swiper === 'undefined') return console.error('Swiper не загрузился');
    
    // Главный слайдер
    const swiper = new Swiper('#projects', {
      loop: true,
      speed: 2000,
      grabCursor: true,
      autoplay: { delay: 5000, disableOnInteraction: false },
      effect: 'fade',
      fadeEffect: { crossFade: true },
      lazy: true
    });

    document.querySelector('#projects .custom-btn.prev')?.addEventListener('click', () => swiper.slidePrev());
    document.querySelector('#projects .custom-btn.next')?.addEventListener('click', () => swiper.slideNext());

    // Модалка подробностей с каруселью внизу
    const modal = document.getElementById('project-modal');
    const titleEl = document.getElementById('modal-title');
    const textEl = document.getElementById('modal-text');
    const quoteEl = document.getElementById('modal-quote');
    const closeBtn = document.querySelector('#project-modal .close-modal');
    const imagesWrapper = document.getElementById('modal-images-wrapper');
    
    let modalSwiper = null;

    // Функция инициализации слайдера в модалке
    function initModalSwiper() {
      if (modalSwiper) {
        modalSwiper.destroy(true, true);
        modalSwiper = null;
      }
      
      const slides = imagesWrapper.querySelectorAll('.swiper-slide');
      if (slides.length > 0) {
        modalSwiper = new Swiper('.modal-slider', {
          loop: slides.length > 1,
          navigation: {
            nextEl: '.next-modal',
            prevEl: '.prev-modal',
          },
          pagination: {
            el: '.modal-pagination',
            clickable: true,
          },
          speed: 600,
          grabCursor: true,
        });
        
        // Показываем навигацию, если больше 1 слайда
        if (slides.length > 1) {
          document.querySelector('.modal-slider-nav').style.display = 'flex';
          document.querySelector('.modal-pagination').style.display = 'block';
        } else {
          document.querySelector('.modal-slider-nav').style.display = 'none';
          document.querySelector('.modal-pagination').style.display = 'none';
        }
      }
    }

    // Обработчик кнопки "Подробнее"
    document.querySelectorAll('.more-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const title = btn.dataset.title;
        const text = btn.dataset.text;
        const quote = btn.dataset.quote || '';
        let images = [];
        
        try {
          images = JSON.parse(btn.dataset.images);
          if (!Array.isArray(images)) images = [images];
        } catch(e) {
          images = [btn.dataset.images || '/images/projects/default.jpg'];
        }
        
        // Заполняем заголовки
        titleEl.textContent = title;
        textEl.textContent = text;
        quoteEl.textContent = quote;
        quoteEl.style.display = quote ? 'block' : 'none';
        
        // Очищаем и заполняем слайды изображений
        imagesWrapper.innerHTML = '';
        images.forEach((imgSrc, index) => {
          const slide = document.createElement('div');
          slide.className = 'swiper-slide';
          slide.innerHTML = `<img src="${imgSrc}" alt="${title} - фото ${index + 1}" loading="lazy" />`;
          imagesWrapper.appendChild(slide);
        });
        
        // Показываем модалку
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        
        // Инициализируем слайдер после рендера
        setTimeout(() => initModalSwiper(), 100);
      });
    });

    // Закрытие модалки
    closeBtn.addEventListener('click', () => {
      modal.style.display = 'none';
      document.body.style.overflow = '';
      if (modalSwiper) {
        modalSwiper.destroy(true, true);
        modalSwiper = null;
      }
    });
    
    modal.addEventListener('click', e => { 
      if (e.target === modal) {
        modal.style.display = 'none';
        document.body.style.overflow = '';
        if (modalSwiper) {
          modalSwiper.destroy(true, true);
          modalSwiper = null;
        }
      }
    });
    
    // Закрытие по Escape для обеих модалок
    document.addEventListener('keydown', e => { 
      if (e.key === 'Escape') {
        if (modal.style.display === 'flex') {
          modal.style.display = 'none';
          document.body.style.overflow = '';
          if (modalSwiper) {
            modalSwiper.destroy(true, true);
            modalSwiper = null;
          }
        }
        if (document.getElementById('ticket-modal').style.display === 'flex') {
          window.closeTicketModal();
        }
      }
    });

    // Модалка билетов — закрытие
    const ticketModal = document.getElementById('ticket-modal');
    const closeTicketBtn = document.querySelector('.close-ticket-modal');
    
    if (closeTicketBtn) {
      closeTicketBtn.addEventListener('click', window.closeTicketModal);
    }
    if (ticketModal) {
      ticketModal.addEventListener('click', e => {
        if (e.target === ticketModal) window.closeTicketModal();
      });
    }
  });
</script>

<style>
  .hero-slider {
