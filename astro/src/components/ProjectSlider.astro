---
// src/components/ProjectsSlider.astro
import 'swiper/css';
import 'swiper/css/effect-fade';
import 'swiper/css/navigation';
import 'swiper/css/pagination';

const projects = [
  {
    title: "Скрипичное Шоу",
    description: "Виртуозное сочетание классической музыки и захватывающей драматургии. Шоу, которое оставляет мурашки по коже и заставляет забыть о времени.",
    image: "/dist/images/projects/skripka-show.jpg",
    date: "15 марта 2026, 19:00",
    ticketLink: "https://example.com/tickets/skripka"
  },
  {
    title: "Родной Мой Кукушонок",
    description: "Трогательная семейная история о любви, потере и прощении. Спектакль, который заставляет плакать и улыбаться одновременно.",
    image: "/dist/images/projects/kukushonok.jpg",
    date: "22 марта 2026, 18:00",
    ticketLink: "https://example.com/tickets/kukushonok"
  },
  {
    title: "Мамочка, Купи Собаку",
    description: "Лёгкая и искромётная комедия о детских мечтах и родительских «нет». Идеально для семейного похода в театр.",
    image: "/dist/images/projects/mamochka-sobaka.jpg",
    date: "5 апреля 2026, 16:00",
    ticketLink: "https://example.com/tickets/sobaka"
  },
  {
    title: "Неделя Испании",
    description: "Яркое фламенко, страсть, гитары и испанский огонь. Погружение в культуру Испании без перелёта.",
    image: "/dist/images/projects/flamenko.jpg",
    date: "12 апреля 2026, 20:00",
    ticketLink: "https://example.com/tickets/flamenko"
  }
];
---

<div class="swiper projects-swiper h-screen w-full relative overflow-hidden">
  <div class="swiper-wrapper">
    {
      projects.map(project => (
        <div class="swiper-slide relative">
          <img
            src={project.image}
            alt={project.title}
            class="absolute inset-0 w-full h-full object-cover brightness-90 transition-transform duration-[1500ms] ease-out"
            loading="lazy"
          />

          <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/35 to-transparent pointer-events-none z-10" />

          <div class="absolute inset-0 z-20 flex flex-col justify-end pb-16 md:pb-24 px-6 md:px-12 lg:px-20 text-white">
            <div class="max-w-4xl w-full">
              <h2 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold leading-tight mb-4 md:mb-6 drop-shadow-lg">
                {project.title}
              </h2>

              <p class="text-base sm:text-lg md:text-xl lg:text-2xl mb-6 md:mb-10 max-w-3xl drop-shadow-md opacity-95">
                {project.description}
              </p>

              <div class="flex flex-col sm:flex-row sm:items-center gap-6 md:gap-10 mb-4">
                <div class="text-xl md:text-2xl font-medium drop-shadow-md">
                  {project.date}
                </div>

                <a
                  href={project.ticketLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center px-8 py-4 md:px-10 md:py-5 text-lg md:text-xl font-bold bg-gold text-black rounded-full hover:bg-yellow-400 transition-all shadow-xl hover:shadow-gold/40 hover:-translate-y-1 drop-shadow-lg"
                >
                  Купить билет →
                </a>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <div class="swiper-button-prev !text-white !text-5xl md:!text-6xl !opacity-70 hover:!opacity-100 transition-opacity !left-4 md:!left-12 z-30"></div>
  <div class="swiper-button-next !text-white !text-5xl md:!text-6xl !opacity-70 hover:!opacity-100 transition-opacity !right-4 md:!right-12 z-30"></div>

  <div class="swiper-pagination !bottom-8 z-30"></div>
</div>

<script type="module">
  import Swiper from 'swiper';
  import { EffectFade, Navigation, Pagination, Autoplay } from 'swiper/modules';

  // Запускаем сразу после загрузки DOM (astro:page-load не обязателен, но полезен)
  document.addEventListener('astro:page-load', () => {
    const swiperEl = document.querySelector('.projects-swiper');
    if (swiperEl) {
      new Swiper(swiperEl, {
        modules: [EffectFade, Navigation, Pagination, Autoplay],
        effect: 'fade',
        fadeEffect: { crossFade: true },
        speed: 1200,
        autoplay: { delay: 6500, disableOnInteraction: false },
        loop: true,
        navigation: {
          nextEl: '.swiper-button-next',
          prevEl: '.swiper-button-prev',
        },
        pagination: {
          el: '.swiper-pagination',
          clickable: true,
          bulletClass: 'swiper-pagination-bullet !bg-white/60 !w-3 !h-3 !rounded-full',
          bulletActiveClass: '!bg-gold !w-8 !opacity-100',
        },
        on: {
          slideChangeTransitionStart: (swiper) => {
            swiper.slides.forEach(slide => {
              const img = slide.querySelector('img');
              if (img) img.style.transform = 'scale(1.08)';
            });
          },
          slideChangeTransitionEnd: (swiper) => {
            const active = swiper.slides[swiper.activeIndex];
            const img = active?.querySelector('img');
            if (img) img.style.transform = 'scale(1.12)';
          },
        },
      });
    }
  });
</script>

<style is:global>
  .projects-swiper .swiper-slide-active img {
    transition: transform 15s ease-out !important;
    transform: scale(1.12) !important;
  }

  h2, p, .text-xl, .font-medium {
    text-shadow: 0 2px 8px rgba(0,0,0,0.7);
  }
</style>