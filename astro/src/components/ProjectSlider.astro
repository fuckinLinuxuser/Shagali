    aspect-ratio: 16 / 9;
    max-height: 90vh;
    margin: 0 auto;
    overflow: hidden;
    position: relative;
    background: #000;
  }

  .swiper-slide { position: relative; width: 100%; height: 100%; }
  .swiper-slide img { width: 100%; height: 100%; object-fit: cover; }

  .slide-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 5rem 2rem 5.5rem 2rem;
    color: white;
    background: linear-gradient(to top right, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.4) 40%, transparent 70%);
  }

  .info-block { margin-bottom: 2rem; }

  h2 {
