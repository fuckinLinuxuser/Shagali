  .more-btn {
    background: rgba(255,255,255,0.2);
    color: white;
    border: 1px solid rgba(255,255,255,0.5);
  }

  .more-btn:hover,
  .tickets-btn:hover {
    transform: translateY(-4px) scale(1.04);
    box-shadow: 0 12px 32px rgba(0,0,0,0.55);
  }

  .tickets-btn:hover { background: #e6c24a; }

  .soon-badge {
    position: absolute;
    top: 5%;
