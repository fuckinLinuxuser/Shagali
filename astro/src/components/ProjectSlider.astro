---
const slides = [
  {
    img: "/images/projects/kukushonok.jpeg",
    title: "Родной мой Кукушонок",
    text: "Драму проживает каждый Ребенок, разочаровавший своих родителей. Трагедию носит в себе каждая Мать, оттолкнувшая своего ребенка. Просто разные. Еще пару лет назад была семья, где все друг друга любили. А сегодня – уже чужие взрослые люди. Как вернуться к самим себе? Как опять увидеть друг друга?",
    quote: "\"...Спектакль о том, как взрослеют родители...\"",
    soon: true
  },
  {
    img: "/images/projects/doggy.jpeg",
    title: "Мамочка, купи собачку!",
    text: "Милая пушистая игрушка, в которой отражается всё счастье твоего детства. Смешной товарищ по играм и соучастник мелких шалостей. И крупных семейных разборок заодно! Когда у Ребёнка из друзей только цифровая колонка, то собака становится заветной мечтой…  А родители видят в собаке источник дополнительных проблем. Однажды собака может надоесть. Впрочем, не только родителям… ",
    quote: "Сказка про то, как собака учит быть взрослыми. Причем учит не только детей. ",
    soon: true
  }
];
---

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css" />

<div id="projects" class="hero-slider swiper">
  <div class="swiper-wrapper">
    {
      slides.map((slide) => (
        <div class="swiper-slide">
          <img src={slide.img} alt={slide.title} loading="lazy" />

          <div class="slide-content">
            {slide.soon && (
              <div class="soon-badge">Скоро...</div>
            )}

            <h2>{slide.title}</h2>
            <p>{slide.text}</p>

            {slide.quote && (
              <>
                <br />
                <p><i>{slide.quote}</i></p>
              </>
            )}
          </div>
        </div>
      ))
    }
  </div>

  <div class="custom-nav">
    <button class="custom-btn prev" aria-label="Предыдущий слайд">❮</button>
    <button class="custom-btn next" aria-label="Следующий слайд">❯</button>
  </div>
</div>

<script defer src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"></script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof Swiper === 'undefined') {
      console.error('Swiper НЕ загрузился!');
      return;
    }

    const swiper = new Swiper('#projects', {
      loop: true,
      speed: 2500,
      grabCursor: true,
      autoplay: {
        delay: 5000,
        disableOnInteraction: false,
      },
      effect: 'fade',
      fadeEffect: { crossFade: true },
      lazy: true
    });

    const prev = document.querySelector('#projects .custom-btn.prev');
    const next = document.querySelector('#projects .custom-btn.next');

    if (prev) prev.addEventListener('click', () => swiper.slidePrev());
    if (next) next.addEventListener('click', () => swiper.slideNext());
  });
</script>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .hero-slider {
    width: 100%;
    aspect-ratio: 16 / 9;                    /* десктоп — широкий */
    max-height: 90vh;
    margin: 0 auto;
    overflow: hidden;
    position: relative;
    background: #000;
  }

  .swiper-slide {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .swiper-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slide-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    text-align: left;
    padding: 5rem 2rem 3.5rem 2rem;
    color: white;
    background: linear-gradient(
      to top right,
      rgba(0,0,0,0.7) 0%,
      rgba(0,0,0,0.4) 40%,
      transparent 70%
    );
  }

  .slide-content h2 {
    font-family: 'Playfair Display', serif;
  }

  .slide-content p {
    font-family: 'Times New Roman', serif;
  }

  .slide-content blockquote {
    font-family: 'Times New Roman', serif;
    font-style: italic;
  }

  /* ────────────────────────────────────────────── */
  /*        НАДПИСЬ "скоро..."                     */
  /* ────────────────────────────────────────────── */
  .soon-badge {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    font-family: 'Playfair Display', serif;
    background: #c22431;
    opacity: 0.85;
    color: white;
    font-size: clamp(1.9rem, 2.2vw, 1.15rem);
    font-weight: 700;
    padding: 0.4rem 1rem;
    border-radius: 10px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.4);
    letter-spacing: 0.6px;
    line-height: 1.3;
    white-space: nowrap;
    z-index: 5;
  }

  /* ────────────────────────────────────────────── */
  /* Десктопные размеры текста                     */
  /* ────────────────────────────────────────────── */
  .slide-content h2 {
    font-size: clamp(1.5rem, 3vw, 3rem);
    margin-bottom: 0.8rem;
    text-shadow: 0 3px 12px rgba(0,0,0,0.9);
  }

  .slide-content p {
    opacity: 0.65;
    font-size: clamp(0.6rem, 2.5vw, 1.6rem);
    max-width: 1340px;
    text-shadow: 0 2px 8px rgba(0,0,0,0.8);
  }

  .custom-nav {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 1.5rem;
  }

  .custom-btn {
    pointer-events: auto;
    width: 60px;
    height: 60px;
    background: rgba(0,0,0,0.5);
    color: white;
    border: none;
    border-radius: 50%;
    font-size: 1.8rem;
    cursor: pointer;
    transition: all 0.25s ease;
    backdrop-filter: blur(4px);
  }

  .custom-btn:hover {
    background: rgba(255,255,255,0.25);
    transform: scale(1.12);
  }

  .custom-btn.prev::before { content: ""; }
  .custom-btn.next::before { content: ""; }

  
  @media (max-width: 768px) {
    .hero-slider {
      aspect-ratio: 4 / 5;                   /* основной вариант — вертикальнее */
      /* Альтернатива: aspect-ratio: 4 / 5; — ещё толще */
      /* Альтернатива: aspect-ratio: 9 / 16; — почти полноэкранный Stories/Reels стиль */
      max-height: 85vh;                      /* не даём растягиваться слишком сильно */
      min-height: 500px;                     /* минимальная высота, чтобы не было слишком коротко */
    }

    .slide-content {
      padding: 4rem 1.6rem 4rem 1.6rem;      /* больше воздуха снизу и сверху */
      justify-content: center;               /* можно поэкспериментировать с center вместо flex-end */
      background: linear-gradient(
        to bottom,
        rgba(0,0,0,0.65) 0%,
        rgba(0,0,0,0.45) 30%,
        rgba(0,0,0,0.25) 60%,
        transparent 85%
      );                                     /* градиент сверху вниз — текст лучше читается */
    }

    .soon-badge {
      top: 1rem;
      right: 1rem;
      font-size: clamp(1.1rem, 4.2vw, 1.6rem);
      padding: 0.35rem 0.9rem;
    }

    .slide-content h2 {
      font-size: clamp(2rem, 6.5vw, 3.2rem); /* крупнее заголовок */
      margin-bottom: 1.2rem;
    }

    .slide-content p {
      font-size: clamp(1.05rem, 4.2vw, 1.5rem);
      opacity: 0.9;
      line-height: 1.45;
    }

    .custom-nav {
      padding: 0 12px;
    }

    .custom-btn {
      width: 52px;
      height: 52px;
      font-size: 1.5rem;
    }
  }

  /* Очень узкие экраны (старые телефоны) */
  @media (max-width: 480px) {
    .hero-slider {
      aspect-ratio: 4 / 5;                   /* или 4 / 5, если 3/4 кажется недостаточно толстым */
    }

    .slide-content {
      padding: 3.5rem 1.4rem 5rem 1.4rem;
    }
  }
</style>