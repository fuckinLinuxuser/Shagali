    line-height: 1.55;
  }

  .custom-nav {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 1.5rem;
  }

  .custom-btn {
    pointer-events: auto;
    width: 60px;
    height: 60px;
    background: rgba(0,0,0,0.5);
    color: white;
    border: none;
    border-radius: 50%;
    font-size: 1.8rem;
