<style>
  .blog-section {
    max-width: 1400px;
    margin: 80px auto;
    padding: 0 16px;
  }

  .blog-section h1 {
    font-size: clamp(1.9rem, 6.5vw, 2.8em);
    text-align: center;
    text-transform: uppercase;
    letter-spacing: clamp(1.5px, 0.4vw, 3px);
    margin-bottom: clamp(40px, 8vw, 60px);
    position: relative;
    color: #222;
  }

  .blog-section h1::after {
    content: '';
    width: 120px;
    height: 3px;
    background: #d4af37;
    position: absolute;
    bottom: -15px;
    left: 50%;
    transform: translateX(-50%);
  }

  .blog-grid {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 7vw, 60px);
  }

  .blog-card {
    background: white;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    transition: all 0.28s ease;
  }

  .blog-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.14);
  }

  .blog-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .blog-left {
    padding: 40px 48px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .blog-meta {
    display: flex;
    gap: 16px;
    margin-bottom: 16px;
    font-size: 0.92em;
    color: #666;
    flex-wrap: wrap;
  }

  .blog-meta time {
    font-weight: 500;
  }

  .blog-category {
    background: #f8e8b0;
    color: #5c4a00;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.88em;
  }

  .blog-left h2 {
    font-size: clamp(1.7rem, 5vw, 1.95em);
    margin: 0 0 18px;
    line-height: 1.3;
    color: #1a1a1a;
  }

  .blog-excerpt {
    font-size: clamp(0.97rem, 3.2vw, 1.03em);
    line-height: 1.65;
    color: #444;
    margin: 0 0 28px;
  }

  .btn-read {
    display: inline-block;
    background: #d4af37;
    color: #1a1a1a;
    padding: 12px 28px;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .btn-read:hover {
    background: #b8972e;
    transform: translateX(8px);
  }

  .blog-right {
    background: #111;
    position: relative;
  }

  .blog-image {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 */
    height: 0;
    overflow: hidden;
    background: #000;
  }

  .blog-image img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  /* ──────────────────────────────────────────────── */
  /* Адаптивность */

  @media (max-width: 980px) {
    .blog-content {
      grid-template-columns: 1fr;
    }

    .blog-left {
      padding: 32px 24px;
      order: 2;
    }

    .blog-right {
      order: 1;
      min-height: 240px;
    }

    .blog-left h2 {
      font-size: clamp(1.55rem, 5.8vw, 1.9rem);
      margin-bottom: 16px;
    }

    .blog-excerpt {
      margin-bottom: 24px;
    }

    .btn-read {
      padding: 10px 24px;
      font-size: 0.96em;
    }
  }

  @media (max-width: 560px) {
    .blog-section {
      margin: 50px auto 70px;
      padding: 0 14px;
    }

    .blog-section h1 {
      font-size: clamp(1.7rem, 7vw, 2.2rem);
      margin-bottom: 40px;
      letter-spacing: 1.5px;
    }

    .blog-grid {
      gap: 40px;
    }

    .blog-card {
      border-radius: 8px;
    }

    .blog-left {
      padding: 28px 20px 36px;
    }

    .blog-right {
      min-height: 200px;
    }

    .blog-meta {
      font-size: 0.88em;
      gap: 12px;
    }
  }

  @media (max-width: 380px) {
    .blog-left {
      padding: 24px 16px 32px;
    }

    .btn-read {
      width: 100%;
      text-align: center;
    }
  }
</style>