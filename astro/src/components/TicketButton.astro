---
// Кнопка «Билеты» в виде театрального билета: красный силуэт с выемками по углам и зубчиками по бокам,
// внутренняя рамка, отрывной корешок с масками. Сама ничего не грузит, только несёт данные для модалки
// (TicketModal.astro); адрес виджета собирается на клике — до клика на странице нет ни iframe, ни скриптов cbiletom.
interface Props {
  cbiletomId: number;
  title: string; // заголовок модалки: спектакль и город
  subtitle?: string; // дата, время, площадка
  class?: string;
}

const { cbiletomId, title, subtitle = '', class: className = 'ticket-btn' } = Astro.props;
const SHAPE = 'M7,0 L169,0 A7,7 0 0 0 176,7 L173.4,9.86 L176,12.71 L173.4,15.57 L176,18.43 L173.4,21.29 L176,24.14 L173.4,27.00 L176,29.86 L173.4,32.71 L176,35.57 L173.4,38.43 L176,41.29 L173.4,44.14 L176,47.00 A7,7 0 0 0 169,54 L7,54 A7,7 0 0 0 0,47 L2.6,44.14 L0,41.29 L2.6,38.43 L0,35.57 L2.6,32.71 L0,29.86 L2.6,27.00 L0,24.14 L2.6,21.29 L0,18.43 L2.6,15.57 L0,12.71 L2.6,9.86 L0,7.00 A7,7 0 0 0 7,0 Z';
---

<button
  type="button"
  class={className}
  data-ticket-id={cbiletomId}
  data-ticket-title={title}
  data-ticket-subtitle={subtitle}
>
  <svg class="ticket-btn__art" width="176" height="54" viewBox="0 0 176 54" aria-hidden="true" focusable="false">
    <path class="ticket-btn__shape" d={SHAPE}></path>
    <rect x="6.5" y="6.5" width="163" height="41" rx="4" fill="none" stroke="#fff" stroke-opacity=".92" stroke-width="1.5"></rect>
    <path d="M136 6.5V47.5" stroke="#fff" stroke-opacity=".92" stroke-width="1.5"></path>
    <!-- маски: грустная и весёлая -->
    <g transform="translate(142 14) rotate(-9 8 11)">
      <path d="M0 2C0 0 3 0 8 0S16 0 16 2V10C16 17 12.5 22 8 22S0 17 0 10Z" fill="#fff"></path>
      <ellipse cx="4.7" cy="8.4" rx="1.7" ry="1.1" class="ticket-btn__hole"></ellipse>
      <ellipse cx="11.3" cy="8.4" rx="1.7" ry="1.1" class="ticket-btn__hole"></ellipse>
      <path d="M4.4 17Q8 13.6 11.6 17" fill="none" class="ticket-btn__line"></path>
    </g>
    <g transform="translate(150 16) rotate(9 8 11)">
      <path d="M0 2C0 0 3 0 8 0S16 0 16 2V10C16 17 12.5 22 8 22S0 17 0 10Z" fill="#fff" stroke="#c1272f" stroke-width="1"></path>
      <ellipse cx="4.7" cy="8.4" rx="1.7" ry="1.1" class="ticket-btn__hole"></ellipse>
      <ellipse cx="11.3" cy="8.4" rx="1.7" ry="1.1" class="ticket-btn__hole"></ellipse>
      <path d="M4.4 13.4Q8 17.4 11.6 13.4" fill="none" class="ticket-btn__line"></path>
    </g>
  </svg>
  <span class="ticket-btn__label"><slot>Билеты</slot></span>
</button>
