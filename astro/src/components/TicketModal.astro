---
// Одна модалка покупки на весь сайт: открывается по клику на любую [data-ticket-id] (TicketButton).
// < 768px — на весь экран (100dvh). Страница под модалкой не прокручивается; после закрытия возвращаются
// позиция прокрутки и фокус на кнопку. Если виджет не ответил за 7 с — ссылка на страницу события cbiletom.
---

<div class="ticket" data-ticket-modal hidden>
  <div class="ticket__panel" role="dialog" aria-modal="true" aria-labelledby="ticket-title" data-ticket-panel>
    <header class="ticket__head">
      <div class="ticket__titles">
        <h2 class="ticket__title" id="ticket-title" data-ticket-title></h2>
        <p class="ticket__subtitle" data-ticket-subtitle></p>
      </div>
      <button type="button" class="ticket__close" data-ticket-close>Закрыть</button>
    </header>
    <div class="ticket__frame" data-ticket-frame></div>
    <p class="ticket__fallback" data-ticket-fallback hidden>
      Не загружается?
      <a href="https://cbiletom.ru/" target="_blank" rel="noopener" data-ticket-fallback-link>Открыть покупку на сайте cbiletom</a>
    </p>
  </div>
</div>

<script>
  import { FALLBACK_AFTER_MS, eventPageUrl, ticketFrameUrl } from '../lib/tickets';
  import { reachGoal } from '../lib/counters';

  const modal = document.querySelector<HTMLElement>('[data-ticket-modal]')!;
  const panel = modal.querySelector<HTMLElement>('[data-ticket-panel]')!;
  const titleEl = modal.querySelector<HTMLElement>('[data-ticket-title]')!;
  const subtitleEl = modal.querySelector<HTMLElement>('[data-ticket-subtitle]')!;
  const frameBox = modal.querySelector<HTMLElement>('[data-ticket-frame]')!;
  const closeBtn = modal.querySelector<HTMLButtonElement>('[data-ticket-close]')!;
  const fallback = modal.querySelector<HTMLElement>('[data-ticket-fallback]')!;
  const fallbackLink = modal.querySelector<HTMLAnchorElement>('[data-ticket-fallback-link]')!;

  let trigger: HTMLElement | null = null;
  let savedScroll = 0;
  let fallbackTimer: ReturnType<typeof setTimeout> | undefined;

  function lockScroll() {
    savedScroll = window.scrollY;
    const s = document.body.style;
    s.position = 'fixed';
    s.top = `-${savedScroll}px`;
    s.left = '0';
    s.right = '0';
    s.overflow = 'hidden';
  }

  function unlockScroll() {
    const s = document.body.style;
    s.position = s.top = s.left = s.right = s.overflow = '';
    window.scrollTo({ top: savedScroll, left: 0, behavior: 'instant' });
  }

  function open(button: HTMLElement) {
    const id = button.dataset.ticketId;
    let frameUrl: string;
    let eventUrl: string;
    try {
      frameUrl = ticketFrameUrl(id as string);
      eventUrl = eventPageUrl(id as string);
    } catch {
      return; // некорректный id — не открываем, адрес не собираем
    }

    trigger = button;
    reachGoal('buy_click');
    titleEl.textContent = button.dataset.ticketTitle || 'Билеты';
    subtitleEl.textContent = button.dataset.ticketSubtitle || '';
    subtitleEl.hidden = !subtitleEl.textContent;

    // iframe создаётся только сейчас, по клику
    const iframe = document.createElement('iframe');
    iframe.src = frameUrl;
    iframe.title = 'Покупка билетов';
    iframe.className = 'ticket__iframe';
    iframe.addEventListener('load', () => reachGoal('widget_loaded'));
    frameBox.replaceChildren(iframe);

    fallbackLink.href = eventUrl;
    fallback.hidden = true;
    fallbackTimer = setTimeout(() => (fallback.hidden = false), FALLBACK_AFTER_MS);

    lockScroll();
    modal.hidden = false;
    closeBtn.focus({ preventScroll: true });
  }

  function close() {
    if (modal.hidden) return;
    clearTimeout(fallbackTimer);
    frameBox.replaceChildren();
    fallback.hidden = true;
    modal.hidden = true;
    unlockScroll();
    trigger?.focus({ preventScroll: true });
    trigger = null;
  }

  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    const button = target?.closest<HTMLElement>('[data-ticket-id]');
    if (button) {
      e.preventDefault();
      open(button);
      return;
    }
    if (target === modal) close(); // клик по затемнению
  });

  closeBtn.addEventListener('click', close);

  document.addEventListener('keydown', (e) => {
    if (modal.hidden) return;
    if (e.key === 'Escape') {
      close();
      return;
    }
    if (e.key !== 'Tab') return;
    // Фокус не уходит из модалки: по кругу «Закрыть» → iframe → ссылка
    const items = [closeBtn, frameBox.querySelector<HTMLElement>('iframe'), fallback.hidden ? null : fallbackLink].filter(
      Boolean,
    ) as HTMLElement[];
    const i = items.indexOf(document.activeElement as HTMLElement);
    const last = items.length - 1;
    if (!e.shiftKey && (i === last || i === -1)) {
      e.preventDefault();
      items[0].focus();
    } else if (e.shiftKey && (i === 0 || i === -1)) {
      e.preventDefault();
      items[last].focus();
    }
  });
</script>

<style>
  .ticket {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.78);
  }
  .ticket[hidden] {
    display: none;
  }

  .ticket__panel {
    display: flex;
    flex-direction: column;
    width: min(960px, 94vw);
    height: min(780px, 92dvh);
    background: #fff;
    color: #1c0f0f;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 15px 50px rgba(0, 0, 0, 0.8);
  }

  .ticket__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.2rem;
    background: #121212;
    color: #fff;
  }
  .ticket__title {
    margin: 0;
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    line-height: 1.25;
  }
  .ticket__subtitle {
    margin: 0.2rem 0 0;
    font-size: 0.9rem;
    color: #d4af37;
  }
  .ticket__close {
    flex: none;
    min-height: 44px;
    padding: 0 1.1rem;
    border: 1px solid #d4af37;
    border-radius: 999px;
    background: transparent;
    color: #d4af37;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
  }
  .ticket__close:hover {
    background: rgba(212, 175, 55, 0.15);
  }

  .ticket__frame {
    flex: 1;
    min-height: 0;
    background: #fff;
  }
  /* iframe создаётся через JS и без атрибута областей видимости Astro — нужен :global */
  .ticket__frame :global(.ticket__iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .ticket__fallback {
    margin: 0;
    padding: 0.7rem 1.2rem;
    background: #f6f1e0;
    font-size: 0.95rem;
    text-align: center;
  }
  .ticket__fallback[hidden] {
    display: none;
  }
  .ticket__fallback a {
    color: #7a5a00;
    font-weight: 600;
  }

  /* Телефон: на весь экран, без скруглений */
  @media (max-width: 767px) {
    .ticket {
      align-items: stretch;
    }
    .ticket__panel {
      width: 100vw;
      height: 100dvh;
      border-radius: 0;
    }
    .ticket__title {
      font-size: 1.05rem;
    }
  }
</style>
