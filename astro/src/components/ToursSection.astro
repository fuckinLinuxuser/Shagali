---
// CastingsSlider.astro

const items = [
  {
    poster: '/posters/Foxes_preview.jpg',
    title: 'Вертикальный кастинг #1',
    subtitle: 'Танго с лисами • 4K vertical',
  },
  {
    poster: '/posters/Show_scripka.png',
    title: 'Скрипичный перформанс',
    subtitle: 'Горизонтальный шоу-проект • 2025',
  },
  {
    poster: '/posters/Komarovo.png',
    title: 'Комарово Open Air',
    subtitle: 'Вертикальный кастинг #2 • лето 2025',
  }
];
---

<section class="castings-section">
  <h2 class="section-title">Пробы и кастинги</h2>

  <div class="slider-container">
    <div class="slider-viewport">
      <div class="slide left"   id="slide-left"></div>
      <div class="slide center" id="slide-center"></div>
      <div class="slide right"  id="slide-right"></div>
    </div>

    <div class="dots" id="dots"></div>

    <button class="nav-btn prev" id="prev">←</button>
    <button class="nav-btn next" id="next">→</button>
  </div>
</section>

<style is:global>
  .castings-section {
    padding: 6rem 0 10rem;
    background: #181c1b;
    position: relative;
    overflow: hidden;
  }

  .castings-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at bottom right, rgba(102,255,153,0.08) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .section-title {
    text-align: center;
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 900;
    color: #ffdd99;
    text-shadow: 0 0 30px rgba(255, 221, 153, 0.45), 0 0 60px rgba(255, 221, 153, 0.25);
    letter-spacing: -1px;
    margin-bottom: 4.5rem;
    position: relative;
    z-index: 1;
  }

  .slider-container {
    position: relative;
    height: 70vh;
    min-height: 520px;
    max-height: 840px;
    margin: 0 auto;
    perspective: 1400px;
    overflow: hidden;
    z-index: 1;
  }

  .slider-viewport {
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2.8rem;
    position: relative;
  }

  .slide {
    width: 320px;
    aspect-ratio: 9 / 16;
    border-radius: 1.4rem;
    overflow: hidden;
    background: linear-gradient(135deg, #0f1412, #141a18);
    border: 1px solid #1e2a24;
    box-shadow: 0 20px 70px rgba(0,0,0,0.75), inset 0 0 30px rgba(102,255,153,0.05);
    position: relative;
    transition: all 0.9s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .slide.center {
    width: 380px;
    transform: scale(1.06) translateZ(80px);
    opacity: 1;
    border-color: #55ff88;
    box-shadow: 
      0 50px 140px rgba(85,255,136,0.35),
      0 0 0 2px #66ff99,
      inset 0 0 60px rgba(102,255,153,0.12);
    z-index: 3;
  }

  .slide.left,
  .slide.right {
    transform: scale(0.86) translateZ(-100px);
    opacity: 0.82;
  }

  .slide.left  { transform: scale(0.86) translateX(-15%) translateZ(-120px) rotateY(10deg); }
  .slide.right { transform: scale(0.86) translateX( 15%) translateZ(-120px) rotateY(-10deg); }

  .slide-content {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(0.96);
    transition: opacity 0.55s ease, transform 0.65s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .slide-content.visible {
    opacity: 1;
    transform: scale(1);
  }

  .poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.28);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .slide.center .play-overlay {
    opacity: 1;
  }

  .play-circle {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: rgba(102,255,153,0.15);
    backdrop-filter: blur(10px);
    border: 2px solid #66ff99;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #aaffcc;
    transition: all 0.35s ease;
    box-shadow: 0 0 25px rgba(102,255,153,0.4);
  }

  .slide.center .play-circle {
    transform: scale(1.1);
    background: rgba(102,255,153,0.28);
    border-color: #88ffaa;
  }

  .play-circle svg {
    width: 42px;
    height: 42px;
  }

  .content-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2.4rem 1.8rem 1.8rem;
    background: linear-gradient(to top, rgba(10,14,12,0.95) 0%, transparent 70%);
    pointer-events: none;
  }

  .title {
    font-size: 1.38rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
    color: #ffdd99;
    text-shadow: 0 2px 12px rgba(0,0,0,0.9);
  }

  .subtitle {
    font-size: 0.94rem;
    color: #a0b0a8;
    opacity: 0.9;
  }

  .nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(30,40,35,0.7);
    backdrop-filter: blur(16px);
    border: 1px solid #2a3a32;
    color: #88ffaa;
    font-size: 1.9rem;
    cursor: pointer;
    transition: all 0.4s ease;
    z-index: 10;
    box-shadow: 0 0 20px rgba(102,255,153,0.15);
  }

  .nav-btn.prev { left: 1.5rem; }
  .nav-btn.next { right: 1.5rem; }

  .nav-btn:hover {
    background: rgba(102,255,153,0.18);
    border-color: #66ff99;
    color: #aaffcc;
    transform: translateY(-50%) scale(1.12);
    box-shadow: 0 0 40px rgba(102,255,153,0.35);
  }

  .dots {
    position: absolute;
    bottom: 2.2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 1rem;
    z-index: 10;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(102,255,153,0.2);
    border: 2px solid transparent;
    transition: all 0.35s ease;
    cursor: pointer;
  }

  .dot.active {
    background: #66ff99;
    border-color: #aaffcc;
    transform: scale(1.4);
    box-shadow: 0 0 15px rgba(102,255,153,0.6);
  }

  @media (max-width: 900px) {
    .slider-viewport { gap: 1.2rem; }
    .slide { width: 260px; }
    .slide.center { width: 320px; }
    .slide.left  { transform: scale(0.84) translateX(-22%) translateZ(-140px) rotateY(14deg); }
    .slide.right { transform: scale(0.84) translateX( 22%) translateZ(-140px) rotateY(-14deg); }
    .nav-btn { width: 56px; height: 56px; font-size: 1.7rem; }
  }
</style>

<script is:inline define:vars={{ items }}>
  const left   = document.getElementById('slide-left');
  const center = document.getElementById('slide-center');
  const right  = document.getElementById('slide-right');

  const dotsContainer = document.getElementById('dots');
  const prevBtn = document.getElementById('prev');
  const nextBtn = document.getElementById('next');

  let current = 0;
  const n = items.length;

  let animationTimeout = null;

  function renderSlides() {
    const prevIdx = (current - 1 + n) % n;
    const nextIdx = (current + 1) % n;

    document.querySelectorAll('.slide-content').forEach(el => {
      el.classList.remove('visible');
    });

    clearTimeout(animationTimeout);
    animationTimeout = setTimeout(() => {
      [left, center, right].forEach(el => {
        el.innerHTML = '';
        el.classList.remove('center');
      });

      left.innerHTML   = createSlideHTML(items[prevIdx]);
      center.innerHTML = createSlideHTML(items[current]);
      right.innerHTML  = createSlideHTML(items[nextIdx]);

      center.classList.add('center');

      setTimeout(() => {
        document.querySelectorAll('.slide-content').forEach(el => {
          el.classList.add('visible');
        });
      }, 50);

      document.querySelectorAll('.dot').forEach((d, i) => {
        d.classList.toggle('active', i === current);
      });
    }, 600);
  }

  function createSlideHTML(item) {
    return `
      <div class="slide-content visible">
        <img src="${item.poster}" alt="${item.title}" class="poster" loading="lazy">
        <div class="play-overlay">
          <div class="play-circle">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5v14l11-7z" />
            </svg>
          </div>
        </div>
        <div class="content-overlay">
          <h3 class="title">${item.title}</h3>
          <p class="subtitle">${item.subtitle}</p>
        </div>
      </div>
    `;
  }

  function createDots() {
    dotsContainer.innerHTML = '';
    items.forEach((_, i) => {
      const dot = document.createElement('div');
      dot.classList.add('dot');
      if (i === current) dot.classList.add('active');
      dot.addEventListener('click', () => {
        current = i;
        renderSlides();
      });
      dotsContainer.appendChild(dot);
    });
  }

  function next() {
    current = (current + 1) % n;
    renderSlides();
  }

  function prev() {
    current = (current - 1 + n) % n;
    renderSlides();
  }

  prevBtn.addEventListener('click', prev);
  nextBtn.addEventListener('click', next);

  let touchStartX = 0;
  document.querySelector('.slider-viewport').addEventListener('touchstart', e => {
    touchStartX = e.touches[0].clientX;
  });

  document.querySelector('.slider-viewport').addEventListener('touchend', e => {
    const diff = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(diff) > 60) {
      if (diff > 0) prev();
      else next();
    }
  });

  createDots();
  renderSlides();
</script>