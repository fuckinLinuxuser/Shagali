---
/* Если нужно — здесь можно добавить frontmatter / props / импорты */
---

<style>
    body {
        font-family: 'Arial', sans-serif;
        background-color: #1e1e17ec;
        color: #f3e5e5;
        margin: 0;
        padding: 0;
    }

    .our-people {
        max-width: 1400px;
        margin: 60px auto;
        padding: 0 20px;
        text-align: center;
    }

    .our-people h1 {
        font-size: 2.8em;
        margin-bottom: 50px;
        color: #222;
        text-transform: uppercase;
        letter-spacing: 3px;
        position: relative;
    }

    .our-people h1::after {
        content: '';
        width: 120px;
        height: 3px;
        background: #d4af37;
        position: absolute;
        bottom: -15px;
        left: 50%;
        transform: translateX(-50%);
    }

    .people-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, 340px);
        gap: 35px;
        justify-content: center;
        padding: 0 10px;
    }

    .person-card {
        width: 340px;
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 6px 18px rgba(0,0,0,0.12);
        transition: all 0.28s ease;
        cursor: pointer;
    }

    .person-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 28px rgba(0,0,0,0.18);
    }

    .person-image {
        width: 100%;
        height: 340px;
        object-fit: cover;
    }

    .person-info {
        padding: 22px 20px;
        text-align: center;
    }

    .person-name {
        font-size: 1.65em;
        margin: 0 0 8px;
        color: #222;
    }

    .person-role {
        font-size: 1.15em;
        color: #d4af37;
        font-weight: 500;
        margin-bottom: 14px;
    }

    .person-short {
        font-size: 0.97em;
        color: #555;
        line-height: 1.45;
        margin: 0;
    }

    /* Модальное окно */
    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.78);
        overflow: auto;
    }
   
    .modal-content {
        background: white;
        margin: 4% auto;
        padding: 0;
        border-radius: 12px;
        width: 90%;
        max-width: 820px;          /* чуть шире, чтобы видео комфортно смотрелось */
        box-shadow: 0 10px 40px rgba(0,0,0,0.4);
        position: relative;
        overflow: hidden;
    }

    .modal-header {
        font-family: 'Playfair Display', serif;
        background: linear-gradient(135deg, #1a1a1a, #333);
        color: white;
        padding: 30px 40px 20px;
        text-align: center;
    }

    .modal-header h2 {
        margin: 0;
        font-size: 2.1em;
    }

    .modal-header .role {
        color: #d4af37;
        font-size: 1.3em;
        margin-top: 8px;
    }

    .modal-body {
        padding: 30px 40px;
        font-size: 1.03em;
        line-height: 1.7;
        color: #333;
    }

    .modal-video-wrapper {
        position: relative;
        padding-bottom: 56.25%; /* 16:9 */
        height: 0;
        overflow: hidden;
        margin: 25px 0 35px;
        border-radius: 8px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.2);
    }

    .modal-video-wrapper iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    .close {
        position: absolute;
        right: 25px;
        top: 18px;
        color: white;
        font-size: 42px;
        font-weight: bold;
        cursor: pointer;
    }

    .close:hover {
        color: #d4af37;
    }

    @media (max-width: 768px) {
        .modal-content {
            margin: 8% auto;
            width: 94%;
        }
        .modal-header, .modal-body {
            padding: 25px 24px;
        }
    }

    @media (max-width: 480px) {
        .people-grid {
            grid-template-columns: 1fr;
            justify-content: center;
            padding: 0 20px;
        }
        .person-card {
            width: 100%;
            max-width: 360px;
        }
    }
</style>

<section class="our-people">
    <h1>Наши люди</h1>

    <div class="people-grid">

        <!-- Пример карточки с видео -->
        <div class="person-card" 
             data-name="Елена Владимировна ШАГАЛИ" 
             data-role="Театральный продюсер. Драматург. Режиссер." 
             data-bio="Одни птицы больше думают о красоте своих перьев. Другие хотят укрепить своё гнездо. А я отношусь к тем птицам, которые всю жизнь рвутся в небо, чтобы петь свою любовную песню прямо в светлые улыбающиеся глаза Солнца.<br><br>Да. Некоторые не долетают. Бывает.<br>Но кто-то обязательно споёт. <br>И Солнцу будет ради чего рождаться каждое утро."
             data-video="https://vkvideo.ru/video_ext.php?oid=-235880171&id=456239019&hash=6c3148a82d5bced5&hd=3">
            <img src="dist/images/Shagali.jpg" alt="Елена Шагали" class="person-image">
            <div class="person-info">
                <h2 class="person-name">Елена Шагали</h2>
                <div class="person-role">Театральный продюсер. Драматург. Режиссер.</div>
                <p class="person-short">Никто не спросил, хотела ли я всё это уметь. Но без этого — не зажигалось и не пылало.</p>
            </div>
        </div>

        <!-- Следующие карточки добавляй аналогично -->

    </div>
</section>

<!-- Модальное окно -->
<div id="people-modal" class="modal">
    <div class="modal-content">
        <span class="close">×</span>
        <div class="modal-header">
            <h2 id="modal-name"></h2>
            <div class="role" id="modal-role"></div>
        </div>
        <div class="modal-body">
            <!-- Видео будет здесь -->
            <div id="modal-video-wrapper" class="modal-video-wrapper" style="display:none;">
                <iframe id="modal-video" src="" frameborder="0" allowfullscreen></iframe>
            </div>
            <div id="modal-bio"></div>
        </div>
    </div>
</div>

<script is:inline>
    const cards = document.querySelectorAll('.person-card');
    const modal = document.getElementById('people-modal');
    const modalName = document.getElementById('modal-name');
    const modalRole = document.getElementById('modal-role');
    const modalBio = document.getElementById('modal-bio');
    const modalVideoWrapper = document.getElementById('modal-video-wrapper');
    const modalVideo = document.getElementById('modal-video');
    const closeBtn = document.querySelector('#people-modal .close');

    cards.forEach(card => {
        card.addEventListener('click', () => {
            modalName.textContent = card.dataset.name || '—';
            modalRole.textContent = card.dataset.role || '';

            // Биография
            let bio = card.dataset.bio || '';
            modalBio.innerHTML = bio.replace(/\n/g, '<br>');

            // Видео
            const videoUrl = card.dataset.video;
            if (videoUrl && videoUrl.trim() !== '') {
                modalVideo.src = videoUrl;
                modalVideoWrapper.style.display = 'block';
            } else {
                modalVideo.src = '';
                modalVideoWrapper.style.display = 'none';
            }

            modal.style.display = 'block';
        });
    });

    // Закрытие
    closeBtn.addEventListener('click', () => {
        modal.style.display = 'none';
        modalVideo.src = ''; // останавливаем видео
    });

    window.addEventListener('click', (e) => {
        if (e.target === modal) {
            modal.style.display = 'none';
            modalVideo.src = '';
        }
    });
</script>