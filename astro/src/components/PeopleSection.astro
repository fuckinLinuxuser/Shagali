</section>

<!-- Модальное окно -->
<div id="people-modal" class="modal">
  <div class="modal-content">
    <span class="close">×</span>
    <div class="modal-header">
      <h2 id="modal-name"></h2>
      <div class="role" id="modal-role"></div>
    </div>
    <div class="modal-body">
      <img id="modal-full-image" style="display:none; max-width:40%; border-radius:12px; margin:1.5rem auto; display:block;" alt="Фото">
      <div id="modal-video-wrapper" class="modal-video-wrapper" style="display:none;">
        <video id="modal-video" controls></video>
      </div>
      <div id="modal-bio"></div>
    </div>
  </div>
</div>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  // берём все нужные элементы ОДИН раз
  const modal       = document.getElementById('people-modal');
  const nameEl      = document.getElementById('modal-name');
  const roleEl      = document.getElementById('modal-role');
  const bioEl       = document.getElementById('modal-bio');
  const imgEl       = document.getElementById('modal-full-image');
  const videoWrap   = document.getElementById('modal-video-wrapper');
  const videoEl     = document.getElementById('modal-video');
  const closeBtn    = modal?.querySelector('.close');

  if (!modal) {
    console.error("Модалка #people-modal не найдена");
    return;
  }

  // Функция открытия — одна на всех
  function showModal(card) {
    nameEl.textContent = card.dataset.name  || '—';
    roleEl.textContent = card.dataset.role  || '—';

    // Биография — берём .bio-content из карточки
    const bioContent = card.querySelector('.bio-content');
    bioEl.innerHTML = bioContent?.innerHTML || '<p style="color:#777; font-style:italic;">био отсутствует</p>';

    // фото
    const fullSrc = card.dataset.fullImage;
    if (fullSrc) {
      imgEl.src = fullSrc;
      imgEl.style.display = 'block';
    } else {
      imgEl.style.display = 'none';
    }

    // видео
    const vidSrc = card.dataset.video;
    if (vidSrc) {
      videoEl.src = vidSrc;
      videoWrap.style.display = 'block';
    } else {
      videoEl.src = '';
      videoWrap.style.display = 'none';
    }

    modal.style.display = 'block';
  }

  // ────────────────────────────────────────────────
  // Убрали кликабельность всей карточки
  // ────────────────────────────────────────────────

  // Больше НЕ делаем карточку pointer и НЕ вешаем на неё click
  // document.querySelectorAll('.person-card').forEach(card => {
  //     card.style.cursor = 'pointer';
  //     card.addEventListener('click', ...);
  // });

  // Оставляем обработку ТОЛЬКО на кнопках
  document.querySelectorAll('.read-full-btn, .btn-detail, .more-btn').forEach(btn => {
    // На всякий случай убираем pointer и hover-эффекты с карточки, если они были
    const card = btn.closest('.person-card');
    if (card) {
      card.style.cursor = 'default';
      // card.style.pointerEvents = 'none';   // ← можно включить, если хотите полностью отключить любые взаимодействия с карточкой
    }

    btn.addEventListener('click', e => {
      e.stopPropagation();           // на случай, если где-то выше есть другие обработчики
      const card = btn.closest('.person-card');
      if (card) {
        showModal(card);
      }
    });
  });

  // закрытие (без изменений)
  closeBtn?.addEventListener('click', () => {
    modal.style.display = 'none';
  });

  modal.addEventListener('click', e => {
    if (e.target === modal) {
      modal.style.display = 'none';
    }
  });
});


document.querySelectorAll('.person-card').forEach(card => {
    card.addEventListener('click', e => {
        // Если цель клика — НЕ кнопка, НЕ ссылка и НЕ элемент с pointer-events: auto
        if (!e.target.closest('button, .read-full-btn, a, [role="button"]')) {
            e.stopPropagation();
            e.preventDefault();
            return false;           // максимально блокируем
        }
        // если кликнули по кнопке → пусть идёт дальше
    }, { capture: true });          // перехватываем на фазе захвата
});
</script>