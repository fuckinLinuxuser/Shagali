---
// src/components/PeopleSection.astro

const people = [
  {
    name: "Антонио Вивальди",
    role: "Скрипач",
    description: "Звезда «Скрипичного Шоу», мастер скрипки.",
    photo: "/images/vivaldi.jpg"   // ← подставь реальные пути
  },
  {
    name: "Елена Шагали",
    role: "Режиссёр",
    description: "Создатель «Недели Испании», страсть, танцы, Испания.",
    photo: "/images/Shagali.jpg"
  },
  {
    name: "Роман Самотуга",
    role: "Актёр",
    description: "Главный герой «Мамочка, Купи Собаку».",
    photo: "/images/samotuga.jpg"
  }
];
---

<section id="people" class="section people">
  <div class="container">
    <h2>Наши Люди</h2>

    <div class="people-grid">
      {
        people.map(person => (
          <div class="person-card">
            <div class="card-inner">
              <img 
                src={person.photo} 
                alt={person.name} 
                class="person-photo" 
                loading="lazy"
              />
              <div class="diagonal-overlay"></div>
              <div class="info">
                <h3 class="name">{person.name}</h3>
                <div class="role">{person.role}</div>
                <p class="description">{person.description}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  .people-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2.5rem 2rem;
  padding: 1rem 0;
}

.person-card {
  position: relative;
  border-radius: 16px;
  overflow: hidden;
  background: #1a1a1a;
  transition: all 0.4s ease;
  aspect-ratio: 3 / 4;           /* красивая пропорция для портретов */
  box-shadow: 0 4px 20px rgba(0,0,0,0.4);
}

.person-card:hover {
  transform: translateY(-12px);
  box-shadow: 0 20px 50px rgba(255, 215, 0, 0.15);
}

.card-inner {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.person-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
  filter: brightness(0.92) contrast(1.05);
}

.person-card:hover .person-photo {
  transform: scale(1.08);
}

/* Диагональный акцент */
.diagonal-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    135deg,
    transparent 38%,
    rgba(255, 215, 0, 0.18) 52%,
    rgba(255, 215, 0, 0.08) 70%,
    transparent 85%
  );
  opacity: 0;
  transition: opacity 0.5s ease;
  pointer-events: none;
  mix-blend-mode: soft-light;     /* красиво смешивается с фото */
}

.person-card:hover .diagonal-overlay {
  opacity: 1;
}

/* Информация */
.info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 2.2rem 1.8rem 1.8rem;
  background: linear-gradient(to top, rgba(18,18,18,0.95) 30%, transparent);
  color: white;
}

.name {
  margin: 0 0 0.4rem;
  font-size: 1.55rem;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.role {
  color: gold;
  font-size: 1.05rem;
  font-weight: 500;
  margin-bottom: 0.9rem;
  opacity: 0.95;
}

.description {
  margin: 0;
  font-size: 0.97rem;
  line-height: 1.5;
  color: #ddd;
  opacity: 0.92;
}

/* Адаптивность */
@media (max-width: 600px) {
  .people-grid {
    gap: 2rem 1.2rem;
  }
  .person-card {
    aspect-ratio: 3 / 4.2;
  }
}
</style>