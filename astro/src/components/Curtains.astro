---
// Красные бархатные кулисы поверх блока «слайдер + афиша». Состояние — атрибут data-curtain-state у ближайшего
// [data-curtain-root]: closed (закрыты) → open (сложены по краям, 14% ширины половины; 7% на телефоне).
// Без JS и при prefers-reduced-motion кулисы сразу сложены. pointer-events: none — они ничего не перекрывают.
---

<div class="curtain curtain--left" data-curtain="left" aria-hidden="true"></div>
<div class="curtain curtain--right" data-curtain="right" aria-hidden="true"></div>

<script is:inline>
  // До первой отрисовки: кулисы закрыты и только потом раскрываются (без вспышки сложенного состояния).
  (function () {
    var root = document.currentScript.closest('[data-curtain-root]');
    if (root && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.setAttribute('data-curtain-instant', '');
      root.setAttribute('data-curtain-state', 'closed');
    }
  })();
</script>

<script>
  const root = document.querySelector<HTMLElement>('[data-curtain-root]');
  if (root) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer: ReturnType<typeof setTimeout> | undefined;

    const open = () => {
      root.removeAttribute('data-curtain-instant');
      root.setAttribute('data-curtain-state', 'open');
    };

    if (reduced) {
      root.setAttribute('data-curtain-state', 'open');
    } else {
      timer = setTimeout(open, 700);
    }

    // «Занавес»: закрыть сразу и раскрыть заново
    document.querySelectorAll<HTMLElement>('[data-curtain-replay]').forEach((btn) => {
      btn.addEventListener('click', () => {
        clearTimeout(timer);
        root.setAttribute('data-curtain-instant', '');
        root.setAttribute('data-curtain-state', 'closed');
        if (!reduced) timer = setTimeout(open, 900);
        else open();
      });
    });
  }
</script>

<style>
  .curtain {
    --folded: 0.14;
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    z-index: 5;
    pointer-events: none;
    border-top: 10px solid #cfae4a;
    box-sizing: border-box;
    transform: scaleX(var(--folded)); /* по умолчанию сложены: так и без JS */
    transition: transform 2.8s cubic-bezier(0.62, 0, 0.22, 1);
  }
  .curtain--left {
    left: 0;
    transform-origin: left center;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0) 12%, rgba(0, 0, 0, 0) 88%, rgba(0, 0, 0, 0.45)),
      repeating-linear-gradient(90deg, #8e1119 0px, #c1272f 26px, #9a131b 52px, #5f0a10 68px, #8e1119 84px);
  }
  .curtain--right {
    right: 0;
    transform-origin: right center;
    background:
      linear-gradient(270deg, rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0) 12%, rgba(0, 0, 0, 0) 88%, rgba(0, 0, 0, 0.45)),
      repeating-linear-gradient(270deg, #8e1119 0px, #c1272f 26px, #9a131b 52px, #5f0a10 68px, #8e1119 84px);
  }

  :global([data-curtain-state='closed']) .curtain {
    transform: scaleX(1);
  }
  :global([data-curtain-instant]) .curtain {
    transition: none;
  }

  @media (max-width: 767px) {
    .curtain {
      --folded: 0.07;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .curtain {
      transition: none;
    }
  }
</style>
