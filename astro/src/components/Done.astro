---
// Done.astro
---

<section class="done-plays">
  <div class="container">
    <h1 class="section-title">Пройденные спектакли</h1>
    <p class="subtitle">Города, в которых мы играли</p>

    <div class="plays-header">
      <h2 id="playsTitle">Санкт-Петербург — спектакли</h2>
    </div>

    <div class="plays-grid" id="playsGrid"></div>
  </div>

  <!-- Модалка спектакля -->
  <div class="modal-overlay" id="playModal">
    <div class="done-modal-content">
      <button class="modal-close" id="modalClose">✕</button>
      <img class="modal-image" id="modalImage" src="" alt="" />
      <h2 class="modal-title" id="modalTitle"></h2>
      <div class="modal-date" id="modalDate"></div>
      <div class="modal-quote" id="modalQuote"></div>
      <p class="modal-description" id="modalDescription"></p>

      <div class="modal-actors-title">Актёры</div>
      <ul class="actors-list" id="modalActors"></ul>
    </div>
  </div>

  <!-- Модалка актёра -->
  <div class="modal-overlay" id="actorModal">
    <div class="done-modal-content actor-modal-content">
      <button class="modal-close" id="actorModalClose">✕</button>
      <img class="modal-image" id="actorModalImage" src="" alt="" style="display:none;" />
      <h2 class="modal-title" id="actorModalName"></h2>
      <div class="modal-quote" id="actorModalRole"></div>
      <div class="actor-modal-video" id="actorModalVideoWrapper" style="display:none;">
        <video id="actorModalVideo" controls playsinline></video>
      </div>
      <p class="modal-description" id="actorModalBio"></p>
    </div>
  </div>
</section>

<style is:global>
  .done-plays {
    font-family: 'Inter', sans-serif;
    background: #f8f5f0;
    color: #222;
    padding: 2.5rem 1rem;
  }

  .container { max-width: 1280px; margin: 0 auto; }

  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.6rem, 6.5vw, 4.2rem);
    text-align: center;
    margin-bottom: 0.8rem;
    color: #222;
    position: relative;
  }

  .section-title::after {
    content: '';
    width: 140px;
    height: 3px;
    background: #d4af37;
    position: absolute;
    bottom: -18px;
    left: 50%;
    transform: translateX(-50%);
  }

  .subtitle {
    text-align: center;
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    color: #555;
    margin-bottom: 3.5rem;
    letter-spacing: 2px;
  }

  .plays-header {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 3rem;
    border-bottom: none;
  }

  .plays-header h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.4rem, 5.5vw, 3.2rem);
    text-align: center;
  }

  .plays-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(290px, 100%), 1fr));
    gap: 1.6rem;
  }

  .play-item {
    background: white;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 16px;
    padding: 1.8rem;
    cursor: pointer;
    transition: all 0.35s ease;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.07);
  }

  .play-item:hover {
    border-color: #d4af37;
    transform: translateY(-6px);
    box-shadow: 0 15px 35px rgba(212, 175, 55, 0.18);
  }

  .play-title {
    font-size: clamp(1.2rem, 3vw, 1.45rem);
    font-weight: 600;
    margin-bottom: 0.8rem;
  }

  /* Афиша текущего спектакля */
  .special-play-kukushonok {
    display: grid;
    grid-template-columns: minmax(260px, 1fr) minmax(320px, 1.15fr);
    align-items: stretch;
    background: #fff;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12);
    cursor: pointer;
    transition: all 0.4s ease;
    max-width: 980px;
    margin: 0 auto 3rem;
    text-align: left;
  }

  .special-play-kukushonok:hover {
    transform: translateY(-10px);
    box-shadow: 0 30px 65px rgba(212, 175, 55, 0.28);
  }

  .kukushonok-media {
    position: relative;
    min-height: 320px;
  }

  .kukushonok-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .kukushonok-badge {
    position: absolute;
    top: 1.2rem;
    left: 1.2rem;
    background: rgba(20, 18, 12, 0.75);
    color: #e8c766;
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgba(212, 175, 55, 0.5);
  }

  .kukushonok-info {
    padding: 2.6rem 2.6rem 2.4rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: linear-gradient(160deg, #fffdf7, #f6efe0);
  }

  .kukushonok-eyebrow {
    color: #a4831f;
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 0.8rem;
  }

  .kukushonok-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    color: #222;
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .kukushonok-quote {
    font-style: italic;
    color: #555;
    border-left: 3px solid #d4af37;
    padding-left: 1rem;
    margin: 0 0 1.4rem;
  }

  .kukushonok-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.8rem;
  }

  .kukushonok-meta span {
    font-size: 0.8rem;
    color: #8a7a4e;
    border: 1px solid #dfd2ab;
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
  }

  .kukushonok-cta {
    color: #a4831f;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .special-play-kukushonok:hover .kukushonok-cta {
    color: #d4af37;
  }

  /* Модалка */
  .modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.78);
    z-index: 2000;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .modal-overlay.visible { display: flex; }

  .done-modal-content {
    background: white;
    color: #222;
    border-radius: 20px;
    max-width: 820px;
    width: 100%;
    max-height: 88vh;
    overflow-y: auto;
    padding: 3rem 2.8rem;
    position: relative;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }

  .modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 5;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    color: #fff;
    cursor: pointer;
    background: rgba(0, 0, 0, 0.45);
    border: none;
    border-radius: 50%;
    line-height: 1;
    backdrop-filter: blur(2px);
  }

  .modal-image {
    width: 100%;
    height: 320px;
    object-fit: cover;
    border-radius: 14px;
    margin-bottom: 2rem;
  }

  .modal-date {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 auto 1.4rem;
    padding: 0.45rem 1.2rem;
    border: 1px solid #d4af37;
    border-radius: 999px;
    color: #a4831f;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.4px;
  }

  .modal-date::before {
    content: '📅';
  }

  .modal-actors-title {
    color: #d4af37;
    font-weight: 600;
    margin: 1.5rem 0 0.8rem;
  }

  .actors-list {
    list-style: none;
    color: #333;
    padding-left: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .actor-btn {
    background: #fff;
    border: 1.5px solid #d4af37;
    color: #222;
    border-radius: 999px;
    padding: 0.5rem 1.1rem;
    font-size: 0.95rem;
    font-family: 'Inter', sans-serif;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .actor-btn:hover {
    background: #d4af37;
    color: #1a1a1a;
  }

  /* Модалка актёра — компактнее, поверх модалки спектакля */
  .actor-modal-content {
    max-width: 480px;
    text-align: center;
    padding: 3rem 2.4rem;
  }

  #actorModalRole {
    color: #d4af37;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  #actorModalBio {
    color: #444;
    line-height: 1.6;
    text-align: left;
  }

  .actor-modal-video {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    overflow: hidden;
    background: #000;
    margin-bottom: 1.6rem;
  }

  .actor-modal-video video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* ─── Мобильные стили ────────────────────────────────────── */
  @media (max-width: 768px) {
    .done-plays {
      padding: 2rem 0.9rem;
    }

    .section-title {
      font-size: clamp(1.9rem, 8vw, 2.6rem);
      margin-bottom: 0.6rem;
    }

    .section-title::after {
      bottom: -14px;
      width: 100px;
    }

    .subtitle {
      margin-bottom: 2.2rem;
      font-size: 0.95rem;
    }

    .plays-header {
      margin-bottom: 1.8rem;
    }

    .plays-header h2 {
      font-size: clamp(1.5rem, 6.5vw, 2rem);
    }

    .special-play-kukushonok {
      grid-template-columns: 1fr;
    }

    .kukushonok-media {
      min-height: 220px;
    }

    .kukushonok-info {
      padding: 1.6rem 1.4rem 1.8rem;
    }

    .modal-overlay {
      padding: 0.75rem;
    }

    .done-modal-content {
      padding: 3.6rem 1.3rem 2rem;
      border-radius: 16px;
    }

    .modal-image {
      height: 200px;
      margin-bottom: 1.4rem;
    }

    .modal-date {
      font-size: 0.85rem;
      padding: 0.4rem 1rem;
      margin-bottom: 1.1rem;
    }

    .actors-list {
      gap: 0.55rem;
    }

    .actor-btn {
      padding: 0.7rem 1.1rem;
      font-size: 0.92rem;
      min-height: 44px;
    }

    .actor-modal-content {
      padding: 3.6rem 1.3rem 2rem;
    }
  }
</style>

<script>
  function escapeHtml(str: string) {
    if (!str) return '';
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  type Actor = { name: string; role: string; bio?: string; image?: string; video?: string };

  const playsData: {
    id: string;
    title: string;
    dates: string[];
    description: string;
    quote?: string;
    image: string;
    actors: Actor[];
    duration: string;
    ageRestriction: string;
  }[] = [
    {
      id: 'kukushonok',
      title: 'Родной мой Кукушонок',
      dates: ['28 июня 2026'],
      description: 'Драму проживает каждый Ребенок, разочаровавший своих родителей. Трагедию носит в себе каждая Мать, оттолкнувшая своего ребенка...',
      quote: '"Спектакль о том, как взрослеют родители..."',
      image: '/images/projects/kukushonok.JPG',
      actors: [
        {
          name: 'Валерия',
          role: 'Актриса',
          video: '/videos/valeria.mp4',
          bio: 'Она из тех людей, которых хочешь видеть в своем будущем сталкерском отряде. С пути не свернёт даже при сильном шторме. Патроны вовремя поднесёт (причем молча, что особенно важно в сложной ситуации). Будет уверенно держать атаку зомби в узком дверном проёме, отбиваясь попеременно лопатой и букетом гладиолусов… При этом шикарно танцует танго, готовит какие-то невероятные оладушки и вечерами смотрит с детворой хорошие советские фильмы.\n\nЛюблю видеть её на сцене. Знаю, что буду чувствовать и проживать вслед за ней. Буду внутри повторять ее реплики и тайком плакать ее слезами. Живая. Сложная. Странная.\n\nВ общем, не актриса, а мечта. Не ту женщину Сарой Коннор назвали.\n\nДа и не надо. Наша – интереснее. И моложе, кстати!'
        },
        {
          name: 'Анна',
          role: 'Актриса. Хореограф.',
          video: '/videos/anna.mp4',
          bio: 'При всей своей внешней хрупкости эта девушка умеет упереться лапкой и упорно добиваться поставленной цели – сказывается балетная выучка. Мечтает об ярком музыкальном шоу, которое мы могли бы провезти по всей стране. И мы шаг за шагом идем к тому, чтобы реализовать эту красивую мечту.\n\nПотому что какой смысл жить в мире, который не украшен музыкой и движением?\n\nМожет, она не построит мощный каменный дом. Зато вы бы видели, какие нежные и парящие воздушные замки она строит одним поворотом головы.\n\nВероятно, она не будет угощать нас на репетициях свежевыращенными кабачками. Но когда она заходит в театр – все лица расцветают улыбками.\n\nКрасоту нужно уметь создавать, и это идёт изнутри.\n\nУ неё – получается.'
        },
        {
          name: 'Егор',
          role: 'Актер'
        },
        {
          name: 'Алексей',
          role: 'Актер'
        }
      ],
      duration: '1 час 30 минут',
      ageRestriction: '16+'
    }
  ];

  document.addEventListener('DOMContentLoaded', () => {
    const playsGrid = document.getElementById('playsGrid');

    const modal = document.getElementById('playModal');
    const modalClose = document.getElementById('modalClose');
    const modalImage = document.getElementById('modalImage') as HTMLImageElement;
    const modalTitle = document.getElementById('modalTitle');
    const modalDate = document.getElementById('modalDate');
    const modalQuote = document.getElementById('modalQuote');
    const modalDescription = document.getElementById('modalDescription');
    const modalActors = document.getElementById('modalActors');

    const actorModal = document.getElementById('actorModal');
    const actorModalClose = document.getElementById('actorModalClose');
    const actorModalImage = document.getElementById('actorModalImage') as HTMLImageElement;
    const actorModalName = document.getElementById('actorModalName');
    const actorModalRole = document.getElementById('actorModalRole');
    const actorModalVideoWrapper = document.getElementById('actorModalVideoWrapper');
    const actorModalVideo = document.getElementById('actorModalVideo') as HTMLVideoElement;
    const actorModalBio = document.getElementById('actorModalBio');

    if (!playsGrid || !modal || !modalClose || !modalImage || !modalTitle || !modalDate || !modalQuote ||
        !modalDescription || !modalActors || !actorModal || !actorModalClose || !actorModalImage ||
        !actorModalName || !actorModalRole || !actorModalVideoWrapper || !actorModalVideo || !actorModalBio) {
      return;
    }

    function renderPlays() {
      let html = '';

      // Специальный блок для Кукушонка
      const kukushonok = playsData.find(p => p.id === 'kukushonok');
      if (kukushonok) {
        html += `
          <div class="special-play-kukushonok" data-play-id="${kukushonok.id}">
            <div class="kukushonok-media">
              <img src="${kukushonok.image}" alt="${kukushonok.title}" class="kukushonok-image" loading="lazy">
              <span class="kukushonok-badge">Идёт сейчас</span>
            </div>
            <div class="kukushonok-info">
              <span class="kukushonok-eyebrow">Играем в Санкт-Петербурге</span>
              <div class="kukushonok-title">${kukushonok.title}</div>
              ${kukushonok.quote ? `<p class="kukushonok-quote">${escapeHtml(kukushonok.quote)}</p>` : ''}
              <div class="kukushonok-meta">
                <span>${escapeHtml(kukushonok.duration)}</span>
                <span>${escapeHtml(kukushonok.ageRestriction)}</span>
                <span>${escapeHtml(kukushonok.dates.join(' • '))}</span>
              </div>
              <span class="kukushonok-cta">Подробнее о спектакле →</span>
            </div>
          </div>
        `;
      }

      // Остальные спектакли
      html += playsData.filter(p => p.id !== 'kukushonok').map(play => `
        <div class="play-item" data-play-id="${play.id}">
          <div class="play-title">${play.title}</div>
          <div class="play-dates">${play.dates.map(d => `<span>${d}</span>`).join(' • ')}</div>
        </div>
      `).join('');

      playsGrid!.innerHTML = html;

      playsGrid!.querySelectorAll('[data-play-id]').forEach(item => {
        item.addEventListener('click', () => {
          const play = playsData.find(p => p.id === (item as HTMLElement).dataset.playId);
          if (play) openModal(play);
        });
      });
    }

    function openModal(play: typeof playsData[number]) {
      modalImage.src = play.image;
      modalTitle!.textContent = play.title;
      modalDate!.textContent = play.dates.join(' • ');
      modalQuote!.textContent = play.quote || '';
      modalDescription!.textContent = play.description;

      modalActors!.innerHTML = play.actors.map((actor, i) => `
        <li><button type="button" class="actor-btn" data-actor-index="${i}">${escapeHtml(actor.name)} — ${escapeHtml(actor.role)}</button></li>
      `).join('');

      modalActors!.querySelectorAll('.actor-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = Number((btn as HTMLElement).dataset.actorIndex);
          const actor = play.actors[idx];
          if (actor) openActorModal(actor);
        });
      });

      modal!.classList.add('visible');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal!.classList.remove('visible');
      document.body.style.overflow = '';
    }

    function openActorModal(actor: Actor) {
      actorModalName!.textContent = actor.name;
      actorModalRole!.textContent = actor.role;

      if (actor.image) {
        actorModalImage.src = actor.image;
        actorModalImage.alt = actor.name;
        actorModalImage.style.display = 'block';
      } else {
        actorModalImage.style.display = 'none';
      }

      if (actor.video) {
        actorModalVideo!.src = actor.video;
        actorModalVideoWrapper!.style.display = 'block';
      } else {
        actorModalVideoWrapper!.style.display = 'none';
      }

      const bio = actor.bio && actor.bio.trim() ? actor.bio : 'Информация об актёре появится позже.';
      actorModalBio!.innerHTML = escapeHtml(bio).replace(/\n/g, '<br>');

      actorModal!.classList.add('visible');
    }

    function closeActorModal() {
      actorModal!.classList.remove('visible');
      actorModalVideo!.pause();
      actorModalVideo!.src = '';
    }

    modalClose.addEventListener('click', closeModal);
    modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });

    actorModalClose.addEventListener('click', closeActorModal);
    actorModal.addEventListener('click', e => { if (e.target === actorModal) closeActorModal(); });

    document.addEventListener('keydown', e => {
      if (e.key !== 'Escape') return;
      if (actorModal!.classList.contains('visible')) {
        closeActorModal();
      } else if (modal!.classList.contains('visible')) {
        closeModal();
      }
    });

    renderPlays();
  });
</script>
