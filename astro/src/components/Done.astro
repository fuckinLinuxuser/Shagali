---
// Done.astro
---

<section class="done-plays">
  <div class="container">
    <h1 class="section-title">Пройденные спектакли</h1>
    <p class="subtitle">Города, в которых мы играли</p>

    <div class="plays-header">
      <h2 id="playsTitle">Санкт-Петербург — спектакли</h2>
    </div>

    <div class="plays-grid" id="playsGrid"></div>
  </div>

  <!-- Модалка -->
  <div class="modal-overlay" id="playModal">
    <div class="modal-content">
      <button class="modal-close" id="modalClose">✕</button>
      <img class="modal-image" id="modalImage" src="" alt="" />
      <h2 class="modal-title" id="modalTitle"></h2>
      <div class="modal-quote" id="modalQuote"></div>
      <p class="modal-description" id="modalDescription"></p>

      <div class="modal-meta">
        <div class="modal-meta-item">⏱️ <span id="modalDuration"></span></div>
        <div class="modal-meta-item">🔞 <span id="modalAge"></span></div>
        <div class="modal-meta-item">📅 <span id="modalDates"></span></div>
      </div>

      <div class="modal-actors-title">Актёры</div>
      <ul class="actors-list" id="modalActors"></ul>
    </div>
  </div>
</section>

<style is:global>
  .done-plays {
    font-family: 'Inter', sans-serif;
    background: #f8f5f0;
    color: #222;
    padding: 2.5rem 1rem;
  }

  .container { max-width: 1280px; margin: 0 auto; }

  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.6rem, 6.5vw, 4.2rem);
    text-align: center;
    margin-bottom: 0.8rem;
    color: #222;
    position: relative;
  }

  .section-title::after {
    content: '';
    width: 140px;
    height: 3px;
    background: #d4af37;
    position: absolute;
    bottom: -18px;
    left: 50%;
    transform: translateX(-50%);
  }

  .subtitle {
    text-align: center;
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    color: #555;
    margin-bottom: 3.5rem;
    letter-spacing: 2px;
  }

  .plays-header {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 3rem;
    border-bottom: none;
  }

  .plays-header h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.4rem, 5.5vw, 3.2rem);
    text-align: center;
  }

  .plays-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 1.6rem;
  }

  .play-item {
    background: white;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 16px;
    padding: 1.8rem;
    cursor: pointer;
    transition: all 0.35s ease;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.07);
  }

  .play-item:hover {
    border-color: #d4af37;
    transform: translateY(-6px);
    box-shadow: 0 15px 35px rgba(212, 175, 55, 0.18);
  }

  .play-title {
    font-size: clamp(1.2rem, 3vw, 1.45rem);
    font-weight: 600;
    margin-bottom: 0.8rem;
  }

  /* Специальный контейнер для Кукушонка */
  .special-play-kukushonok {
    background: white;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    cursor: pointer;
    transition: all 0.4s ease;
    max-width: 520px;
    margin: 0 auto 3rem;
  }

  .special-play-kukushonok:hover {
    transform: translateY(-12px);
    box-shadow: 0 25px 60px rgba(212, 175, 55, 0.3);
  }

  .kukushonok-image {
    width: 100%;
    height: 340px;
    object-fit: cover;
  }

  .kukushonok-info {
    padding: 1.8rem 2rem;
    text-align: center;
  }

  .kukushonok-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.8rem, 4.5vw, 2.4rem);
    color: #222;
    margin-bottom: 0.5rem;
  }

  /* Модалка */
  .modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.78);
    z-index: 2000;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .modal-overlay.visible { display: flex; }

  .modal-content {
    background: white;
    color: #222;
    border-radius: 20px;
    max-width: 820px;
    width: 100%;
    max-height: 88vh;
    overflow-y: auto;
    padding: 3rem 2.8rem;
    position: relative;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }

  .modal-close {
    position: absolute;
    top: 1.2rem;
    right: 1.8rem;
    font-size: 2.8rem;
    color: #d4af37;
    cursor: pointer;
    background: none;
    border: none;
    line-height: 1;
  }

  .modal-image {
    width: 100%;
    height: 320px;
    object-fit: cover;
    border-radius: 14px;
    margin-bottom: 2rem;
  }

  .modal-actors-title {
    color: #d4af37;
    font-weight: 600;
    margin: 1.5rem 0 0.8rem;
  }

  .actors-list {
    list-style: none;
    color: #333;
    padding-left: 0;
  }
</style>

<script>
  const playsData = [
    {
      id: 'kukushonok',
      title: 'Родной мой Кукушонок',
      dates: ['15 марта 2023', '22 апреля 2023', '10 мая 2023', '5 июня 2024'],
      description: 'Драму проживает каждый Ребенок, разочаровавший своих родителей. Трагедию носит в себе каждая Мать, оттолкнувшая своего ребенка...',
      quote: '"Спектакль о том, как взрослеют родители..."',
      image: '/images/projects/kukushonok.JPG',
      actors: ['Анна Иванова — Мать', 'Дмитрий Петров — Отец', 'Елена Смирнова — Дочь', 'Михаил Козлов — Сын', 'Татьяна Васильева — Бабушка'],
      duration: '1 час 30 минут',
      ageRestriction: '16+'
    },
    {
      id: 'doggy',
      title: 'Мамочка, купи собаку!',
      dates: ['1 февраля 2023', '14 марта 2023', '2 апреля 2024', '15 ноября 2024'],
      description: 'Милая пушистая игрушка, в которой отражается всё счастье твоего детства...',
      quote: 'Сказка про то, как собака учит быть взрослыми...',
      image: '/images/projects/doggy.jpeg',
      actors: ['Ольга Новикова — Мама', 'Алексей Морозов — Папа', 'Катя Соколова — Дочь', 'Игорь Федоров — Сын', 'Анна Коваль — Соседка'],
      duration: '1 час 15 минут',
      ageRestriction: '6+'
    }
  ];

  document.addEventListener('DOMContentLoaded', () => {
    const playsGrid = document.getElementById('playsGrid');

    const modal = document.getElementById('playModal');
    const modalClose = document.getElementById('modalClose');
    const modalImage = document.getElementById('modalImage');
    const modalTitle = document.getElementById('modalTitle');
    const modalQuote = document.getElementById('modalQuote');
    const modalDescription = document.getElementById('modalDescription');
    const modalDuration = document.getElementById('modalDuration');
    const modalAge = document.getElementById('modalAge');
    const modalDates = document.getElementById('modalDates');
    const modalActors = document.getElementById('modalActors');

    if (!playsGrid || !modal || !modalClose || !modalImage || !modalTitle || !modalQuote ||
        !modalDescription || !modalDuration || !modalAge || !modalDates || !modalActors) {
      return;
    }

    function renderPlays() {
      let html = '';

      // Специальный блок для Кукушонка
      const kukushonok = playsData.find(p => p.id === 'kukushonok');
      if (kukushonok) {
        html += `
          <div class="special-play-kukushonok" data-play-id="${kukushonok.id}">
            <img src="${kukushonok.image}" alt="${kukushonok.title}" class="kukushonok-image">
            <div class="kukushonok-info">
              <div class="kukushonok-title">${kukushonok.title}</div>
              <p style="color: #666; margin-top: 0.5rem;">Нажмите для подробностей</p>
            </div>
          </div>
        `;
      }

      // Остальные спектакли
      html += playsData.filter(p => p.id !== 'kukushonok').map(play => `
        <div class="play-item" data-play-id="${play.id}">
          <div class="play-title">${play.title}</div>
          <div class="play-dates">${play.dates.map(d => `<span>${d}</span>`).join(' • ')}</div>
        </div>
      `).join('');

      playsGrid.innerHTML = html;

      playsGrid.querySelectorAll('[data-play-id]').forEach(item => {
        item.addEventListener('click', () => {
          const play = playsData.find(p => p.id === (item as HTMLElement).dataset.playId);
          if (play) openModal(play);
        });
      });
    }

    function openModal(play: typeof playsData[number]) {
      modalImage.src = play.image;
      modalTitle.textContent = play.title;
      modalQuote.textContent = play.quote || '';
      modalDescription.textContent = play.description;
      modalDuration.textContent = play.duration;
      modalAge.textContent = play.ageRestriction;
      modalDates.textContent = play.dates.join(' • ');
      modalActors.innerHTML = play.actors.map(actor => `<li>${actor}</li>`).join('');

      modal.classList.add('visible');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.remove('visible');
      document.body.style.overflow = '';
    }

    modalClose.addEventListener('click', closeModal);
    modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && modal.classList.contains('visible')) closeModal();
    });

    renderPlays();
  });
</script>
