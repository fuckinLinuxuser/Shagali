---
// Подвал сайта (одинаковый на всех страницах). Контакты — ссылки на ВК и Telegram.
const currentYear = new Date().getFullYear();
const producer = 'Мир За Сценой';
const owner = 'Елена Шагали';
const dev = 'Август Вишневский';
---

<footer class="footer" id="contacts">
  <p class="copyright">© {currentYear} {producer} • Все права защищены</p>

  <p class="credits">
    Продюсер: <a href="https://vk.com/shagali">{owner}</a> • Сайт: <a href="https://t.me/GaiusAugust">{dev}</a>
  </p>

  <nav class="links" aria-label="Подвал">
    <a href="https://vk.com/shagali">Связаться</a>
    <a href="/feedback">Написать нам</a>
    <a href="/#afisha">Проекты</a>
    <a href="/#gastroli">Гастроли</a>
    <a href="/cookies">Файлы cookie</a>
    <button type="button" class="linkbtn" data-cookie-settings>Настройки cookie</button>
  </nav>
</footer>

<style>
  .footer {
    box-sizing: border-box;
    padding: 56px 24px;
    background: var(--ink-deep);
    border-top: 1px solid #2a2a2a;
    color: #f1ece0;
    text-align: center;
    font-family: var(--font-sans);
  }
  .copyright {
    margin: 0;
    font-size: 16px;
  }
  .credits {
    margin: 16px 0 0;
    font-size: 15px;
    color: #bdb8aa;
  }
  .credits a {
    color: #e0bf5a;
    text-decoration: none;
  }
  .credits a:hover {
    text-decoration: underline;
  }
  .links {
    margin-top: 20px;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px 28px;
    font-size: 16px;
  }
  .links a {
    color: #f1ece0;
    text-decoration: none;
  }
  .linkbtn {
    padding: 0;
    background: none;
    border: 0;
    color: #f1ece0;
    font: inherit;
    cursor: pointer;
  }
  .linkbtn:hover,
  .links a:hover {
    color: var(--gold);
  }

  @media (max-width: 767px) {
    .footer {
      padding: 40px 20px;
    }
    .copyright {
      font-size: 14px;
    }
    .credits {
      font-size: 13px;
      line-height: 1.7;
    }
    .links {
      font-size: 14px;
      gap: 12px 22px;
    }
  }
</style>
