---
// src/components/Header.astro
const { title = "Мир За Сценой" } = Astro.props;
---

<header class="header">
  <div class="curtain-left"></div>
  <div class="curtain-right"></div>

  <div class="spotlight">
    <h1>{title}</h1>
    
    <p class="touch-phrase" id="touchPhrase">
      Прикоснись к театру
    </p>
  </div>

  <div class="about-producer">
    <img
      src="/images/Shagali.jpg"
      alt="Елена Шагали"
      class="producer-photo"
    />

    <h2>Елена Шагали</h2>

    <blockquote>
      "В театр приходят из любопытства, а остаются по любви"
    </blockquote>
  </div>

  <div class="beam-left"></div>
  <div class="beam-right"></div>
</header>

<style>
  .touch-phrase {
    font-size: clamp(1.4rem, 5vw, 2.2rem);
    font-size: clamp(1.4rem, 5.5vw, 2.4rem);
    color: #f0e8c0;
    opacity: 0;
    transform: translateY(40px) scale(0.92);
    text-shadow: 0 0 22px rgba(212, 175, 55, 0.8);
    font-style: italic;
    letter-spacing: 1.8px;
    transition: all 0.9s ease-out;
    user-select: none;
    cursor: pointer;
    position: relative;
    z-index: 10;
    will-change: transform, opacity, text-shadow;
  }

 .touch-phrase {
  font-size: clamp(1.5rem, 6vw, 2.6rem);
  color: #f0e8c0;
  opacity: 0;
  transform: translateY(50px) scale(0.88);
  text-shadow: 0 0 18px rgba(212, 175, 55, 0.7);
  font-style: italic;
  letter-spacing: 1.6px;
  transition: all 0.8s ease-out;
  user-select: none;
  cursor: pointer;
  position: relative;
  z-index: 10;
  will-change: transform, opacity, text-shadow, filter;
}

.touch-phrase {
  font-size: clamp(1.5rem, 6vw, 2.6rem);
  color: #f0e8c0;
  opacity: 0;
  transform: translateY(50px) scale(0.9);
  text-shadow: 0 0 18px rgba(212, 175, 55, 0.7);
  font-style: italic;
  letter-spacing: 1.6px;
  transition: all 0.8s ease-out;
  user-select: none;
  cursor: pointer;
  position: relative;
  z-index: 10;
  will-change: transform, opacity, text-shadow, filter;
}

  .touch-phrase.hide {
    opacity: 0;
    transform: translateY(-60px) scale(0.85);
    pointer-events: none;
    transition: all 1.4s cubic-bezier(0.4, 0, 0.2, 1);
    font-size: clamp(1.4rem, 5.5vw, 2.4rem);
    color: #f0e8c0;
    opacity: 0;
    transform: translateY(40px) scale(0.92);
    text-shadow: 0 0 22px rgba(212, 175, 55, 0.8);
    font-style: italic;
    letter-spacing: 1.8px;
    transition: all 0.9s ease-out;
    user-select: none;
    cursor: pointer;
    position: relative;
    z-index: 10;
    will-change: transform, opacity, text-shadow;
  }

 .touch-phrase {
  font-size: clamp(1.5rem, 6vw, 2.6rem);
  color: #f0e8c0;
  opacity: 0;
  transform: translateY(50px) scale(0.88);
  text-shadow: 0 0 18px rgba(212, 175, 55, 0.7);
  font-style: italic;
  letter-spacing: 1.6px;
  transition: all 0.8s ease-out;
  user-select: none;
  cursor: pointer;
  position: relative;
  z-index: 10;
  will-change: transform, opacity, text-shadow, filter;
}

.touch-phrase {
  font-size: clamp(1.5rem, 6vw, 2.6rem);
  color: #f0e8c0;
  opacity: 0;
  transform: translateY(50px) scale(0.9);
  text-shadow: 0 0 18px rgba(212, 175, 55, 0.7);
  font-style: italic;
  letter-spacing: 1.6px;
  transition: all 0.8s ease-out;
  user-select: none;
  cursor: pointer;
  position: relative;
  z-index: 10;
  will-change: transform, opacity, text-shadow, filter;
}

  .spotlight {
    position: relative;
    z-index: 1;
    animation: spotlight 2s infinite alternate;
    animation: spotlight 2.8s infinite alternate;
    animation: spotlight 2.8s infinite alternate;
    color: rgb(253, 245, 199);
  }

  @keyframes spotlight {
    0% { text-shadow: 0 0 10px gold; }
    100% { text-shadow: 0 0 20px gold; }
    0%   { text-shadow: 0 0 8px gold; }
    100% { text-shadow: 0 0 24px gold; }
  }
</style>

<!-- Мобильный overlay для большой зоны касания -->
<style>
@media (max-width: 768px) {
  .touch-overlay {
    position: absolute;
    inset: 0;
    z-index: 5;
    background: transparent;
    touch-action: manipulation;
  }

  .touch-phrase {
    font-size: clamp(1.6rem, 6.5vw, 2.8rem);
    padding: 20px 40px;
    margin: 0 auto;
    display: inline-block;
  }

  .touch-phrase.appear {
    opacity: 1;
    transform: translateY(0) scale(1);
    animation: 
      float-up-down 1.5s ease-in-out infinite alternate,
      soft-glow-breath 4.8s ease-in-out infinite;
  }

  /* ← Вот это и есть исчезновение — мягкий подъём + затухание одновременно */
  .touch-phrase.hide {
    opacity: 0;
    transform: translateY(-50px) scale(0.92);
    transition: 
      opacity 0.9s ease-out,
      transform 0.9s cubic-bezier(0.4, 0, 0.25, 1);
    pointer-events: none;
  }

  @keyframes float-up-down {
    0%   { transform: translateY(0) scale(1); }
    100% { transform: translateY(-12px) scale(1.06); }
  }

  @keyframes soft-glow-breath {
    0%   { 
      text-shadow: 0 0 20px rgba(212,175,55,0.65), 0 0 40px rgba(212,175,55,0.3); 
      filter: brightness(1);
    }
    100% { 
      text-shadow: 0 0 50px rgba(212,175,55,0.95), 0 0 90px rgba(212,175,55,0.55); 
      filter: brightness(1.12);
    }
  }
    0%   { text-shadow: 0 0 8px gold; }
    100% { text-shadow: 0 0 24px gold; }
  }
</style>

<!-- Мобильный overlay для большой зоны касания -->
<style>
@media (max-width: 768px) {
  .touch-overlay {
    position: absolute;
    inset: 0;
    z-index: 5;
    background: transparent;
    touch-action: manipulation;
  }

  .touch-phrase {
    font-size: clamp(1.6rem, 6.5vw, 2.8rem);
    padding: 20px 40px;
    margin: 0 auto;
    display: inline-block;
  }

  .touch-phrase.appear {
    opacity: 1;
    transform: translateY(0) scale(1);
    animation: 
      float-up-down 1.5s ease-in-out infinite alternate,
      soft-glow-breath 4.8s ease-in-out infinite;
  }

  /* ← Вот это и есть исчезновение — мягкий подъём + затухание одновременно */
  .touch-phrase.hide {
    opacity: 0;
    transform: translateY(-50px) scale(0.92);
    transition: 
      opacity 0.9s ease-out,
      transform 0.9s cubic-bezier(0.4, 0, 0.25, 1);
    pointer-events: none;
  }

  @keyframes float-up-down {
    0%   { transform: translateY(0) scale(1); }
    100% { transform: translateY(-12px) scale(1.06); }
  }

  @keyframes soft-glow-breath {
    0%   { 
      text-shadow: 0 0 20px rgba(212,175,55,0.65), 0 0 40px rgba(212,175,55,0.3); 
      filter: brightness(1);
    }
    100% { 
      text-shadow: 0 0 50px rgba(212,175,55,0.95), 0 0 90px rgba(212,175,55,0.55); 
      filter: brightness(1.12);
    }
  }
}

</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const phrase = document.getElementById('touchPhrase');
    if (!phrase) return;

    let overlay = null;
    let mobileHideHandler = null; // объявляем заранее
    let mobileHideHandler = null;

    // Появление
    setTimeout(() => {
      phrase.classList.add('appear');
    }, 800);
    let mobileHideHandler = null;

    // Появление
    setTimeout(() => {
      phrase.classList.add('appear');
    }, 900);
    }, 900);

    const hideHandler = () => {
      if (phrase.classList.contains('hide')) return;
      
      phrase.classList.remove('appear');
      phrase.classList.add('hide');

      phrase.removeEventListener('click', hideHandler);
      phrase.removeEventListener('touchstart', hideHandler);

      if (overlay) {
        overlay.removeEventListener('touchstart', hideHandler);
      }

      if (mobileHideHandler) {
        document.removeEventListener('touchstart', mobileHideHandler);
      }
    };

    // Десктоп + touch на самой фразе
    phrase.addEventListener('click', hideHandler);
    phrase.addEventListener('touchstart', hideHandler, { passive: true });

    // Мобильная логика — большая зона касания
    if (window.matchMedia("(max-width: 768px)").matches) {
      const header = phrase.closest('.header');
      if (header) {
        overlay = document.createElement('div');
        overlay.className = 'touch-overlay';
        header.appendChild(overlay);

        overlay.addEventListener('touchstart', hideHandler, { passive: true });

        // 2. Дополнительный обработчик на весь spotlight (страховка)
      if (mobileHideHandler) {
        document.removeEventListener('touchstart', mobileHideHandler);
      }
    };

    // Десктоп + touch на самой фразе
    phrase.addEventListener('click', hideHandler);
    phrase.addEventListener('touchstart', hideHandler, { passive: true });

    // Мобильная логика — большая зона касания
    if (window.matchMedia("(max-width: 768px)").matches) {
      const header = phrase.closest('.header');
      if (header) {
        overlay = document.createElement('div');
        overlay.className = 'touch-overlay';
        header.appendChild(overlay);

        overlay.addEventListener('touchstart', hideHandler, { passive: true });
        mobileHideHandler = (e) => {
          if (phrase.classList.contains('hide')) return;
          hideHandler();
        };
        spotlight.addEventListener('touchstart', mobileHideHandler, { passive: true });

        // Опционально: если хотите ловить касание вообще по документу (очень агрессивно)
        // document.addEventListener('touchstart', mobileHideHandler, { passive: true });
        header.addEventListener('touchstart', mobileHideHandler, { passive: true });
        header.addEventListener('touchstart', mobileHideHandler, { passive: true });
      }
    }
  };
</script>

<style>
  .curtain-left, .curtain-right {
    position: absolute;
    top: 0;
    width: 50%;
    height: 100%;
    background: rgba(139, 0, 0, 0.53);
    transition: transform 2s ease;
  }

  .curtain-left { left: 0; transform: translateX(0); }
  .curtain-right { right: 0; transform: translateX(0); }

  .header:hover .curtain-left  { transform: translateX(-100%); }
  .header:hover .curtain-right { transform: translateX(100%); }

  .beam-left,
  .beam-right {
    position: absolute;
    bottom: 0;
    width: 50%;
    height: 100%;
    opacity: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(to top, rgba(255, 215, 0, 0.8) 0%, rgba(255, 215, 0, 0.4) 30%, transparent 70%);
    filter: blur(12px);
    transition: opacity 2.5s ease-out;
  }

  .header:hover .beam-left,
  .header:hover .beam-right {
    opacity: 0.75;
    transition-duration: 4s;
  }

  .beam-left  { left: 0; clip-path: polygon(0 100%, 100% 100%, 70% 0); }
  .beam-right { right: 0; clip-path: polygon(0 100%, 100% 100%, 30% 0); }

  .about-producer {
    text-align: center;
    opacity: 0;
    transform: translateY(30px);
    filter: blur(5px);
    transition: all 1.5s ease 0.5s;
    margin-top: 20px;
    z-index: 1;
    position: relative;
  }

  .header:hover .about-producer {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  .producer-photo {
    border-radius: 100%;
    box-shadow: 0 0 20px rgba(255, 215, 0, 0.5);
    width: 350px;
    height: 350px;
    object-fit: cover;
    border: 3px solid gold;
  }

  .about-producer h2 {
    font-size: 2.5rem;
    color: gold;
    margin: 10px 0;
  }

  .about-producer blockquote {
    font-style: italic;
    font-size: 1.2rem;
    max-width: 600px;
    margin: 0 auto;
    color: #ccc;
  }

  @media (max-width: 768px) {
    .producer-photo {
      width: 250px;
      height: 250px;
    }
  }
</style>