---
// src/components/Header.astro
const { title = "Мир За Сценой" } = Astro.props;
---

<header class="header">
  <div class="curtain-left"></div>
  <div class="curtain-right"></div>

  <div class="spotlight">
    <h1>{title}</h1>
    
    <p class="touch-phrase" id="touchPhrase">
      Прикоснись к театру
    </p>
  </div>

  <div class="about-producer">
    <img
      src="/images/Shagali.jpg"
      alt="Елена Шагали"
      class="producer-photo"
    />

    <h2>Елена Шагали</h2>

    <blockquote>
      "В театр приходят из любопытства, а остаются по любви"
    </blockquote>
  </div>

  <div class="beam-left"></div>
  <div class="beam-right"></div>
</header>

<style>
  .touch-phrase {
    font-size: clamp(1.4rem, 5vw, 2.2rem);
    color: #f0e8c0;
    opacity: 0;
    transform: translateY(30px);
    text-shadow: 0 0 25px rgba(212, 175, 55, 0.9);
    font-style: italic;
    letter-spacing: 2px;
    transition: all 1.2s ease-out;
    user-select: none;
    cursor: pointer;
    position: relative;
    z-index: 2;
  }

  /* Начальная анимация появления */
  .touch-phrase.appear {
    opacity: 1;
    transform: translateY(0);
    animation: spotlight-glow 4s ease-in-out infinite alternate;
  }

  @keyframes spotlight-glow {
    0%   { text-shadow: 0 0 20px rgba(212,175,55,0.5), 0 0 40px rgba(212,175,55,0.3); }
    50%  { text-shadow: 0 0 45px rgba(212,175,55,1),   0 0 90px rgba(212,175,55,0.7); }
    100% { text-shadow: 0 0 25px rgba(212,175,55,0.6), 0 0 50px rgba(212,175,55,0.4); }
  }

  /* Анимация исчезновения */
  .touch-phrase.hide {
    opacity: 0;
    transform: translateY(-60px) scale(0.85);
    pointer-events: none;
    transition: all 1.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .spotlight {
    position: relative;
    z-index: 1;
    animation: spotlight 2s infinite alternate;
    color: rgb(253, 245, 199);
  }

  @keyframes spotlight {
    0% { text-shadow: 0 0 10px gold; }
    100% { text-shadow: 0 0 20px gold; }
  }
</style>

<!-- Мобильная логика — увеличенная зона касания -->
<style>
  @media (max-width: 768px) {
    .touch-phrase {
      /* Делаем область касания очень большой, но сам текст остаётся прежнего размера */
      padding: 6rem 4rem;
      margin: -6rem -4rem;
      display: inline-block;
      /* Для лучшей центровки на всякий случай */
      text-align: center;
    }

    /* Опционально: можно ещё больше увеличить зону */
    .spotlight {
      min-height: 40vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const phrase = document.getElementById('touchPhrase');
    if (!phrase) return;

    // Появление с небольшой задержкой
    setTimeout(() => {
      phrase.classList.add('appear');
    }, 800);

    const hideHandler = () => {
      phrase.classList.remove('appear');
      phrase.classList.add('hide');
      
      // Удаляем все обработчики
      phrase.removeEventListener('click', hideHandler);
      phrase.removeEventListener('touchstart', hideHandler);
      // Если вешали на spotlight — тоже убираем
      document.removeEventListener('touchstart', mobileHideHandler);
    };

    // Десктоп — только по элементу
    phrase.addEventListener('click', hideHandler);

    // Мобильные — вешаем дополнительно на весь spotlight
    if (window.matchMedia("(max-width: 768px)").matches) {
      const spotlight = phrase.closest('.spotlight');
      if (spotlight) {
        const mobileHideHandler = (e) => {
          // Предотвращаем множественные срабатывания
          if (phrase.classList.contains('hide')) return;
          hideHandler();
        };

        spotlight.addEventListener('touchstart', mobileHideHandler, { passive: true });
        // На всякий случай оставляем и на самой фразе
        phrase.addEventListener('touchstart', mobileHideHandler, { passive: true });
      }
    } else {
      // На десктопе только по фразе
      phrase.addEventListener('touchstart', hideHandler, { passive: true });
    }
  });
</script>

<style>
  .curtain-left, .curtain-right {
    position: absolute;
    top: 0;
    width: 50%;
    height: 100%;
    background: rgba(139, 0, 0, 0.53);
    transition: transform 2s ease;
  }

  .curtain-left { left: 0; transform: translateX(0); }
  .curtain-right { right: 0; transform: translateX(0); }

  .header:hover .curtain-left  { transform: translateX(-100%); }
  .header:hover .curtain-right { transform: translateX(100%); }

  .beam-left,
  .beam-right {
    position: absolute;
    bottom: 0;
    width: 50%;
    height: 100%;
    opacity: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(to top, rgba(255, 215, 0, 0.8) 0%, rgba(255, 215, 0, 0.4) 30%, transparent 70%);
    filter: blur(12px);
    transition: opacity 2.5s ease-out;
  }

  .header:hover .beam-left,
  .header:hover .beam-right {
    opacity: 0.75;
    transition-duration: 4s;
  }

  .beam-left  { left: 0; clip-path: polygon(0 100%, 100% 100%, 70% 0); }
  .beam-right { right: 0; clip-path: polygon(0 100%, 100% 100%, 30% 0); }

  .about-producer {
    text-align: center;
    opacity: 0;
    transform: translateY(30px);
    filter: blur(5px);
    transition: all 1.5s ease 0.5s;
    margin-top: 20px;
    z-index: 1;
    position: relative;
  }

  .header:hover .about-producer {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  .producer-photo {
    border-radius: 100%;
    box-shadow: 0 0 20px rgba(255, 215, 0, 0.5);
    width: 350px;
    height: 350px;
    object-fit: cover;
    border: 3px solid gold;
  }

  .about-producer h2 {
    font-size: 2.5rem;
    color: gold;
    margin: 10px 0;
  }

  .about-producer blockquote {
    font-style: italic;
    font-size: 1.2rem;
    max-width: 600px;
    margin: 0 auto;
    color: #ccc;
  }

  @media (max-width: 768px) {
    .producer-photo {
      width: 250px;
      height: 250px;
    }
  }
</style>