---
const { title = "Мир За Сценой" } = Astro.props;
---

<header class="header">
  <div class="curtain-left"></div>
  <div class="curtain-right"></div>

  <div class="spotlight">
    <h1>{title}</h1>
    
    <p class="touch-phrase" id="touchPhrase">
      Прикоснись к театру
    </p>
  </div>

<div class="about-producer">
  <video
    class="producer-video"
    autoplay
    loop
    muted
    playsinline
    preload="auto"
    
  >
    <source src="/videos/ez.mp4" type="video/mp4">
    <!-- Тестовое видео -->
    <source src="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4" type="video/mp4">
    Ваш браузер не поддерживает видео.
  </video>

  <h2>Ёжик</h2>
  <blockquote>"Талисман Шагалиного театра"</blockquote>
</div>

  <div class="beam-left"></div>
  <div class="beam-right"></div>
</header>

<style>
  .touch-phrase {
    display: none;
    font-size: clamp(1.5rem, 6vw, 2.6rem);
    color: #f0e8c0;
    opacity: 0;
    transform: translateY(50px) scale(0.9);
    text-shadow: 0 0 18px rgba(212, 175, 55, 0.7);
    font-style: italic;
    letter-spacing: 1.6px;
    transition: all 0.8s ease-out;
    user-select: none;
    cursor: pointer;
    position: relative;
    z-index: 10;
    will-change: transform, opacity, text-shadow;
  }

  .touch-phrase.appear {
    opacity: 1;
    transform: translateY(0) scale(1);
    animation: 
      float-up-down 1.5s ease-in-out infinite alternate,
      soft-glow-breath 4.8s ease-in-out infinite;
  }

  .touch-phrase.hide {
    opacity: 0;
    transform: translateY(-50px) scale(0.92);
    transition: opacity 0.9s ease-out, transform 0.9s cubic-bezier(0.4, 0, 0.25, 1);
    pointer-events: none;
  }

  .spotlight {
    position: relative;
    z-index: 1;
    animation: spotlight 2.8s infinite alternate;
    color: rgb(253, 245, 199);
  }

  @keyframes spotlight {
    0%   { text-shadow: 0 0 8px gold; }
    100% { text-shadow: 0 0 24px gold; }
  }

  @keyframes float-up-down {
    0%   { transform: translateY(0) scale(1); }
    100% { transform: translateY(-12px) scale(1.06); }
  }

  @keyframes soft-glow-breath {
    0%   { 
      text-shadow: 0 0 20px rgba(212,175,55,0.65), 0 0 40px rgba(212,175,55,0.3); 
      filter: brightness(1);
    }
    100% { 
      text-shadow: 0 0 50px rgba(212,175,55,0.95), 0 0 90px rgba(212,175,55,0.55); 
      filter: brightness(1.12);
    }
  }


 .about-producer h2 {
  margin-top: 80px;
  margin-bottom: auto;
}
  /* === Видео === */
.producer-video {
  border-radius: 100%;
  box-shadow: 0 0 20px rgba(255, 215, 0, 0.5);
  width: 350px;
  height: 350px;
  object-fit: cover;
  border: 3px solid gold;
  display: block;
  background: #111;
  transform: translateZ(0);           /* фиксит rendering в Chrome */
  -webkit-transform: translateZ(0);
  will-change: transform;
  margin: auto;
}

.producer-video:playing {
  background: transparent;
}

  .about-producer {
    text-align: center;
    opacity: 0;
    transform: translateY(30px);
    filter: blur(5px);
    transition: all 1.5s ease 0.5s;
    margin-top: 20px;
    z-index: 1;
    display: flex;
    flex-direction: column; /* Элементы встают друг под друга: видео сверху, h2 снизу */
    align-items: center;    /* Центрирует и видео, и h2 по горизонтали */
    min-height: 500px;      /* Задайте высоту блоку, чтобы h2 было куда падать вниз */
    position: relative;
    
  }

  .header:hover .about-producer {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  /* Остальные стили (шторы, лучи и т.д.) */
  .curtain-left, .curtain-right {
    position: absolute;
    top: 0;
    width: 50%;
    height: 100%;
    background: rgba(139, 0, 0, 0.53);
    transition: transform 2s ease;
  }

  .curtain-left  { left: 0; }
  .curtain-right { right: 0; }

  .header:hover .curtain-left  { transform: translateX(-100%); }
  .header:hover .curtain-right { transform: translateX(100%); }

  .beam-left, .beam-right {
    position: absolute;
    bottom: 0;
    width: 50%;
    height: 100%;
    opacity: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(to top, rgba(255, 215, 0, 0.8) 0%, rgba(255, 215, 0, 0.4) 30%, transparent 70%);
    filter: blur(12px);
    transition: opacity 2.5s ease-out;
  }

  .header:hover .beam-left,
  .header:hover .beam-right {
    opacity: 0.75;
  }

  .beam-left  { left: 0; clip-path: polygon(0 100%, 100% 100%, 70% 0); }
  .beam-right { right: 0; clip-path: polygon(0 100%, 100% 100%, 30% 0); }

  @media (max-width: 768px) {
    .producer-video {
      width: 250px;
      height: 250px;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const phrase = document.getElementById('touchPhrase');
    if (!phrase) return;

    // Появление фразы
    setTimeout(() => {
      phrase.classList.add('appear');
    }, 800);

    const hideHandler = () => {
      if (phrase.classList.contains('hide')) return;
      
      phrase.classList.remove('appear');
      phrase.classList.add('hide');
      phrase.removeEventListener('click', hideHandler);
      phrase.removeEventListener('touchstart', hideHandler);
    };

    phrase.addEventListener('click', hideHandler);
    phrase.addEventListener('touchstart', hideHandler, { passive: true });

    // Мобильная большая зона касания
    if (window.matchMedia("(max-width: 768px)").matches) {
      const header = phrase.closest('.header');
      if (header) {
        const overlay = document.createElement('div');
        overlay.className = 'touch-overlay';
        header.appendChild(overlay);

        overlay.addEventListener('touchstart', hideHandler, { passive: true });
      }
    }
  });


  // === Принудительный запуск видео ===
const video = document.querySelector('.producer-video');
if (video) {
  video.muted = true;           // обязательно
  
  const playPromise = video.play();
  
  if (playPromise !== undefined) {
    playPromise.catch(error => {
      console.warn("Autoplay prevented:", error);
      // Пробуем ещё раз после взаимодействия
      document.addEventListener('click', () => video.play(), { once: true });
    });
  }

  // Отладка
  video.addEventListener('loadedmetadata', () => console.log('Видео загружено, длительность:', video.duration));
  video.addEventListener('error', (e) => console.error('Ошибка видео:', e));
  video.addEventListener('playing', () => console.log('Видео начало играть'));
}
</script>

<!-- Мобильный overlay -->
<style>
@media (max-width: 768px) {
  .touch-overlay {
    position: absolute;
    inset: 0;
    z-index: 5;
    background: transparent;
    touch-action: manipulation;
  }
}
</style>